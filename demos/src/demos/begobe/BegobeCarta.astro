---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource-variable/shantell-sans/wght.css';
import '@fontsource-variable/manrope/wght.css';
import './begobe.css';
import './begobe-chrome.css';
import './begobe-carta.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import fontInstrument from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import fontManrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import T from './components/T.astro';
import Item from './components/Item.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { venues, venueById, info, type VenueId } from './data/info';
import { groups, sectionsFor, isHead, euro } from './data/menu';

import imgBrunch from '../../assets/demos/begobe/brunch-mesa.jpg';
import imgTostaSalmon from '../../assets/demos/begobe/tosta-salmon.jpg';
import imgIngles from '../../assets/demos/begobe/desayuno-ingles.jpg';
import imgBocadillos from '../../assets/demos/begobe/bocadillos.jpg';
import imgBagel from '../../assets/demos/begobe/bagel.jpg';
import imgRollos from '../../assets/demos/begobe/rollos-canela.jpg';
import imgAlitas from '../../assets/demos/begobe/alitas.jpg';
import imgMiniBurgers from '../../assets/demos/begobe/mini-burgers.jpg';
import imgVitrinaWraps from '../../assets/demos/begobe/vitrina-wraps.jpg';
import imgGofre from '../../assets/demos/begobe/gofre.jpg';
import imgBowl from '../../assets/demos/begobe/bowl-yogur.jpg';
import imgZumos from '../../assets/demos/begobe/zumos.jpg';
import imgBatidos from '../../assets/demos/begobe/batidos.jpg';
import imgTiramisu from '../../assets/demos/begobe/tiramisu-matcha.jpg';
import imgVitrinaBocadillos from '../../assets/demos/begobe/vitrina-bocadillos.jpg';
import imgPasteles from '../../assets/demos/begobe/pasteles-fresa.jpg';

interface Props {
	sala: string;
}
const venue = venueById(Astro.props.sala);
const vid = venue.id as VenueId;
const other = venues.find((v) => v.id !== vid)!;
const secs = sectionsFor(vid);
const grps = groups.filter((g) => !g.only || g.only === vid).filter((g) => secs.some((s) => s.group === g.id));
const total = secs.reduce((n, s) => n + s.items.filter((i) => !isHead(i)).length, 0);

const photos: Record<string, { img: ImageMetadata; alt: string; cap: { es: string; en: string } }> = {
	pan: { img: imgVitrinaBocadillos, alt: 'Vitrina de bocadillos recién hechos', cap: { es: 'recién hechos, cada mañana', en: 'made fresh every morning' } },
	bolleria: { img: imgRollos, alt: 'Rollos de canela del obrador', cap: { es: 'del obrador', en: 'from our bakery' } },
	brunch: { img: imgBrunch, alt: 'Mesa de brunch con huevos y bowls', cap: { es: 'para compartir (o no)', en: 'to share (or not)' } },
	tostaricas: { img: imgTostaSalmon, alt: 'Tostarica de salmón con rúcula', cap: { es: 'la Pescatore', en: 'the Pescatore' } },
	huevos: { img: imgIngles, alt: 'Desayuno inglés', cap: { es: 'el Inglés', en: 'the English' } },
	bagels: { img: imgBagel, alt: 'Bagel serrano', cap: { es: 'bagel serrano', en: 'serrano bagel' } },
	bocadillos: { img: imgBocadillos, alt: 'Bocadillos gourmet en baguette', cap: { es: '¡a elegir!', en: 'take your pick!' } },
	picar: { img: imgAlitas, alt: 'Alitas de pollo con sésamo', cap: { es: 'alitas BBQ', en: 'BBQ wings' } },
	burgers: { img: imgMiniBurgers, alt: 'Trío de mini burgers', cap: { es: 'trío mini burger', en: 'mini burger trio' } },
	wraps: { img: imgVitrinaWraps, alt: 'Wraps y sándwiches en la vitrina', cap: { es: 'wraps del día', en: 'today’s wraps' } },
	gofres: { img: imgGofre, alt: 'Gofre con chocolate y nata', cap: { es: 'el Goloso', en: 'the Goloso' } },
	yogures: { img: imgBowl, alt: 'Bowl de yogur con fruta', cap: { es: 'Fruiti', en: 'Fruiti' } },
	zumos: { img: imgZumos, alt: 'Zumos naturales', cap: { es: 'recién exprimidos', en: 'freshly squeezed' } },
	batidos: { img: imgBatidos, alt: 'Batidos de Oreo y Lotus', cap: { es: 'Oreo & Lotus', en: 'Oreo & Lotus' } },
	cafe: { img: imgTiramisu, alt: 'Café con capas y matcha latte', cap: { es: 'café de especialidad... de barrio', en: 'neighbourhood coffee' } },
	'bagel-dulce': { img: imgPasteles, alt: 'Pasteles de fresa y nata', cap: { es: 'y la vitrina, claro', en: 'and the display, of course' } },
};

const home = '/begobe';
---

<DemoLayout
	title={`Carta de Begobé ${venue.short} · Desayunos, brunch${vid === 'torremolinos' ? ' y cocina non stop' : ' y meriendas'}`}
	description={`Carta digital de ${venue.name}: ${venue.offer.es.toLowerCase()}. ${venue.address}, ${venue.city}. Abierto todos los días de ${venue.hours}.`}
	themeColor='#fbf8f2'
	ogImage='/demo-og/begobe.jpg'
	ogImageAlt='Carta digital de Begobé Coffee & Kitchen.'
	siteName='Begobé Coffee & Kitchen'
	bodyClass='bgb bgb--carta'
>
	<link slot='head' rel='preload' as='font' type='font/woff2' href={fontInstrument} crossorigin />
	<link slot='head' rel='preload' as='font' type='font/woff2' href={fontManrope} crossorigin />
	<script slot='head' is:inline>
		(function () {
			var r = document.documentElement;
			r.classList.add('bgb-js');
			var l = null;
			try { l = localStorage.getItem('begobe-lang'); } catch (e) {}
			if (!l) l = (navigator.language || 'es').slice(0, 2) === 'es' ? 'es' : 'en';
			r.dataset.lang = l;
			r.lang = l;
		})();
	</script>

	<Header base='/begobe' solid />

	<main class='bgb-carta'>
		<div class='bgb-ctitle'>
			<h1 class='bgb-ctitle__h'><T es='Carta' en='Menu' /> <em>{venue.short}</em></h1>
		</div>

		<nav class='bgb-tabs' aria-label='Secciones de la carta' data-tabs>
			<button type='button' class='bgb-tabs__arrow bgb-tabs__arrow--prev' data-arrow='-1' aria-label='Anterior' hidden>‹</button>
			<div class='bgb-tabs__track'>
				{secs.map((s) => (
					<a href={`#${s.id}`} data-tab={s.id} class='bgb-tab'>
						<T es={s.title.es} en={s.title.en} />
					</a>
				))}
			</div>
			<button type='button' class='bgb-tabs__arrow bgb-tabs__arrow--next' data-arrow='1' aria-label='Siguiente' hidden>›</button>
		</nav>

		<div class='bgb-cbody'>
			{grps.map((g) => (
				<div class={`bgb-group bgb-group--${g.id}`} id={g.id} data-group>
					{secs.filter((s) => s.group === g.id).map((s) => {
						const ph = photos[s.id];
						return (
							<section class={`bgb-csec${ph ? ' has-photo' : ''}`} id={s.id} data-sec aria-labelledby={`t-${s.id}`}>
								<div class='bgb-csec__aside'>
									<div class='bgb-csec__txt'>
{s.kicker && <p class='bgb-csec__kicker'><T es={s.kicker.es} en={s.kicker.en} /></p>}
									<h3 class='bgb-csec__title' id={`t-${s.id}`}><T es={s.title.es} en={s.title.en} /></h3>
									{s.intro && <p class='bgb-csec__intro'><T es={s.intro.es} en={s.intro.en} /></p>}
</div>
									{ph && (
										<figure class='bgb-csec__photo'>
											<Image src={ph.img} alt={ph.alt} widths={[320, 520]} sizes='(max-width: 900px) 40vw, 260px' />
											<figcaption><T es={ph.cap.es} en={ph.cap.en} /></figcaption>
										</figure>
									)}
								</div>
								<div class='bgb-csec__main'>
									{s.cols && (
										<p class='bgb-cols' aria-hidden='true'>
											<span><T es={s.cols[0].es} en={s.cols[0].en} /></span>
											<span><T es={s.cols[1].es} en={s.cols[1].en} /></span>
										</p>
									)}
									<ul class='bgb-items'>
										{s.items.map((it) =>
											isHead(it) ? (
												<li class='bgb-items__head' data-head><T es={it.head.es} en={it.head.en} /></li>
											) : (
												<Item dish={it} venue={vid} twoCols={!!s.cols} />
											),
										)}
									</ul>
									{s.extras && (
										<div class='bgb-extras' data-extras>
											<p class='bgb-extras__t'><T es={s.extras.title.es} en={s.extras.title.en} /></p>
											<ul>
												{s.extras.items.map((e) => (
													<li><span><T es={e.name.es} en={e.name.en} /></span><span>+{euro(e.price)}</span></li>
												))}
											</ul>
										</div>
									)}
									{s.notes && (
										<ul class='bgb-notes'>
											{s.notes.map((n) => <li><T es={n.es} en={n.en} /></li>)}
										</ul>
									)}
								</div>
							</section>
						);
					})}
				</div>
			))}

			{vid === 'soho' && (
				<aside class='bgb-cross'>
					<div>
						<p class='bgb-cross__t'><T es='¿Con ganas de burger o nachos?' en='Craving burgers or nachos?' /></p>
						<p><T es='La cocina non stop (burgers, ensaladas, para picar y wraps) está en Begobé Torremolinos, hasta las 22:30.' en='The non-stop kitchen (burgers, salads, sharing plates and wraps) is at Begobé Torremolinos, until 22:30.' /></p>
					</div>
					<a href={`${home}/carta/torremolinos`} class='bgb-btn bgb-btn--navy bgb-btn--sm'><T es='Ver carta Torremolinos' en='Torremolinos menu' /> →</a>
				</aside>
			)}
		</div>
		<div class='bgb-cnotes'>
			<p class='bgb-cnotes__venue'>
				<strong>{venue.name}</strong>
				<span>{venue.address} · {venue.postal} {venue.city}</span>
				<span><T es='Todos los días' en='Every day' /> · {venue.hours}</span>
			</p>
			<p>
				<T es='Precios en euros, IVA incluido. Si tienes alguna alergia o intolerancia, pregúntanos: te informamos de los alérgenos de cada plato.' en='Prices in euros, VAT included. If you have any allergy or intolerance, just ask: we’ll tell you the allergens in every dish.' />
			</p>
			<p>
				<span class='bgb-item__veg' aria-hidden='true'>(v)</span> <T es='vegetariano' en='vegetarian' />
				· {total} <T es='platos y bebidas en esta carta' en='dishes & drinks on this menu' />
			</p>
		</div>
	</main>

	<Footer base='/begobe' />
</DemoLayout>

<script>
	import { initCommon } from './scripts/common';
	import { fontsReady } from '../../layouts/fonts-ready';

	await fontsReady();

	initCommon();

	/* ---------- Pestañas con scroll-spy ---------- */
	const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
	const track = document.querySelector<HTMLElement>('.bgb-tabs__track')!;
	const secs = [...document.querySelectorAll<HTMLElement>('[data-sec]')];
	let activeId = '';
	let lockUntil = 0;
	const setActive = (id: string) => {
		if (id === activeId) return;
		activeId = id;
		tabs.forEach((t) => {
			const on = t.dataset.tab === id;
			t.classList.toggle('is-active', on);
			if (on) track.scrollTo({ left: t.offsetLeft - track.clientWidth / 2 + t.clientWidth / 2, behavior: 'smooth' });
		});
	};
	const io = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (e.isIntersecting && Date.now() > lockUntil) setActive(e.target.id);
			}),
		{ rootMargin: '-30% 0px -65% 0px' },
	);
	secs.forEach((s) => io.observe(s));

	const scrollToId = (id: string) => {
		const el = document.getElementById(id);
		if (!el) return;
		// Mientras dura el desplazamiento no se iluminan las secciones intermedias
		setActive(id);
		lockUntil = Date.now() + 1400;
		const offset = (document.querySelector<HTMLElement>('[data-tabs]')?.offsetHeight ?? 0) + 8;
		window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - offset, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
	};
	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
		a.addEventListener('click', (e) => {
			const id = a.getAttribute('href')!.slice(1);
			if (!id) return;
			e.preventDefault();
			scrollToId(id);
			history.replaceState(null, '', `#${id}`);
		}),
	);

	/* ---------- Barra de secciones desplazable en escritorio: flechas y arrastre ---------- */
	const arrows = [...document.querySelectorAll<HTMLButtonElement>('[data-arrow]')];
	const updateArrows = () => {
		const max = track.scrollWidth - track.clientWidth;
		arrows.forEach((a) => (a.hidden = a.dataset.arrow === '-1' ? track.scrollLeft < 8 : track.scrollLeft > max - 8 || max < 8));
	};
	arrows.forEach((a) => a.addEventListener('click', () => track.scrollBy({ left: Number(a.dataset.arrow) * track.clientWidth * 0.6, behavior: 'smooth' })));
	track.addEventListener('scroll', updateArrows, { passive: true });
	window.addEventListener('resize', updateArrows);
	updateArrows();
	let drag: { x: number; left: number } | null = null;
	let moved = false;
	track.addEventListener('pointerdown', (e) => {
		if (e.pointerType !== 'mouse') return;
		drag = { x: e.clientX, left: track.scrollLeft };
		moved = false;
	});
	window.addEventListener('pointermove', (e) => {
		if (!drag) return;
		const dx = e.clientX - drag.x;
		if (Math.abs(dx) > 4) moved = true;
		track.scrollLeft = drag.left - dx;
	});
	window.addEventListener('pointerup', () => (drag = null));
	track.addEventListener('click', (e) => moved && (e.preventDefault(), e.stopPropagation()), true);

	/* ---------- Aparición suave ---------- */
	const rv = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (e.isIntersecting) {
					e.target.classList.add('is-in');
					rv.unobserve(e.target);
				}
			}),
		{ rootMargin: '0px 0px -6% 0px' },
	);
	document.querySelectorAll('.bgb-csec').forEach((el) => rv.observe(el));
	document.documentElement.classList.add('bgb-ready');
</script>
