---
/** Fila de la carta: nombre · puntos · precio(s), y descripción debajo. */
import T from './T.astro';
import { priceFor, euroShort, type Dish } from '../data/menu';
import type { VenueId } from '../data/info';

interface Props {
	dish: Dish;
	venue: VenueId;
	/** La sección tiene dos columnas de precio */
	twoCols?: boolean;
}
const { dish: d, venue, twoCols = false } = Astro.props;
const p = priceFor(d, venue);
const search = [d.name.es, d.name.en, d.desc?.es ?? '', d.desc?.en ?? ''].join(' ').toLowerCase();
---

<li class={`bgb-item${d.star ? ' is-star' : ''}${Array.isArray(p) || twoCols ? ' is-two' : ''}`} data-item data-q={search}>
	<div class='bgb-item__row'>
		<h4 class='bgb-item__name'>
			<T es={d.name.es} en={d.name.en} />
			{d.veggie && (
				<span class='bgb-item__veg' title='Vegetariano'>
					<span aria-hidden='true'>(v)</span>
					<span class='bgb-sr'><T es='Vegetariano' en='Vegetarian' /></span>
				</span>
			)}
		</h4>
		<span class='bgb-item__dots' aria-hidden='true'></span>
		{
			Array.isArray(p) ? (
				<span class='bgb-item__price bgb-item__price--two'>
					<span>{euroShort(p[0])}</span>
					<span>{euroShort(p[1])}</span>
				</span>
			) : (
				p !== undefined && <span class='bgb-item__price'>{euroShort(p)}</span>
			)
		}
	</div>
	{d.desc && (
		<p class='bgb-item__desc'>
			<T es={d.desc.es} en={d.desc.en} />
		</p>
	)}
</li>
