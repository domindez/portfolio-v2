---
import '@fontsource/alfa-slab-one/400.css';
import '@fontsource/yellowtail/400.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import './papulinos.css';
import './papulinos-chrome.css';
import './papulinos-carta.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import T from './components/T.astro';
import Icon from './components/Icon.astro';
import Item from './components/Item.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { venueById, type VenueId } from './data/info';
import { sectionsFor, isHead } from './data/menu';

import imgChuleton from '../../assets/demos/papulinos/chuleton.jpg';
import imgBrocheta from '../../assets/demos/papulinos/brocheta.jpg';
import imgPulpo from '../../assets/demos/papulinos/pulpo.jpg';
import imgChorizo from '../../assets/demos/papulinos/chorizo-morcilla.jpg';
import imgBurger from '../../assets/demos/papulinos/hamburguesa.jpg';
import imgAlitas from '../../assets/demos/papulinos/alitas.jpg';
import imgCarnes from '../../assets/demos/papulinos/parrilla-carnes.jpg';

interface Props {
	sala: string;
}
const venue = venueById(Astro.props.sala);
const vid = venue.id as VenueId;
const secs = sectionsFor(vid);
const total = secs.reduce((n, s) => n + s.items.filter((i) => !isHead(i)).length, 0);
const home = '/papulinos';

const photos: Record<string, { img: ImageMetadata; alt: string; cap: { es: string; en: string } }> = {
	entrantes: { img: imgPulpo, alt: 'Pulpo con aceite de oliva y ensalada', cap: { es: 'Pulpo, como debe ser', en: 'Octopus, done right' } },
	'brasa-entrantes': { img: imgChorizo, alt: 'Chorizo criollo y morcilla de Burgos a la brasa', cap: { es: 'Chorizo criollo y morcilla', en: 'Criollo sausage & black pudding' } },
	carnes: { img: imgChuleton, alt: 'Chuletón a la brasa con patata asada y alioli', cap: { es: 'Chuletón con su patata', en: 'T-bone with its potato' } },
	pescados: { img: imgCarnes, alt: 'Parrilla con brochetas y carnes', cap: { es: 'Todo pasa por la parrilla', en: 'Everything hits the grill' } },
	hamburguesas: { img: imgBurger, alt: 'Hamburguesa de vaca gallega', cap: { es: 'Vaca gallega a la brasa', en: 'Chargrilled Galician beef' } },
	infantil: { img: imgAlitas, alt: 'Alitas de pollo a la brasa', cap: { es: 'También para los peques', en: 'Kids love it too' } },
	guarnicion: { img: imgBrocheta, alt: 'Brocheta a la brasa con alioli', cap: { es: 'Y siempre, su alioli', en: 'Always with aioli' } },
};
---

<DemoLayout
	title={`Carta de ${venue.name} · Carnes a la brasa en Málaga`}
	description={`Carta digital de ${venue.name}, ${venue.address}, Málaga: carnes a la brasa, entrantes, ensaladas y la patata asada con alioli de siempre. ${venue.hours.es}.`}
	themeColor='#1b1512'
	ogImage='/demo-og/papulinos.jpg'
	ogImageAlt='Carta digital de Papulinos.'
	siteName='Papulinos'
	bodyClass='pp pp-carta'
>
	<script slot='head' is:inline>
		(function () {
			var r = document.documentElement;
			r.classList.add('pp-js');
			var l = null;
			try { l = localStorage.getItem('papulinos-lang'); } catch (e) {}
			if (!l) l = (navigator.language || 'es').slice(0, 2) === 'es' ? 'es' : 'en';
			r.dataset.lang = l;
			r.lang = l;
		})();
	</script>

	<Header carta />

	<main class='pp-cmain'>
		<header class='pp-chead'>
			<div class='pp-wrap'>
				<div class='pp-chead__row'>
					<h1 class='pp-chead__t'>
						<T es='La carta' en='The menu' />
						<small>{venue.name}</small>
					</h1>
				</div>
			</div>
		</header>

		<nav class='pp-tabs' aria-label='Secciones de la carta' data-tabs>
			<div class='pp-tabs__track' data-track>
				{secs.map((s) => (
					<a href={`#${s.id}`} data-tab={s.id} class='pp-tab'>
						<T es={s.title.es} en={s.title.en} />
					</a>
				))}
			</div>
		</nav>

		<div class='pp-wrap pp-cbody'>
			<p class='pp-cnote'>
				<T es={venue.cartaNote.es} en={venue.cartaNote.en} />
			</p>

			{secs.map((s) => {
				const ph = photos[s.id];
				return (
					<section class={`pp-csec${ph ? ' has-photo' : ''}`} id={s.id} data-sec aria-labelledby={`t-${s.id}`}>
						<header class='pp-csec__head'>
							<p class='pp-csec__kicker'><T es={s.kicker.es} en={s.kicker.en} /></p>
							<h2 class='pp-csec__title' id={`t-${s.id}`}><T es={s.title.es} en={s.title.en} /></h2>
							{s.intro && <p class='pp-csec__intro'><T es={s.intro.es} en={s.intro.en} /></p>}
						</header>
						<div class='pp-csec__body'>
							{ph && (
								<figure class='pp-photo pp-csec__photo'>
									<Image src={ph.img} alt={ph.alt} widths={[280, 480]} sizes='240px' />
									<figcaption><T es={ph.cap.es} en={ph.cap.en} /></figcaption>
								</figure>
							)}
							<ul class='pp-items'>
								{s.items.map((it) =>
									isHead(it) ? (
										<li class='pp-items__head'>
											<T es={it.head.es} en={it.head.en} />
										</li>
									) : (
										<Item dish={it} />
									),
								)}
							</ul>
						</div>
						{s.notes && (
							<ul class='pp-csec__notes'>
								{s.notes.map((n) => (
									<li>
										<T es={n.es} en={n.en} />
									</li>
								))}
							</ul>
						)}
					</section>
				);
			})}

			<div class='pp-clegal'>
				<p class='pp-clegal__venue'>
					<strong>{venue.name}</strong>
					<span>{venue.address} · {venue.postal} Málaga · <span class='pp-nowrap'>{venue.phone}</span></span>
					<span><T es={venue.hours.es} en={venue.hours.en} /></span>
				</p>
				<p class='pp-clegal__legend'>
					<span><Icon name='chili' size={14} /> <T es='picante' en='spicy' /></span>
					<span><Icon name='leaf' size={14} /> <T es='vegetariano' en='vegetarian' /></span>
					<span><Icon name='two' size={14} /> <T es='para dos' en='for two' /></span>
				</p>
				<p>
					<T
						es={`Precios en euros, IVA incluido. ${total} platos en esta carta. Si tienes alguna alergia o intolerancia, avísanos: te informamos de los alérgenos de cada plato.`}
						en={`Prices in euros, VAT included. ${total} dishes on this menu. If you have any allergy or intolerance, let us know and we’ll tell you the allergens in every dish.`}
					/>
				</p>
			</div>
		</div>
	</main>

	<Footer />
</DemoLayout>

<script>
	import { initCommon, reducedMotion } from './scripts/common';

	initCommon();

	/* ---------- Pestañas con scroll-spy ---------- */
	const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
	const track = document.querySelector<HTMLElement>('[data-track]')!;
	const secs = [...document.querySelectorAll<HTMLElement>('[data-sec]')];
	let activeId = '';
	let lockUntil = 0;
	const setActive = (id: string) => {
		if (id === activeId) return;
		activeId = id;
		tabs.forEach((t) => {
			const on = t.dataset.tab === id;
			t.classList.toggle('is-active', on);
			if (on) track.scrollTo({ left: t.offsetLeft - track.clientWidth / 2 + t.clientWidth / 2, behavior: reducedMotion() ? 'auto' : 'smooth' });
		});
	};
	const io = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (e.isIntersecting && Date.now() > lockUntil) setActive(e.target.id);
			}),
		{ rootMargin: '-30% 0px -65% 0px' },
	);
	secs.forEach((s) => io.observe(s));
	if (secs[0]) setActive(secs[0].id);

	const navH = () => (document.querySelector<HTMLElement>('[data-nav]')?.offsetHeight ?? 0) + (document.querySelector<HTMLElement>('[data-tabs]')?.offsetHeight ?? 0);
	tabs.forEach((a) =>
		a.addEventListener('click', (e) => {
			const id = a.dataset.tab!;
			const el = document.getElementById(id);
			if (!el) return;
			e.preventDefault();
			setActive(id);
			lockUntil = Date.now() + 1200;
			window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - navH() - 12, behavior: reducedMotion() ? 'auto' : 'smooth' });
			history.replaceState(null, '', `#${id}`);
		}),
	);
</script>
