---
/** Iconos de línea propios (24×24, stroke = currentColor). */
interface Props {
	name: 'arrow' | 'chevron' | 'phone' | 'pin' | 'clock' | 'star' | 'flame' | 'chili' | 'leaf' | 'two' | 'instagram' | 'facebook' | 'mail' | 'left' | 'right';
	size?: number;
	class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props as Props;
---

<svg class={cls} width={size} height={size} viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
	{name === 'arrow' && <path d='M5 12h14M13 6l6 6-6 6' />}
	{name === 'left' && <path d='M15 5l-7 7 7 7' />}
	{name === 'right' && <path d='M9 5l7 7-7 7' />}
	{name === 'chevron' && <path d='M6 9l6 6 6-6' />}
	{name === 'phone' && <path d='M5 3.5h3.2l1.6 4.2-2 1.3a11 11 0 0 0 5.2 5.2l1.3-2 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 2.5 6.2 2.5 2.5 0 0 1 5 3.5Z' />}
	{name === 'pin' && (
		<>
			<path d='M12 21s-6.5-6-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 15 12 21 12 21Z' />
			<circle cx='12' cy='9.8' r='2.4' />
		</>
	)}
	{name === 'clock' && (
		<>
			<circle cx='12' cy='12' r='8.5' />
			<path d='M12 7.5V12l3 2' />
		</>
	)}
	{name === 'star' && <path fill='currentColor' stroke='none' d='M12 2.8l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 16.7l-5.6 3.1 1.3-6.2L3 9.3l6.3-.7L12 2.8Z' />}
	{name === 'flame' && <path d='M12 21.5c-4 0-7-2.8-7-6.8 0-3.6 2.6-5.6 3.6-8.7.9 1.6 1.6 2.6 2.9 3.2.3-2.8 1.5-5.3 4-7.2-.3 3.4 3.5 5.9 3.5 11.6 0 4.6-3 7.9-7 7.9Zm0 0c-1.9 0-3.3-1.3-3.3-3.2 0-2 1.6-2.9 2.3-4.6 1.6 1.4 4.3 2.4 4.3 4.6 0 1.9-1.4 3.2-3.3 3.2Z' />}
	{name === 'chili' && <path d='M14.5 6.5c1.5-.3 3.2.5 3.7 2.2.9 3.4-2.6 9.6-10.4 11.6-2 .5-3.6-1-2.4-1.8 4.1-2.6 5.7-6.4 6.3-9.4.3-1.5 1.4-2.4 2.8-2.6Zm0 0c.2-1.8 1.2-3.2 3-3.8' />}
	{name === 'leaf' && <path d='M5 19c0-8 4.5-13.5 14-14-.2 9.5-5.8 14-14 14Zm0 0 7-7' />}
	{name === 'two' && (
		<>
			<circle cx='8.5' cy='8' r='3' />
			<circle cx='16' cy='9' r='2.5' />
			<path d='M3 19c.5-3.4 2.7-5.3 5.5-5.3s5 1.9 5.5 5.3M14 14.2c3.2-.5 5.7 1.2 6.5 4.6' />
		</>
	)}
	{name === 'instagram' && (
		<>
			<rect x='3.5' y='3.5' width='17' height='17' rx='5' />
			<circle cx='12' cy='12' r='4' />
			<circle cx='17' cy='7' r='0.6' fill='currentColor' />
		</>
	)}
	{name === 'facebook' && <path d='M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.6-1.5H17V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H8.3v3H11V21' />}
	{name === 'mail' && (
		<>
			<rect x='3' y='5' width='18' height='14' rx='2.5' />
			<path d='m4 7 8 6 8-6' />
		</>
	)}
</svg>
