---
import '@fontsource-variable/cinzel/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import './sala-premier.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import fontCinzel from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';
import fontManrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Icon from './components/Icon.astro';
import { venues, events, weekDays, eventTypes, venueShort, cocktails, marquee, info } from './data/info';
import { venuePhotos } from './data/photos';

import imgWordmark from '../../assets/demos/sala-premier/wordmark.png';
import imgEmblema from '../../assets/demos/sala-premier/emblema.png';
import imgFachada from '../../assets/demos/sala-premier/fachada-centro.jpg';
import imgSalon from '../../assets/demos/sala-premier/salon-grupo.jpg';
import imgMesas from '../../assets/demos/sala-premier/mesas.jpg';
import imgCoctel from '../../assets/demos/sala-premier/coctel.jpg';
import imgCocteles from '../../assets/demos/sala-premier/cocteles.jpg';
import imgNoche from '../../assets/demos/sala-premier/noche.jpg';
import imgHalloween from '../../assets/demos/sala-premier/halloween.jpg';
import imgNavidad from '../../assets/demos/sala-premier/navidad.jpg';
import imgTrivial from '../../assets/demos/sala-premier/trivial-telon.jpg';
import imgTandem from '../../assets/demos/sala-premier/tandem.jpg';
import imgCalle from '../../assets/demos/sala-premier/calle-centro.jpg';
import imgMarco1 from '../../assets/demos/sala-premier/marco-1.jpg';
import imgMarco2 from '../../assets/demos/sala-premier/marco-2.jpg';
import imgAmb1 from '../../assets/demos/sala-premier/ambiente-1.jpg';
import imgAmb2 from '../../assets/demos/sala-premier/ambiente-2.jpg';
import imgAmb3 from '../../assets/demos/sala-premier/ambiente-3.jpg';
import imgAmb6 from '../../assets/demos/sala-premier/ambiente-6.jpg';
import imgAmb9 from '../../assets/demos/sala-premier/ambiente-9.jpg';

const seasons = [
	{ img: imgHalloween, kicker: 'Octubre', title: 'Halloween Premier', text: 'Payasos, disfraces de todo tipo y cócteles rojo sangre hasta las tantas.', alt: 'Cliente disfrazado de payaso con un cóctel rojo en Halloween' },
	{ img: imgTrivial, kicker: 'Especial', title: 'Trivial Festival de Cine', text: 'Dos días, dos salas: la edición más peliculera de nuestro trivial.', alt: 'Cartel del Trivial Especial con telón rojo y el emblema de Sala Premier' },
	{ img: imgNavidad, kicker: 'Diciembre', title: 'Navidad en Premier', text: 'Árbol, luces y camareras de Mamá Noel en plena calle Molina Lario.', alt: 'Camarera vestida de Mamá Noel junto al árbol de Navidad del local' },
	{ img: imgTandem, kicker: 'Cada jueves', title: 'Intercambio de idiomas', text: 'Con Málaga Tandem Club. Todos los niveles, todos los idiomas.', alt: 'Cartel luminoso de Málaga Tandem Club sobre una mesa del pub' },
	{ img: imgNoche, kicker: '17 de marzo', title: 'St. Patrick’s Day', text: 'El día del trébol: Guinness, música irlandesa y todo el local de verde.', alt: 'Tres amigas haciéndose un selfie en una noche llena del pub' },
];

const igGrid = [
	{ img: imgAmb1, alt: 'Clientes bailando en la barra' },
	{ img: imgMarco2, alt: 'Foto en blanco y negro enmarcada en dorado' },
	{ img: imgAmb3, alt: 'Pareja abrazada celebrando en la barra' },
	{ img: imgCalle, alt: 'Calle Molina Lario con luces de Navidad y la fachada de Premier' },
	{ img: imgMarco1, alt: 'Pareja retratada en blanco y negro dentro de un marco dorado' },
	{ img: imgAmb6, alt: 'Amigos alrededor de una mesa redonda' },
	{ img: imgAmb9, alt: 'Pareja sonriendo bajo las pantallas' },
];

const menuLinks = [
	{ href: '#cartelera', label: 'Cartelera' },
	{ href: '#salas', label: 'Las salas' },
	{ href: '#cartas', label: 'Cartas' },
	
	{ href: '#temporada', label: 'Temporada' },
	{ href: '#celebraciones', label: 'Celebraciones' },
	{ href: '#reservas', label: 'Reservas' },
];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];

const occasions = ['un cumpleaños', 'una despedida', 'una cena de empresa', 'algo con la peña'];
const waDigits = (phone: string) => `34${phone.replace(/\s/g, '')}`;
// Un cartel por función, de lunes a domingo (el script lo reordena a partir de hoy)
const tickets = weekDays.flatMap((wd) => events.filter((e) => e.day === wd.day));

const _detalles = [
	{ label: 'En barril', text: 'Guinness, Erdinger y Estrella bien tiradas; las artesanas y las de importación, en botella.' },
	{ label: 'En copa', text: 'La carta se lee como una cartelera: El Padrino, Casablanca, La naranja mecánica…' },
	{ label: 'En la mesa', text: 'Juegos de mesa en la barra. Los pides, los traen y la partida es tuya.' },
	{ label: 'En pantalla', text: 'Si hay partido, se pone. Y se oye.' },
];

const base = '/sala-premier';
const cartaUrl = (id: string) => `${base}/carta/${id}`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: info.name,
	slogan: info.tagline,
	sameAs: [info.instagram, info.facebook],
	subOrganization: venues.map((v) => ({
		'@type': 'BarOrPub',
		name: `Sala ${v.name}`,
		telephone: `+34${v.phone.replace(/\s/g, '')}`,
		email: v.email,
		address: { '@type': 'PostalAddress', streetAddress: v.address, addressLocality: v.city, addressCountry: 'ES' },
	})),
};

// Fechas de los tickets con la fecha del build; el script las corrige al día de hoy.
const fmtMon = new Intl.DateTimeFormat('es-ES', { month: 'short' });
const today = new Date();
const nextDate = (d: number) => {
	const t = new Date(today);
	t.setDate(today.getDate() + ((d - today.getDay() + 7) % 7));
	return t;
};
---

<DemoLayout
	title='Sala Premier · Un pub de película · Málaga y Granada'
	description='Cuatro pubs con decoración de cine en Málaga y Granada: Guinness en barril, cócteles con nombre de peli, trivial, pasapalabra, bingo y partidos en pantalla grande.'
	themeColor='#0d0909'
	ogImage='/demo-og/sala-premier.jpg'
	ogImageAlt='Sala Premier: un pub de película en Málaga y Granada.'
	siteName='Sala Premier'
	favicon='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%230d0909%22/%3E%3Cellipse cx=%2232%22 cy=%2232%22 rx=%2222%22 ry=%2226%22 fill=%22none%22 stroke=%22%23d1a650%22 stroke-width=%223%22 stroke-dasharray=%223 2%22/%3E%3Ctext x=%2232%22 y=%2243%22 font-family=%22Georgia,serif%22 font-size=%2232%22 text-anchor=%22middle%22 fill=%22%23d1a650%22%3EP%3C/text%3E%3C/svg%3E'
	bodyClass='sp'
>
	<link slot='head' rel='preload' as='font' type='font/woff2' href={fontCinzel} crossorigin />
	<link slot='head' rel='preload' as='font' type='font/woff2' href={fontManrope} crossorigin />
	<script slot='head' type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
	<script slot='head' is:inline>
		document.documentElement.classList.add('sp-js');
		// Intro de película antigua: solo con JS y sin movimiento reducido
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('sp-intro');
	</script>

	<a class='sp-skip' href='#cartelera'>Saltar al contenido</a>

	<!-- ================= NAV ================= -->
	<header class='nav' data-nav>
		<div class='nav__inner'>
			<a class='nav__logo' href={base} aria-label='Sala Premier, inicio'>
				<Image src={imgWordmark} alt='' width={160} densities={[1, 2]} loading='eager' />
			</a>
			<nav class='nav__links' aria-label='Principal'>
				<a href='#cartelera'>Cartelera</a>
				<a href='#salas'>Salas</a>
					<a href='#cartas'>Cartas</a>
				
				<a href='#temporada'>Temporada</a>
				<a href='#celebraciones'>Celebraciones</a>
			</nav>
			<a class='sp-btn sp-btn--telon nav__cta' href='#reservas'>Reservar</a>
			<button class='nav__toggle' type='button' aria-expanded='false' aria-controls='nav-menu' data-nav-toggle>
				<span class='visually-hidden' data-toggle-label>Abrir menú</span>
				<span class='nav__burger' aria-hidden='true'><i></i><i></i><i></i></span>
			</button>
		</div>
	</header>

	<!-- Menú móvil a pantalla completa: cae como un telón -->
	<div class='menu' id='nav-menu' data-menu role='dialog' aria-modal='true' aria-label='Menú' tabindex='-1' hidden>
		<div class='menu__inner'>
			<nav aria-label='Secciones'>
				<ol class='menu__list'>
					{menuLinks.map((l, i) => (
						<li>
							<a class='menu__link' href={l.href}>
								<span class='menu__num'>{roman[i]}</span>
								<span class='menu__label'>{l.label}</span>
							</a>
						</li>
					))}
				</ol>
			</nav>

			<div class='menu__cartas'>
				<p class='menu__kicker'>Las cartas</p>
				<ul>
					{venues.map((v) => (
						<li>
							<a href={cartaUrl(v.id)}>
								<span>{venueShort(v.id)}</span>
								<small>{v.city}</small>
							</a>
						</li>
					))}
				</ul>
			</div>

			<div class='menu__foot'>
				<a class='sp-btn sp-btn--telon menu__cta' href='#reservas'><Icon name='ticket' size={18} />Reservar mesa</a>
				<div class='menu__social'>
					<a href={info.instagram} target='_blank' rel='noopener' aria-label='Instagram'><Icon name='instagram' size={20} /></a>
					<a href={info.facebook} target='_blank' rel='noopener' aria-label='Facebook'><Icon name='facebook' size={20} /></a>
				</div>
			</div>
		</div>
	</div>

	<main>
		<!-- ================= TELÓN / HERO ================= -->
		<section class='stage' id='inicio' aria-label='Sala Premier'>
			<div class='stage__pin'>
				<div class='stage__bg'>
					<Image src={imgFachada} alt='' widths={[800, 1280, 1800]} sizes='100vw' loading='eager' fetchpriority='high' />
				</div>
				<!-- halo cálido de las bombillas sobre la fachada -->
				<div class='stage__glow' aria-hidden='true'></div>
				<!-- polvo de luz -->
				<canvas class='stage__dust' aria-hidden='true'></canvas>

				<div class='stage__content'>
					<p class='sp-eyebrow stage__eyebrow'>Centro · Teatinos · Huelin · Granada</p>
					<div class='marquee-sign'>
						<div class='bulbs bulbs--top' aria-hidden='true'>{Array.from({ length: 15 }, () => <span class='bulb' />)}</div>
						<h1 class='marquee-sign__title'>
							<Image src={imgWordmark} alt='Sala Premier' width={900} densities={[1, 2]} loading='eager' class='marquee-sign__logo' />
						</h1>
						<div class='bulbs bulbs--bottom' aria-hidden='true'>{Array.from({ length: 15 }, () => <span class='bulb' />)}</div>
					</div>
					<div class='stage__ctas'>
						<a class='sp-btn sp-btn--telon hero-btn' href='#reservas'><Icon name='ticket' size={20} /><span>Reservar mesa</span></a>
						<a class='sp-btn sp-btn--fantasma hero-btn hero-btn--ghost' href='#cartas'><span>Ver carta</span><Icon name='arrow' size={18} /></a>
					</div>
				</div>

				<!-- Intro: apertura en iris de película antigua -->
				<div class='reel' aria-hidden='true'>
					<div class='reel__iris'></div>
					<canvas class='reel__grain'></canvas>
					<div class='reel__vignette'></div>
				</div>
				<div class='stage__floor' aria-hidden='true'></div>
			</div>
		</section>

		<!-- ================= MARQUESINA ================= -->
		<div class='ticker' aria-label='Lo que pasa en Premier'>
			<div class='ticker__track'>
				{[0, 1].map((k) => (
					<div class='ticker__group' aria-hidden={k === 1 ? 'true' : undefined}>
						{marquee.map((m) => (
							<>
								<span>{m}</span>
								<i>✱</i>
							</>
						))}
					</div>
				))}
			</div>
		</div>

		<!-- ================= CARTELERA ================= -->
		<section class='section cartelera' id='cartelera'>
			<div class='wrap'>
				<header class='sec-head'>
					<p class='sp-eyebrow'>Cartelera</p>
					<h2 class='display-l'>Esta semana en Premier</h2>
					<p class='entradilla'>Trivial, pasapalabra, bingo, idiomas y días de cerveza barata. Mira qué toca en tu sala.</p>
				</header>

				<div class='filtros' role='group' aria-label='Ver la cartelera de'>
					<button type='button' class='filtro is-active' data-filter='all' aria-pressed='true'>Todas las salas</button>
					{venues.map((v) => (
						<button type='button' class='filtro' data-filter={v.id} aria-pressed='false'>{venueShort(v.id)}</button>
					))}
				</div>

				<div class='cartelera__grid'>
					<div class='cartelera__today'>
							<div class='sp-cartel' data-today>
								<div class='sp-cartel__head'>
									<span class='sp-cartel__star' aria-hidden='true'>✱</span>
									<h3 class='sp-cartel__hoy'>Hoy</h3>
									<span class='sp-cartel__star' aria-hidden='true'>✱</span>
								</div>
								<p class='sp-cartel__sub'>en cartel</p>
								<div class='sp-cartel__card'>
									<ul class='sp-cartel__list' data-today-list>
										<li><p class='sp-cartel__what'>Noche Premier</p><p class='sp-cartel__time'>Todas las salas</p></li>
									</ul>
								</div>
							</div>
						</div>

						<div class='cartelera__list'>
<ol class='tickets' data-tickets>
							{tickets.map((e) => {
								const d = nextDate(e.day);
								return (
									<li class='sp-ticket' data-day={e.day} data-venue={e.venue} data-title={e.title}>
										<div class='sp-ticket__date'>
											<span class='sp-ticket__dow'>{weekDays.find((w) => w.day === e.day)!.name.slice(0, 3)}</span>
											<span class='sp-ticket__day' data-num>{d.getDate()}</span>
											<span class='sp-ticket__mon' data-mon>{fmtMon.format(d).replace('.', '')}</span>
											<span class='sp-chip sp-chip--hoy' data-hoy hidden>Hoy</span>
										</div>
										<div class='sp-ticket__info'>
											<p class='ev__title'>{e.title}</p>
											<p class='ev__where'>
												<Icon name='pin' size={14} />
												<span>{venueShort(e.venue)}</span>
												<span class='ev__time'>{e.time}</span>
											</p>
											<p class='ev__detail'>
												{e.detail}
												{e.note && <em> {e.note}.</em>}
											</p>
										</div>
										<div class='sp-ticket__cta'>
											<a class='sp-btn sp-btn--fantasma sp-btn--s' href='#reservas' data-book>Reservar</a>
										</div>
									</li>
								);
							})}
						</ol>
<button class='sp-btn sp-btn--fantasma tickets__more' type='button' data-more hidden></button>
</div>
					</div>
				</div>
			</section>

			<!-- ================= LA EXPERIENCIA ================= -->
		<section class='section experiencia' id='experiencia'>
			<div class='wrap experiencia__grid'>
				<div class='experiencia__copy'>
					<p class='sp-eyebrow'>La experiencia</p>
					<blockquote class='cita'>
						«Entras a tomar una pinta y acabas dentro de una película.»
					</blockquote>
					<p class='body-l'>
							Cruzas una puerta redonda, te sientas en una butaca de terciopelo bajo un reloj antiguo y alguien te pone delante una
							Guinness. En las paredes, estrellas de cine en marcos dorados; en la barra, siempre algo a punto de empezar: el trivial,
							el bingo, un partido.
						</p>
						<figure class='peli-cita'>
							<blockquote>«De todos los bares de todos los pueblos del mundo, tenía que entrar en el mío.»</blockquote>
							<figcaption><span>Rick Blaine</span> · Casablanca, 1942</figcaption>
						</figure>
					</div>
					<div class='experiencia__media'>
					<figure class='arch arch--tall' data-parallax='-6'>
						<Image src={imgSalon} alt='Grupo de amigos en una mesa redonda del salón principal, con paredes ocres y lámparas antiguas' widths={[480, 760, 1100]} sizes='(max-width: 960px) 80vw, 520px' />
					</figure>
					<figure class='arch arch--small' data-parallax='10'>
						<Image src={imgMesas} alt='Amigas en una mesa bajo guirnaldas de luces' widths={[360, 600]} sizes='(max-width: 960px) 46vw, 300px' />
					</figure>
					<div class='seal' aria-hidden='true'>
						<svg class='seal__ring' viewBox='0 0 120 120'>
							<defs><path id='seal-path' d='M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0' /></defs>
							<text><textPath href='#seal-path'>UN PUB · DE PELÍCULA · DESDE MÁLAGA · </textPath></text>
						</svg>
						<Icon name='film' size={30} />
					</div>
				</div>
			</div>
		</section>

		<!-- ================= LAS SALAS ================= -->
		<section class='section salas' id='salas'>
			<div class='wrap'>
				<header class='sec-head sec-head--center'>
					<p class='sp-eyebrow'>Las salas</p>
					<h2 class='display-l'>Cuatro salas</h2>
						<p class='entradilla'>Molina Lario, Plutarco, Río Rocío y Mariana Pineda: la misma película, en cuatro barrios.</p>
				</header>
				<div class='salas__grid'>
					{venues.map((v) => (
						<article class='sp-venue'>
							<div class='sp-venue__frame'>
								<Image class='sp-venue__img' src={venuePhotos[v.id].img} alt={venuePhotos[v.id].alt} widths={[360, 560, 800]} sizes='(max-width: 640px) 86vw, (max-width: 1100px) 44vw, 300px' />
							</div>
							<div class='sp-venue__body'>
								<p class='sp-eyebrow'>{v.city} · {v.area}</p>
								<h3 class='sp-venue__name'>{v.name}</h3>
								<p class='sp-venue__meta'><Icon name='pin' size={16} /><a href={v.maps} target='_blank' rel='noopener'>{v.address}</a></p>
								<p class='sp-venue__meta'>
									<Icon name='clock' size={16} />
									<span>{v.hours.map((h) => <span class='sp-venue__hour'>{h}</span>)}</span>
								</p>
								<p class='sp-venue__meta'><Icon name='phone' size={16} /><a href={`tel:+34${v.phone.replace(/\s/g, '')}`}>{v.phone}</a></p>
								<div class='sp-venue__links'>
										<a class='sp-btn sp-btn--fantasma sp-btn--s' href={cartaUrl(v.id)}>Ver carta</a>
										<a class='sp-btn sp-btn--telon sp-btn--s' href='#reservas' data-book-venue={v.id}>Reservar</a>
									</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ================= LA BARRA ================= -->
		<section class='section barra' id='barra'>
			<div class='wrap barra__grid'>
				<div class='barra__media'>
					<figure class='arch arch--bar' data-parallax='-5'>
						<Image src={imgCocteles} alt='Dos clientas brindando con cócteles de maracuyá frente a las pantallas' widths={[480, 760, 1100]} sizes='(max-width: 960px) 80vw, 480px' />
					</figure>
					<figure class='frame-gold barra__coctel' data-parallax='12'>
						<Image src={imgCoctel} alt='Cóctel rojo con cerezas y pajita de rayas sobre una mesa con dibujos dorados' widths={[300, 520]} sizes='(max-width: 960px) 44vw, 260px' />
					</figure>
				</div>
				<div class='barra__copy'>
					<header class='sec-head'>
						<p class='sp-eyebrow'>La barra</p>
						<h2 class='display-l'>Cócteles de película</h2>
						<p class='entradilla'>Cada copa lleva el nombre de un clásico. Las pintas, el de la casa.</p>
					</header>
					<ul class='programa'>
						{cocktails.map((c) => (
							<li class='programa__item'>
								<div class='programa__row'>
									<h3 class='programa__name'>{c.name}</h3>
									<span class='programa__dots' aria-hidden='true'></span>
									<span class='programa__price'>{c.price} €</span>
								</div>
								<p class='programa__desc'>{c.desc}</p>
							</li>
						))}
					</ul>
				</div>
			</div>
							<div class='wrap'>
					<nav class='cartas' id='cartas' aria-labelledby='cartas-t'>
						<header class='cartas__head'>
							<p class='sp-eyebrow'>Las cartas</p>
							<h3 class='cartas__title' id='cartas-t'>Cada sala, su carta</h3>
							<p class='cartas__text'>Los precios, las ofertas y el calendario cambian de una sala a otra. Abre la de la tuya.</p>
						</header>
						<ul class='cartas__list'>
							{venues.map((v) => (
								<li>
									<a class='cartas__link' href={cartaUrl(v.id)}>
										<Image class='cartas__img' src={venuePhotos[v.id].img} alt='' widths={[320, 520]} sizes='(max-width: 640px) 46vw, 260px' />
										<span class='cartas__body'>
											<span class='cartas__city'>{v.city}</span>
											<span class='cartas__name'>{venueShort(v.id)}</span>
											<span class='cartas__go'>Ver carta <Icon name='arrow' size={16} /></span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				</div>
			</section>

			<!-- ================= TEMPORADA ================= -->
		<section class='section temporada' id='temporada'>
			<div class='wrap'>
