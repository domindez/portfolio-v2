	</main>

	<!-- ================= PIE ================= -->
	<footer class='foot'>
		<div class='wrap'>
			<div class='foot__top'>
				<Image src={imgEmblema} alt='Sala Premier' width={200} densities={[1, 2]} class='foot__emblema' />
				<p class='foot__tag'>Noche de estreno, cada noche.</p>
			</div>
			<div class='foot__venues'>
				{venues.map((v) => (
					<div class='foot__venue'>
						<h3>{v.name}</h3>
						<p>{v.address}<br />{v.city}</p>
						<p><a href={`tel:+34${v.phone.replace(/\s/g, '')}`}>{v.phone}</a><br /><a href={`mailto:${v.email}`}>{v.email}</a></p>
					</div>
				))}
			</div>
			<div class='foot__bottom'>
				<div class='foot__social'>
					<a href={info.instagram} target='_blank' rel='noopener' aria-label='Instagram'><Icon name='instagram' size={20} /></a>
					<a href={info.facebook} target='_blank' rel='noopener' aria-label='Facebook'><Icon name='facebook' size={20} /></a>
				</div>
				<p class='foot__legal'><span>© {new Date().getFullYear()} Sala Premier</span><span>Aviso legal · Cookies</span></p>
			</div>
		</div>
	</footer>
</DemoLayout>

<script>
	import Lenis from 'lenis';
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { events, weekDays, venueShort } from './data/info';
	import { createFilmGrain } from './scripts/film-grain';

	gsap.registerPlugin(ScrollTrigger);
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// ---------- Smooth scroll ----------
	let lenis: Lenis | null = null;
	if (!reduce) {
		lenis = new Lenis({ duration: 1.1, smoothWheel: true });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis?.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);
		document.documentElement.classList.add('lenis');
	}
	const scrollToEl = (el: HTMLElement) => {
		if (lenis) lenis.scrollTo(el, { offset: -70, duration: 1.4 });
		else el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
	};

	// ---------- Nav + menú a pantalla completa ----------
	const nav = document.querySelector<HTMLElement>('[data-nav]')!;
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
	const toggleLabel = toggle.querySelector<HTMLElement>('[data-toggle-label]')!;
	const menu = document.querySelector<HTMLElement>('[data-menu]')!;
	const menuLinks = gsap.utils.toArray<HTMLElement>('.menu__link', menu);
	const menuExtras = gsap.utils.toArray<HTMLElement>('.menu__cartas, .menu__foot', menu);
	let menuOpen = false;
	let menuTl: gsap.core.Timeline | null = null;

	const setMenu = (open: boolean, opts: { instant?: boolean; restoreFocus?: boolean } = {}) => {
		if (open === menuOpen) return;
		menuOpen = open;
		toggle.setAttribute('aria-expanded', String(open));
		toggleLabel.textContent = open ? 'Cerrar menú' : 'Abrir menú';
		nav.classList.toggle('is-open', open);
		document.documentElement.classList.toggle('sp-menu-open', open);
		menuTl?.kill();

		if (open) {
			lenis?.stop();
			menu.hidden = false;
			if (reduce || opts.instant) {
				gsap.set(menu, { clipPath: 'inset(0 0 0% 0)' });
				gsap.set([...menuLinks, ...menuExtras], { clearProps: 'all' });
			} else {
				// el telón cae, luego entran las líneas del programa
				menuTl = gsap
					.timeline()
					.fromTo(menu, { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: 0.75, ease: 'power4.inOut' })
					.fromTo(menuLinks, { yPercent: 110 }, { yPercent: 0, duration: 0.8, ease: 'expo.out', stagger: 0.055 }, 0.4)
					.fromTo(menuExtras, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out', stagger: 0.08 }, 0.65);
			}
			menu.focus({ preventScroll: true });
		} else {
			lenis?.start();
			const done = () => {
				menu.hidden = true;
				gsap.set(menu, { clearProps: 'clipPath' });
			};
			if (reduce || opts.instant) done();
			else
				menuTl = gsap
					.timeline({ onComplete: done })
					.to([...menuLinks, ...menuExtras], { opacity: 0, duration: 0.2, ease: 'power1.out' })
					.to(menu, { clipPath: 'inset(0 0 100% 0)', duration: 0.55, ease: 'power3.inOut' }, 0.1)
					.set([...menuLinks, ...menuExtras], { clearProps: 'opacity' });
			if (opts.restoreFocus) toggle.focus();
		}
	};
	toggle.addEventListener('click', () => setMenu(!menuOpen));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menuOpen) setMenu(false, { restoreFocus: true });
	});
	// foco atrapado dentro del menú (botón de cierre incluido)
	menu.addEventListener('keydown', (e) => {
		if (e.key !== 'Tab') return;
		const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a, button')];
		const first = focusables[0];
		const last = focusables[focusables.length - 1];
		if (e.shiftKey && document.activeElement === menuLinks[0]) {
			e.preventDefault();
			first.focus();
		} else if (!e.shiftKey && document.activeElement === last) {
			e.preventDefault();
			first.focus();
		}
	});
	toggle.addEventListener('keydown', (e) => {
		if (menuOpen && e.key === 'Tab' && !e.shiftKey) {
			e.preventDefault();
			menuLinks[0]?.focus();
		}
	});
	matchMedia('(min-width: 961px)').addEventListener('change', (m) => m.matches && setMenu(false, { instant: true }));

	const stageEl = document.querySelector<HTMLElement>('.stage')!;
	const onScroll = () => {
		const past = window.scrollY > stageEl.offsetHeight - 120;
		nav.classList.toggle('is-solid', past);
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
		a.addEventListener('click', (e) => {
			const id = a.getAttribute('href');
			if (!id || id === '#') return;
			const target = document.querySelector<HTMLElement>(id);
			if (!target) return;
			e.preventDefault();
			const wasOpen = menuOpen;
			setMenu(false);
			// espera a que suba el telón antes de desplazarse
			if (wasOpen && !reduce) setTimeout(() => scrollToEl(target), 380);
			else scrollToEl(target);
		});
	});

	// ---------- Intro: película antigua ----------
	// Desde negro se abre un iris difuminado, como en el cine mudo, sobre el hero en sepia con
	// grano, rayas, polvo, parpadeo y temblor de proyector. Al abrirse del todo vira a color
	// y se encienden las bombillas de la marquesina.
	const bulbs = gsap.utils.toArray<HTMLElement>('.bulb');
	const lightBulbs = () => bulbs.forEach((b, i) => setTimeout(() => b.classList.add('is-on'), i * 22));
	const root = document.documentElement;
	const reel = document.querySelector<HTMLElement>('.reel');

	if (reduce || !reel || !root.classList.contains('sp-intro')) {
		root.classList.remove('sp-intro');
		reel?.remove();
		bulbs.forEach((b) => b.classList.add('is-on'));
	} else {
		const pin = document.querySelector<HTMLElement>('.stage__pin')!;
		const iris = reel.querySelector<HTMLElement>('.reel__iris')!;
		const content = document.querySelector<HTMLElement>('.stage__content')!;

		// el iris se centra en el rótulo
		const sign = document.querySelector<HTMLElement>('.marquee-sign')!.getBoundingClientRect();
		const stageBox = stageEl.getBoundingClientRect();
		iris.style.setProperty('--cy', `${sign.top + sign.height / 2 - stageBox.top}px`);

		// temblor del fotograma en la ventanilla del proyector ("gate weave")
		const weave = { k: 1 };
		const jitter = () => {
			const k = weave.k;
			content.style.transform = `translate(${(Math.random() - 0.5) * 3 * k}px, ${(Math.random() - 0.5) * 4 * k + (Math.random() < 0.05 ? 5 * k : 0)}px)`;
		};
		const grain = createFilmGrain(reel.querySelector<HTMLCanvasElement>('.reel__grain')!, jitter);

		gsap.set(nav, { opacity: 0 });
		pin.style.setProperty('--old', '1');

		const tl = gsap.timeline({
			delay: 0.05,
			onComplete: () => {
				removeSkip();
				grain?.destroy();
				reel.remove();
				root.classList.remove('sp-intro');
				content.style.transform = '';
				pin.style.removeProperty('--old');
				gsap.set(nav, { clearProps: 'all' });
			},
		});

		// 1 · Iris: se abre desde negro con el borde difuminado
		tl.fromTo(iris, { '--r': '0vmax' }, { '--r': '95vmax', duration: 0.95, ease: 'power2.inOut' }, 0)
			// 2 · El fotograma viejo vira a color y se van el grano, el temblor y la viñeta
			.to(pin, { '--old': 0, duration: 0.6, ease: 'power2.inOut' }, 0.6)
			.to(weave, { k: 0, duration: 0.5, ease: 'power2.in' }, 0.6)
			.to(grain ?? {}, { amount: 0, duration: 0.6, ease: 'power2.in' }, 0.6)
			.to(reel.querySelector('.reel__vignette'), { opacity: 0, duration: 0.6, ease: 'power2.inOut' }, 0.6)
			.call(lightBulbs, [], 0.75)
			.to(nav, { opacity: 1, duration: 0.4, ease: 'power2.out' }, 0.9);

		// si la persona interactúa, acelera la intro (sin bloquear el scroll)
		const skipEvents = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
		const skip = () => {
			tl.timeScale(4);
			removeSkip();
		};
		function removeSkip() {
			skipEvents.forEach((ev) => window.removeEventListener(ev, skip));
		}
		skipEvents.forEach((ev) => window.addEventListener(ev, skip, { passive: true }));
	}

	// ---------- Hero: polvo de luz (partículas doradas a la deriva) ----------
	{
		const cv = document.querySelector<HTMLCanvasElement>('.stage__dust');
		const ctx = cv?.getContext('2d');
		if (cv && ctx && !reduce) {
			let w = 0, h = 0, dpr = 1, visible = true, raf = 0;
			const mobile = matchMedia('(max-width: 640px)').matches;
			const N = mobile ? 32 : 70;
			type P = { x: number; y: number; r: number; vy: number; vx: number; a: number; ph: number };
			const mk = (init: boolean): P => ({
				x: Math.random() * w, y: init ? Math.random() * h : h + 10,
				r: 0.4 + Math.random() * 1.6, vy: -(0.06 + Math.random() * 0.22), vx: (Math.random() - 0.5) * 0.12,
				a: 0.15 + Math.random() * 0.55, ph: Math.random() * 6.28,
			});
			let ps: P[] = [];
			const size = () => {
				dpr = Math.min(devicePixelRatio || 1, 2);
				w = cv.clientWidth; h = cv.clientHeight;
				cv.width = w * dpr; cv.height = h * dpr;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ps = Array.from({ length: N }, () => mk(true));
			};
			const frame = (t: number) => {
				ctx.clearRect(0, 0, w, h);
				for (const p of ps) {
					p.y += p.vy; p.x += p.vx + Math.sin(t / 2200 + p.ph) * 0.08;
					if (p.y < -10) Object.assign(p, mk(false));
					const tw = 0.6 + 0.4 * Math.sin(t / 900 + p.ph);
					const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
					g.addColorStop(0, `rgba(255, 226, 150, ${p.a * tw})`);
					g.addColorStop(1, 'rgba(255, 226, 150, 0)');
					ctx.fillStyle = g;
					ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 4, 0, 6.283); ctx.fill();
				}
				raf = visible ? requestAnimationFrame(frame) : 0;
			};
			size();
			new ResizeObserver(size).observe(cv);
			new IntersectionObserver(([e]) => {
				visible = e.isIntersecting;
				if (visible && !raf) raf = requestAnimationFrame(frame);
			}).observe(cv);
			raf = requestAnimationFrame(frame);
		}
	}

	// ---------- Cartelera: calendario real de cada sala ----------
	const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Madrid' }));
	// Antes de las 6:00 seguimos en "la noche de ayer"
	const ref = new Date(now);
	if (now.getHours() < 6) ref.setDate(ref.getDate() - 1);
	const dow = ref.getDay();
	const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
	const dateFor = (day: number) => {
		const d = new Date(ref);
		d.setDate(ref.getDate() + ((day - dow + 7) % 7));
		return d;
	};
	let activeVenue = 'all';
	let ticketsIntro: gsap.core.Tween | null = null;

	const renderToday = () => {
		const list = document.querySelector<HTMLElement>('[data-today-list]');
		if (!list) return;
		const todays = events.filter((e) => e.day === dow && (activeVenue === 'all' || e.venue === activeVenue));
		list.replaceChildren(
			...(todays.length
				? todays.map((e) => {
						const li = document.createElement('li');
						li.innerHTML = '<p class="sp-cartel__what"></p><p class="sp-cartel__time"></p><p class="sp-cartel__detail"></p>';
						li.children[0].textContent = e.title;
						li.children[1].textContent = `${venueShort(e.venue)} · ${e.time}`;
						li.children[2].textContent = e.detail;
						return li;
					})
				: [
						(() => {
							const li = document.createElement('li');
							li.innerHTML = '<p class="sp-cartel__what">Noche Premier</p><p class="sp-cartel__detail">Pintas, música y ambiente hasta el cierre.</p>';
							return li;
						})(),
					]),
		);
	};

	{
		const list = document.querySelector<HTMLElement>('[data-tickets]');
		const mon = new Intl.DateTimeFormat('es-ES', { month: 'short' });
		if (list) {
			[...list.querySelectorAll<HTMLElement>('.sp-ticket')]
				.map((li, i) => {
					const d = Number(li.dataset.day);
					const offset = (d - dow + 7) % 7;
					const date = dateFor(d);
					li.querySelector('[data-num]')!.textContent = String(date.getDate());
					li.querySelector('[data-mon]')!.textContent = mon.format(date).replace('.', '');
					li.classList.toggle('is-today', offset === 0);
					(li.querySelector('[data-hoy]') as HTMLElement).hidden = offset !== 0;
					return { li, offset, i };
				})
				.sort((a, b) => a.offset - b.offset || a.i - b.i)
				.forEach(({ li }) => list.appendChild(li));
		}
		renderToday();

		// Se ven 5 funciones; el resto, con "Ver más"
		const LIMIT = 5;
		const more = document.querySelector<HTMLButtonElement>('[data-more]')!;
		let expanded = false;
		const applyTickets = () => {
			const all = [...document.querySelectorAll<HTMLElement>('.sp-ticket')];
			const match = all.filter((t) => activeVenue === 'all' || t.dataset.venue === activeVenue);
			all.forEach((t) => (t.hidden = true));
			match.forEach((t, i) => (t.hidden = !(expanded || i < LIMIT)));
			more.hidden = match.length <= LIMIT;
			more.textContent = expanded ? 'Ver menos' : `Ver las ${match.length - LIMIT} restantes`;
		};
		more.addEventListener('click', () => {
			expanded = !expanded;
			applyTickets();
		});
		applyTickets();

		// Filtro por sala
		const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
		filters.forEach((btn) =>
			btn.addEventListener('click', () => {
				activeVenue = btn.dataset.filter!;
				filters.forEach((b) => {
					const on = b === btn;
					b.classList.toggle('is-active', on);
					b.setAttribute('aria-pressed', String(on));
				});
				expanded = false;
				applyTickets();
				renderToday();
				// El filtro cambia la altura de la sección: se recalculan los disparadores para que la entrada de los tickets se active
				ScrollTrigger.refresh();
				// Si la entrada aún no ha ocurrido, la lanza el scroll; si ya ocurrió, se anima el cambio de filtro
				if (!reduce && (!ticketsIntro || ticketsIntro.progress() === 1)) gsap.fromTo('.sp-ticket:not([hidden])', { opacity: 0.2, y: 10 }, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out', stagger: 0.04, overwrite: 'auto' });
			}),
		);
	}

	// ---------- Formulario (demo) ----------
	{
		const form = document.querySelector<HTMLFormElement>('[data-form]')!;
		const msg = document.querySelector<HTMLElement>('[data-form-msg]')!;
		const date = form.querySelector<HTMLInputElement>('[data-field-date]')!;
		const venue = form.querySelector<HTMLSelectElement>('[data-field-venue]')!;
		const plan = form.querySelector<HTMLSelectElement>('[data-field-plan]')!;
		const t = new Date();
		date.min = iso(t);
		date.value = iso(t);

		// "Reservar" en un día de la cartelera: fecha, sala (si hay filtro) y plan
		document.querySelectorAll<HTMLElement>('[data-book]').forEach((b) =>
			b.addEventListener('click', () => {
									date.value = iso(dateFor(Number(b.closest<HTMLElement>('.sp-ticket')?.dataset.day)));

				const t = b.closest<HTMLElement>('.sp-ticket');
				plan.value = t?.dataset.title ?? plan.options[0].value;
				if (t?.dataset.venue) venue.value = t.dataset.venue;
			}),
		);
		document.querySelectorAll<HTMLElement>('[data-book-venue]').forEach((b) => b.addEventListener('click', () => (venue.value = b.dataset.bookVenue!)));

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!form.checkValidity()) {
				form.classList.add('was-validated');
				msg.dataset.state = 'error';
				msg.textContent = 'Revisa los campos marcados: nos falta algún dato.';
				form.querySelector<HTMLElement>(':invalid')?.focus();
				return;
			}
			const data = new FormData(form);
			const v = venue.options[venue.selectedIndex].text;
			const d = new Date(`${data.get('fecha')}T12:00`).toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
			msg.dataset.state = 'ok';
			msg.textContent = `¡Hecho, ${data.get('nombre')}! Mesa para ${data.get('personas')} en ${v}, ${d} a las ${data.get('hora')}h. Te escribimos por WhatsApp para confirmar.`;
			form.classList.remove('was-validated');
		});
	}

	// ---------- Celebraciones: invitación (demo) ----------
	{
		const form = document.querySelector<HTMLFormElement>('[data-celebra]');
		const msg = document.querySelector<HTMLElement>('[data-celebra-msg]');
		const date = form?.querySelector<HTMLInputElement>('[data-celebra-date]');
		if (form && msg && date) {
			const d = new Date();
			d.setDate(d.getDate() + 14);
			date.min = iso(new Date());
			date.value = iso(d);
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				if (!form.checkValidity()) {
					form.classList.add('was-validated');
					msg.textContent = 'Nos falta saber cuántos sois o qué día.';
					return;
				}
				const data = new FormData(form);
				const sala = form.querySelector<HTMLSelectElement>('select[name="sala"]')!;
				const opt = sala.options[sala.selectedIndex];
				const fecha = new Date(`${data.get('fecha')}T12:00`).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
				const text = `Hola, somos ${data.get('personas')} personas y queremos celebrar ${data.get('tipo')} en ${opt.text} el ${fecha}. ¿Nos podéis pasar presupuesto?`;
				form.classList.remove('was-validated');
				msg.textContent = `Abriendo WhatsApp con ${opt.text}…`;
				window.open(`https://wa.me/${opt.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
			});
		}
	}

	// ---------- Temporada: carrusel ----------
	{
		const track = document.querySelector<HTMLElement>('[data-posters]')!;
		const step = () => (track.querySelector<HTMLElement>('.poster')?.offsetWidth ?? 300) + 24;
		document.querySelector('[data-season-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
		document.querySelector('[data-season-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));

		// En escritorio la sección se ancla y el scroll vertical desplaza los carteles hasta verlos todos
		if (!reduce) {
			const section = document.querySelector<HTMLElement>('.temporada')!;
			ScrollTrigger.matchMedia({
				'(min-width: 961px) and (hover: hover) and (pointer: fine)': () => {
					section.classList.add('is-pinned');
					const dist = () => Math.max(0, track.scrollWidth - track.clientWidth);
					gsap.fromTo(track, { scrollLeft: 0 }, {
						scrollLeft: dist,
						ease: 'none',
						scrollTrigger: { trigger: section, start: 'top top', end: () => `+=${dist()}`, pin: true, scrub: 0.6, invalidateOnRefresh: true, anticipatePin: 1 },
					});
					return () => {
						section.classList.remove('is-pinned');
						track.scrollLeft = 0;
					};
				},
			});
		}
	}

	// ---------- Revelados y parallax ----------
	if (!reduce) {
		gsap.utils.toArray<HTMLElement>('.sec-head, .experiencia__copy > *, .barra__copy .programa__item, .reservas__side > *').forEach((el) => {
			gsap.from(el, { y: 36, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%' } });
		});
		ticketsIntro = gsap.from('.sp-ticket', { x: 40, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.07, scrollTrigger: { trigger: '.tickets', start: 'top 82%' } });
		
		gsap.from('.sp-venue', { y: 80, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: 0.12, scrollTrigger: { trigger: '.salas__grid', start: 'top 85%' } });
		gsap.from('.vale', { y: 40, opacity: 0, rotate: -2, duration: 0.9, ease: 'back.out(1.6)', stagger: 0.1, scrollTrigger: { trigger: '.vales', start: 'top 90%' } });
		gsap.from('.cartas__list li', { y: 30, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, scrollTrigger: { trigger: '.cartas', start: 'top 90%' } });
		gsap.from('.invite', { y: 70, opacity: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: '.celebra', start: 'top 70%' } });
		gsap.from('.invite__facts > div', { y: 24, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.1, scrollTrigger: { trigger: '.invite__facts', start: 'top 92%' } });
		gsap.from('.poster', { y: 60, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.08, scrollTrigger: { trigger: '.posters', start: 'top 88%' } });

		gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach((el) => {
			const amt = Number(el.dataset.parallax || 0);
			gsap.fromTo(el, { yPercent: amt }, { yPercent: -amt, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
		});
		gsap.to('.seal__ring', { rotate: 360, ease: 'none', scrollTrigger: { trigger: '.experiencia', start: 'top bottom', end: 'bottom top', scrub: true } });
	}

	// ---------- Contadores ----------
	document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
		const end = Number(el.dataset.count || 0);
		const fmt = (v: number) => Math.round(v).toLocaleString('es-ES');
		if (reduce) return;
		const obj = { v: 0 };
		el.textContent = fmt(0);
		ScrollTrigger.create({
			trigger: el,
			start: 'top 92%',
			once: true,
			onEnter: () => gsap.to(obj, { v: end, duration: 1.8, ease: 'power2.out', onUpdate: () => (el.textContent = fmt(obj.v)) }),
		});
	});
</script>
