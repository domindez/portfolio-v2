							))}
						</ul>
					</div>
					<div class='ig'>
						<div class='ig__head'>
							<h3 class='titulo'>{info.instagramHandle}</h3>
							<a class='sp-venue__link' href={info.instagram} target='_blank' rel='noopener'>Seguir</a>
						</div>
						<ul class='ig__grid'>
							{igGrid.map((g) => (
								<li>
									<a href={info.instagram} target='_blank' rel='noopener' aria-label={`Ver en Instagram: ${g.alt}`}>
										<Image src={g.img} alt={g.alt} width={260} height={260} densities={[1, 2]} />
									</a>
