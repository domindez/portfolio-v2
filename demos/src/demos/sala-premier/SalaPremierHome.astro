		</section>

		<!-- ================= CELEBRACIONES ================= -->
		<section class='section celebra' id='celebraciones'>
			<div class='wrap celebra__grid'>
				<figure class='celebra__photo'>
					<Image src={imgAmb2} alt='Grupo de amigos brindando entre cuadros de cine en Sala Premier' widths={[480, 800, 1200]} sizes='(max-width: 960px) 100vw, 640px' />
				</figure>

				<div class='invite'>
					<p class='invite__pre'>Sala Premier tiene el gusto de reservarte</p>
					<h2 class='invite__title'>Tu propia función</h2>
					<p class='invite__text'>
						Reservamos una zona del local para tu grupo. Cuando llegáis, la mesa ya está puesta y la música la elegís vosotros:
							mandadnos la lista.
					</p>

					<form class='invite__form' data-celebra novalidate>
						<p class='madlib'>
							Somos
							<label class='madlib__field madlib__field--num'>
								<span class='visually-hidden'>Número de personas</span>
								<input type='number' name='personas' min='6' max='150' value='15' inputmode='numeric' required />
							</label>
							personas y queremos celebrar
							<label class='madlib__field'>
								<span class='visually-hidden'>Qué celebráis</span>
								<select name='tipo'>{occasions.map((o) => <option>{o}</option>)}</select>
							</label>
							en
							<label class='madlib__field'>
								<span class='visually-hidden'>Sala</span>
								<select name='sala'>{venues.map((v) => <option value={v.id} data-wa={waDigits(v.phone)}>{v.name}</option>)}</select>
							</label>
							el
							<label class='madlib__field'>
								<span class='visually-hidden'>Fecha</span>
								<input type='date' name='fecha' required data-celebra-date />
							</label>
						</p>
						<div class='invite__actions'>
							<button class='sp-btn sp-btn--telon' type='submit'><Icon name='whatsapp' size={18} />Pedir por WhatsApp</button>
						</div>
						<p class='invite__msg' role='status' aria-live='polite' data-celebra-msg></p>
					</form>

					<dl class='invite__facts'>
						<div>
							<dt>La zona</dt>
							<dd>Reservada para tu grupo, en cualquiera de las cuatro salas.</dd>
						</div>
						<div>
							<dt>La mesa</dt>
							<dd>Botella de primeras marcas y 10 refrescos por 45 €.</dd>
						</div>
						<div>
							<dt>La música</dt>
							<dd>Tú pones la lista, nosotros el volumen.</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<!-- ================= RESERVAS ================= -->
		<section class='section reservas' id='reservas'>
			<div class='wrap reservas__grid'>
				<div class='reservas__panel'>
					<header class='sec-head'>
						<p class='sp-eyebrow'>Reservas</p>
						<h2 class='display-l'>Te guardamos la mejor mesa</h2>
						<p class='entradilla'>Dinos sala, día y cuántos venís. Te confirmamos por WhatsApp.</p>
					</header>
					<form class='form' data-form novalidate>
						<div class='form__row'>
							<label class='field'>
								<span>Sala</span>
								<select name='sala' required data-field-venue>
									{venues.map((v) => <option value={v.id}>{v.name}</option>)}
								</select>
							</label>
							<label class='field'>
								<span>Plan</span>
								<select name='plan' data-field-plan>
									<option>Mesa para tomar algo</option>
									{eventTypes.map((t) => <option>{t}</option>)}
									<option value='Celebración'>Celebración / grupo</option>
								</select>
							</label>
						</div>
						<div class='form__row form__row--3'>
							<label class='field'>
								<span>Día</span>
								<input type='date' name='fecha' required data-field-date />
							</label>
							<label class='field'>
								<span>Hora</span>
								<input type='time' name='hora' value='21:00' required />
							</label>
							<label class='field'>
								<span>Personas</span>
								<input type='number' name='personas' min='1' max='60' value='4' required />
							</label>
