						<button type='button' class='round-btn' data-season-prev aria-label='Anterior'><Icon name='arrow' size={20} class='flip' /></button>
						<button type='button' class='round-btn' data-season-next aria-label='Siguiente'><Icon name='arrow' size={20} /></button>
					</div>
				</header>
			</div>
			<ul class='posters' data-posters>
