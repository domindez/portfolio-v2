---
import '@fontsource-variable/cinzel/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import './sala-premier.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import Icon from './components/Icon.astro';
import { venues, events, weekDays, venueShort, info } from './data/info';
import { cartas } from './data/cartas';
import { venuePhotos } from './data/photos';
import imgWordmark from '../../assets/demos/sala-premier/wordmark.png';
import imgEmblema from '../../assets/demos/sala-premier/emblema.png';

interface Props {
	sala: string;
}
const { sala } = Astro.props as Props;
const v = venues.find((x) => x.id === sala)!;
const sections = cartas[sala] ?? [];
const photo = venuePhotos[sala];
const others = venues.filter((x) => x.id !== sala);

const base = '/sala-premier';
const tel = `tel:+34${v.phone.replace(/\s/g, '')}`;

const week = weekDays
	.map((d) => ({ ...d, items: events.filter((e) => e.venue === sala && e.day === d.day) }))
	.filter((d) => d.items.length);
---

<DemoLayout
	title={`La carta · ${v.name} · Sala Premier`}
	description={`Carta de ${v.name} (${v.city}): cervezas, cócteles y más. Calendario semanal de trivial, pasapalabra y ofertas.`}
	themeColor='#0d0909'
	ogImage='/demo-og/sala-premier.jpg'
	ogImageAlt='Sala Premier: un pub de película en Málaga y Granada.'
	siteName='Sala Premier'
	favicon='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%230d0909%22/%3E%3Cellipse cx=%2232%22 cy=%2232%22 rx=%2222%22 ry=%2226%22 fill=%22none%22 stroke=%22%23d1a650%22 stroke-width=%223%22 stroke-dasharray=%223 2%22/%3E%3Ctext x=%2232%22 y=%2243%22 font-family=%22Georgia,serif%22 font-size=%2232%22 text-anchor=%22middle%22 fill=%22%23d1a650%22%3EP%3C/text%3E%3C/svg%3E'
	bodyClass='sp sp-carta'
>
	<a class='sp-skip' href='#carta'>Saltar a la carta</a>

	<header class='ct-top'>
		<div class='ct-top__row'>
			<a class='ct-top__back' href={base} aria-label='Volver a Sala Premier'>
				<Icon name='arrow' size={18} class='flip' />
				<Image src={imgWordmark} alt='' width={130} densities={[1, 2]} loading='eager' />
			</a>
			<nav class='ct-switch' aria-label='Cartas de las salas'>
				{venues.map((x) => (
					<a href={`${base}/carta/${x.id}`} aria-current={x.id === sala ? 'page' : undefined}>{venueShort(x.id)}</a>
				))}
			</nav>
			<a class='sp-btn sp-btn--telon sp-btn--s ct-top__cta' href={`${base}#reservas`}>Reservar</a>
		</div>
	</header>

	<main>
		<!-- ===== Cabecera de la sala ===== -->
		<section class='ct-hero'>
			<div class='wrap ct-hero__grid'>
				<div class='ct-hero__copy'>
					<p class='sp-eyebrow'>La carta · {v.city} · {v.area}</p>
					<h1 class='ct-hero__title'>{v.name}</h1>
				</div>
				<figure class='arch ct-hero__img'>
					<Image src={photo.img} alt={photo.alt} widths={[400, 640, 900]} sizes='(max-width: 860px) 70vw, 380px' loading='eager' />
				</figure>
			</div>

			{week.length > 0 && (
				<div class='wrap'>
					<div class='ct-week'>
						<p class='ct-week__label'>Esta semana en {venueShort(sala)}</p>
						<ul class='ct-week__list'>
							{week.map((d) =>
								d.items.map((e) => (
									<li class='ct-week__item'>
										<span class='ct-week__day'>{d.name.slice(0, 3)}</span>
										<span class='ct-week__what'>
											<strong>{e.title}</strong>
											<span>{e.time} · {e.detail}</span>
										</span>
									</li>
								)),
							)}
						</ul>
					</div>
				</div>
			)}
		</section>

		<!-- ===== Índice de secciones ===== -->
		<nav class='ct-tabs' aria-label='Secciones de la carta' data-tabs>
			<div class='ct-tabs__track'>
				{sections.map((s) => (
					<a href={`#${s.id}`} data-tab={s.id}>
						{s.title}
					</a>
				))}
			</div>
		</nav>

		<!-- ===== Carta ===== -->
		<div class='wrap' id='carta'>
			{sections.map((s) => (
				<section class='ct-sec' id={s.id} data-sec>
					<header class='ct-sec__head'>
						<h2 class='ct-sec__title'>{s.title}</h2>
						
					</header>
					<div class='ct-sec__body'>
						{s.groups.map((g) => (
							<div class:list={['ct-group', { 'ct-group--cols': g.columns }]}>
								<div class='ct-group__head'>
									<h3 class='ct-group__title'>{g.title}</h3>
									{g.columns && (
										<div class='ct-prices ct-prices--head' style={`--n:${g.columns.length}`}>
											{g.columns.map((c) => <span>{c}</span>)}
										</div>
									)}
								</div>
								<ul class='ct-items'>
									{g.items.map((it) => (
										<li class='ct-item'>
											<div class='ct-item__row'>
												<h4 class='ct-item__name'>
													{it.name}
													{it.badge && <span class='ct-badge'>{it.badge}</span>}
												</h4>
												<span class='ct-item__dots' aria-hidden='true'></span>
												{Array.isArray(it.price) ? (
													<span class='ct-prices' style={`--n:${it.price.length}`}>
														{it.price.map((p, k) => (
															<span>
																<span class='visually-hidden'>{g.columns?.[k]}: </span>
																{p ? `${p} €` : <span aria-label='No disponible'>—</span>}
															</span>
														))}
													</span>
												) : (
													it.price && <span class='ct-item__price'>{it.price} €</span>
												)}
											</div>
											{it.desc && <p class='ct-item__desc'>{it.desc}</p>}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>
			))}

			<section class='ct-info' aria-label={`Cómo llegar a ${v.name}`}>
				<h2 class='ct-info__title'>{v.name}</h2>
				<ul class='ct-hero__meta'>
					<li><Icon name='pin' size={17} /><a href={v.maps} target='_blank' rel='noopener'>{v.address}, {v.city}</a></li>
					<li><Icon name='clock' size={17} /><span>{v.hours.join(' · ')}</span></li>
					<li><Icon name='phone' size={17} /><a href={tel}>{v.phone}</a></li>
				</ul>
			</section>
		</div>

		<!-- ===== Otras salas ===== -->
		<section class='section ct-others'>
			<div class='wrap'>
				<p class='cartas__label'>¿Otra sala? Consulta su carta</p>
				<ul class='cartas__list ct-others__list'>
					{others.map((x) => (
						<li>
							<a class='cartas__link' href={`${base}/carta/${x.id}`}>
								<Image class='cartas__img' src={venuePhotos[x.id].img} alt='' widths={[320, 520]} sizes='(max-width: 640px) 46vw, 260px' />
								<span class='cartas__body'>
									<span class='cartas__city'>{x.city}</span>
									<span class='cartas__name'>{venueShort(x.id)}</span>
									<span class='cartas__go'>Ver carta <Icon name='arrow' size={16} /></span>
								</span>
							</a>
						</li>
					))}
				</ul>
				<div class='ct-others__cta'>
					<a class='sp-btn sp-btn--telon' href={`${base}#reservas`}><Icon name='ticket' size={18} />Reservar mesa en {v.name}</a>
				</div>
			</div>
		</section>
	</main>

	<footer class='foot ct-foot'>
		<div class='wrap'>
			<div class='foot__top'>
				<Image src={imgEmblema} alt='Sala Premier' width={140} densities={[1, 2]} class='foot__emblema ct-foot__emblema' />
				<p class='foot__tag'>Noche de estreno, cada noche.</p>
			</div>
			<div class='foot__bottom'>
				<div class='foot__social'>
					<a href={info.instagram} target='_blank' rel='noopener' aria-label='Instagram'><Icon name='instagram' size={20} /></a>
					<a href={info.facebook} target='_blank' rel='noopener' aria-label='Facebook'><Icon name='facebook' size={20} /></a>
				</div>
				<p>© {new Date().getFullYear()} Sala Premier · {v.name} · {v.address}</p>
			</div>
		</div>
	</footer>
</DemoLayout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Índice: marca la sección visible y la mantiene a la vista en móvil
	const tabs = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')].map((a) => [a.dataset.tab!, a]));
	const track = document.querySelector<HTMLElement>('.ct-tabs__track');
	const setActive = (id: string) => {
		tabs.forEach((a, key) => {
			const on = key === id;
			a.classList.toggle('is-active', on);
			if (on) a.setAttribute('aria-current', 'true');
			else a.removeAttribute('aria-current');
		});
		const a = tabs.get(id);
		if (a && track) track.scrollTo({ left: a.offsetLeft - 16, behavior: reduce ? 'auto' : 'smooth' });
	};
	document.querySelectorAll<HTMLElement>('[data-sec]').forEach((sec) => {
		ScrollTrigger.create({
			trigger: sec,
			start: 'top 45%',
			end: 'bottom 45%',
			onToggle: (self) => self.isActive && setActive(sec.id),
		});
	});

	// Índice desplazable con la rueda y arrastrando cuando no cabe entero
	if (track) {
		track.addEventListener('wheel', (e) => {
			if (track.scrollWidth <= track.clientWidth || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
			e.preventDefault();
			track.scrollLeft += e.deltaY;
		}, { passive: false });
		let drag: { x: number; left: number } | null = null;
		let moved = false;
		track.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse') return;
			drag = { x: e.clientX, left: track.scrollLeft };
			moved = false;
		});
		window.addEventListener('pointermove', (e) => {
			if (!drag) return;
			const dx = e.clientX - drag.x;
			if (Math.abs(dx) > 4) moved = true;
			track.scrollLeft = drag.left - dx;
		});
		window.addEventListener('pointerup', () => (drag = null));
		track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
	}

	tabs.forEach((a) =>
		a.addEventListener('click', (e) => {
			const target = document.getElementById(a.dataset.tab!);
			if (!target) return;
			e.preventDefault();
			const offset = (document.querySelector<HTMLElement>('.ct-top')?.offsetHeight ?? 0) + (document.querySelector<HTMLElement>('.ct-tabs')?.offsetHeight ?? 0) + 8;
			window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: reduce ? 'auto' : 'smooth' });
			history.replaceState(null, '', `#${target.id}`);
		}),
	);

	if (!reduce) {
		gsap.from('.ct-hero__copy > *', { y: 30, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.08 });
		gsap.from('.ct-hero__img', { y: 50, opacity: 0, duration: 1.3, ease: 'expo.out', delay: 0.15 });
		gsap.utils.toArray<HTMLElement>('.ct-sec__head, .ct-group').forEach((el) => {
			gsap.from(el, { y: 36, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 90%' } });
		});
	}
</script>
