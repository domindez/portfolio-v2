---
/** Hoja-S de Shanao redibujada en SVG (hereda color con currentColor). */
interface Props {
	class?: string;
	size?: number | string;
	title?: string;
}
const { class: cls = '', size = 32, title } = Astro.props as Props;
---

<svg
	class={cls}
	width={size}
	height={size}
	viewBox='0 0 100 120'
	fill='none'
	role={title ? 'img' : undefined}
	aria-label={title}
	aria-hidden={title ? undefined : 'true'}
>
	<path
		d='M50 2C27 22 8 50 8 74c0 22 19 36 42 36s42-14 42-36C92 50 73 22 50 2Z'
		fill='currentColor'
	/>
	<path d='M50 8v101' stroke='var(--leaf-cut, #fff)' stroke-width='4' />
	<path d='M50 108v12' stroke='currentColor' stroke-width='4' stroke-linecap='round' />
	<path
		d='M86 52C70 44 46 44 30 50M18 82c18-6 42-6 60 4'
		stroke='var(--leaf-cut, #fff)'
		stroke-width='5'
		stroke-linecap='round'
	/>
</svg>
