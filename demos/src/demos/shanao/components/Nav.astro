---
import Leaf from './Leaf.astro';
import Icon from './Icon.astro';
import { info } from '../data/info';
interface Props {
	homeHref: string;
	cartaHref: string;
	variant?: 'home' | 'carta';
	/** 'light': texto blanco mientras está sobre una foto (antes de hacer scroll) */
	tone?: 'dark' | 'light';
}
const { homeHref, cartaHref, variant = 'home', tone = 'dark' } = Astro.props as Props;
const links =
	variant === 'home'
		? [
				{ href: cartaHref, label: 'La carta' },
				{ href: '#favoritos', label: 'Favoritos' },
				{ href: '#local', label: 'El local' },
				{ href: '#opiniones', label: 'Opiniones' },
				{ href: '#visitanos', label: 'Visítanos' },
			]
		: [];
---

<header class:list={['sh-nav', { 'sh-nav--light': tone === 'light' }]} data-nav>
	<div class='sh-nav__inner'>
		<a href={homeHref} class='sh-nav__brand' aria-label='Shanao Café, inicio'>
			<Leaf size={30} class='sh-nav__leaf' />
			<span class='sh-nav__word'>shanao</span>
			<span class='sh-nav__cafe'>café</span>
		</a>
		{
			links.length > 0 && (
				<nav class='sh-nav__links' aria-label='Secciones'>
					{links.map((l) => (
						<a href={l.href}>{l.label}</a>
					))}
				</nav>
			)
		}
		<div class='sh-nav__end'>
			<slot name='end' />
			{
				variant === 'home' ? (
					<>
						<a class='btn sh-nav__cta sh-nav__cta--desk' href={cartaHref}>
							Ver carta
						</a>
						<button class='sh-nav__toggle' type='button' aria-label='Abrir menú' aria-expanded='false' aria-controls='sh-menu' data-menu-toggle>
							<span class='sh-nav__bars' aria-hidden='true'><i></i><i></i></span>
						</button>
					</>
				) : (
					<a class='btn btn--ghost sh-nav__cta sh-nav__back' href={homeHref}>
						<span aria-hidden='true'>←</span>
						<span class='sh-nav__back-label'>Inicio</span>
					</a>
				)
			}
		</div>
	</div>
</header>

{
	variant === 'home' && (
		<div class='sh-menu' id='sh-menu' data-menu aria-hidden='true' inert data-lenis-prevent>
			<div class='sh-menu__panel'>
				<Leaf class='sh-menu__leaf' size={420} />
				<nav class='sh-menu__links' aria-label='Menú'>
					{links.map((l, i) => (
						<a href={l.href} style={`--i:${i}`}>
							<span class='sh-menu__n'>{String(i + 1).padStart(2, '0')}</span>
							<span class='sh-menu__t'>{l.label}</span>
							<Icon name='arrow' size={22} class='sh-menu__arrow' />
						</a>
					))}
				</nav>
				<div class='sh-menu__foot' style={`--i:${links.length}`}>
					<a class='btn sh-menu__cta' href={cartaHref}>
						Ver la carta completa
						<Icon name='arrow' size={18} />
					</a>
					<span class='sh-menu__open' data-open-status>
						<span class='open-dot'></span>
						<span data-open-text>Todos los días · 8:00–20:30</span>
					</span>
					<ul class='sh-menu__info'>
						<li><Icon name='pin' size={17} /><a href={info.mapsUrl} target='_blank' rel='noopener'>{info.address}, {info.city}</a></li>
						<li><Icon name='phone' size={17} /><a href={info.phoneHref}>{info.phone}</a></li>
						<li><Icon name='leaf' size={17} /><a href={info.instagram} target='_blank' rel='noopener'>{info.instagramHandle}</a></li>
					</ul>
				</div>
			</div>
		</div>
	)
}

<script>
	const root = document.documentElement;
	const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	if (btn && menu) {
		const set = (open: boolean) => {
			root.classList.toggle('menu-open', open);
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			menu.setAttribute('aria-hidden', String(!open));
			menu.toggleAttribute('inert', !open);
		};
		btn.addEventListener('click', () => set(!root.classList.contains('menu-open')));
		menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
		window.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
		window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && set(false));
	}
</script>

<style is:global>
	.sh-nav {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		padding: 12px var(--gutter);
		transition: transform 0.5s var(--ease);
		pointer-events: none;
	}
	.sh-nav.is-hidden { transform: translateY(-120%); }
	.sh-nav__inner {
		pointer-events: auto;
		max-width: var(--max);
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 8px 8px 8px 18px;
		border-radius: 999px;
		transition: background 0.4s, box-shadow 0.4s;
	}
	.sh-nav.is-scrolled .sh-nav__inner {
		background: rgba(250, 250, 245, 0.8);
		backdrop-filter: blur(14px) saturate(1.4);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		box-shadow: 0 0 0 1px var(--line), 0 10px 30px -15px rgba(15, 31, 23, 0.25);
	}
	.sh-nav .sh-nav__brand { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--leaf); --leaf-cut: var(--paper); }
	.sh-nav__leaf { height: 30px; width: auto; transition: transform 0.6s var(--ease); }
	.sh-nav .sh-nav__brand:hover .sh-nav__leaf { transform: rotate(-14deg); }
	.sh-nav__word { font: 800 26px/1 var(--f-display); letter-spacing: -0.04em; }
	.sh-nav__cafe {
		font: 600 10px/1 var(--f-body);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--ink-3);
		align-self: flex-end;
		margin-bottom: 4px;
	}
	.sh-nav__links { display: flex; gap: 4px; margin-left: auto; }
	.sh-nav__links a {
		padding: 10px 14px;
		border-radius: 999px;
		text-decoration: none;
		font: 600 14px/1 var(--f-body);
		transition: background 0.3s;
	}
	.sh-nav__links a:hover { background: rgba(15, 31, 23, 0.07); }
	.sh-nav__end { display: flex; align-items: center; gap: 8px; margin-left: auto; }
	.sh-nav__links + .sh-nav__end { margin-left: 0; }
	.sh-nav__cta { padding: 12px 20px; font-size: 14px; }
	/* Sobre foto: blanco hasta que se hace scroll */
	.sh-nav--light:not(.is-scrolled) .sh-nav__brand { color: #fff; --leaf-cut: rgba(10, 20, 14, 0.9); }
	.sh-nav--light:not(.is-scrolled) .sh-nav__cafe { color: rgba(255, 255, 255, 0.75); }
	.sh-nav--light:not(.is-scrolled) .sh-nav__links a { color: #fff; }
	.sh-nav--light:not(.is-scrolled) .sh-nav__links a:hover { background: rgba(255, 255, 255, 0.14); }
	.sh-nav--light:not(.is-scrolled) .sh-nav__cta { --bg: #fff; --fg: var(--ink); }
	.sh-nav--light:not(.is-scrolled) .sh-nav__cta::after { background: var(--matcha); }


	/* ---------- toggle + menú móvil ---------- */
	.sh-nav .sh-nav__toggle { display: none; }
	.sh-nav .sh-nav__toggle {
		position: relative;
		width: 46px;
		height: 46px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--ink);
		color: var(--paper);
		cursor: pointer;
		transition: background 0.35s var(--ease);
	}
	.sh-nav .sh-nav__toggle:hover { background: var(--leaf); }
	.sh-nav__bars { position: absolute; inset: 0; }
	.sh-nav__bars i {
		position: absolute;
		left: 14px;
		right: 14px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.5s var(--ease), top 0.5s var(--ease), left 0.4s;
	}
	.sh-nav__bars i:nth-child(1) { top: 18px; }
	.sh-nav__bars i:nth-child(2) { top: 26px; left: 19px; }
	.menu-open .sh-nav .sh-nav__toggle { background: var(--matcha); color: var(--ink); }
	.menu-open .sh-nav__bars i:nth-child(1) { top: 22px; transform: rotate(45deg); }
	.menu-open .sh-nav__bars i:nth-child(2) { top: 22px; left: 14px; transform: rotate(-45deg); }

	.sh-menu {
		position: fixed;
		inset: 0;
		z-index: 99;
		visibility: hidden;
		pointer-events: none;
		transition: visibility 0s 0.75s;
	}
	.menu-open .sh-menu { visibility: visible; pointer-events: auto; transition-delay: 0s; }
	.menu-open, .menu-open body { overflow: hidden; }
	.sh-menu__panel {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 96px var(--gutter) 28px;
		overflow-y: auto;
		background:
			radial-gradient(70% 45% at 100% 0%, rgba(200, 230, 160, 0.7), transparent 70%),
			radial-gradient(60% 40% at 0% 100%, rgba(255, 178, 63, 0.2), transparent 70%),
			var(--paper);
		clip-path: circle(0px at calc(100% - 46px) 40px);
		transition: clip-path 0.75s var(--ease);
	}
	.menu-open .sh-menu__panel { clip-path: circle(150vmax at calc(100% - 46px) 40px); }
	.sh-menu__leaf { position: absolute; right: -90px; bottom: 120px; width: 340px; height: auto; color: var(--matcha); --leaf-cut: var(--paper); opacity: 0.55; transform: rotate(18deg); pointer-events: none; }
	.sh-menu__links { position: relative; display: flex; flex-direction: column; margin: 8px 0 auto; }
	.sh-menu__links a {
		display: flex;
		align-items: baseline;
		gap: 14px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
		opacity: 0;
		transform: translateY(26px);
		transition: opacity 0.4s, transform 0.4s var(--ease);
	}
	.menu-open .sh-menu__links a { opacity: 1; transform: none; transition: opacity 0.7s calc(0.25s + var(--i) * 0.07s), transform 0.8s var(--ease) calc(0.25s + var(--i) * 0.07s); }
	.sh-menu__n { font: 600 12px/1 var(--f-body); letter-spacing: 0.1em; color: var(--leaf); }
	.sh-menu__t { flex: 1; font: 700 clamp(38px, 11vw, 56px) / 1 var(--f-display); letter-spacing: -0.04em; }
	.sh-menu__links a:hover .sh-menu__t, .sh-menu__links a:active .sh-menu__t { color: var(--leaf); }
	.sh-menu__arrow { align-self: center; color: var(--leaf); transform: rotate(-45deg); }
	.sh-menu__foot {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 28px;
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.3s, transform 0.3s;
	}
	.menu-open .sh-menu__foot { opacity: 1; transform: none; transition: opacity 0.7s calc(0.3s + var(--i) * 0.07s), transform 0.8s var(--ease) calc(0.3s + var(--i) * 0.07s); }
	.sh-menu .sh-menu__cta { justify-content: center; width: 100%; padding: 18px 24px; font-size: 16px; --bg: var(--leaf); --fg: #fff; }
	.sh-menu .sh-menu__cta::after { background: var(--ink); }
	.sh-menu__open { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
	.sh-menu__info { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 14px; }
	.sh-menu__info li { display: flex; align-items: center; gap: 10px; color: var(--ink-2); }
	.sh-menu__info svg { color: var(--leaf); flex: none; }
	.sh-menu__info a { color: inherit; text-decoration: none; }
	.menu-open .sh-nav .sh-nav__inner { background: transparent; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
	.menu-open .sh-nav.is-hidden { transform: none; }

	@media (max-width: 860px) {
		.sh-nav__inner { justify-content: space-between; padding-left: 14px; }
		.sh-nav__inner > .sh-nav__end { margin-left: auto; }
		.sh-nav__inner > .sh-nav__brand { margin-right: auto; }
		.sh-nav__links { display: none; }
		.sh-nav .sh-nav__cta--desk { display: none; }
		.sh-nav .sh-nav__toggle { display: block; }
		.sh-nav__cafe { display: none; }
	}
	@media (max-width: 420px) {
		.sh-nav__back-label { display: none; }
		.sh-nav__inner { gap: 10px; }
	}
</style>
