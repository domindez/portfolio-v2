---
import Leaf from './Leaf.astro';
import { info } from '../data/info';
interface Props {
	homeHref: string;
	cartaHref: string;
}
const { homeHref, cartaHref } = Astro.props as Props;
---

<footer class='sh-foot'>
	<div class='wrap'>
		<div class='sh-foot__top'>
			<p class='sh-foot__claim'>Come sano,<br /><span class='serif-i'>vive feliz.</span></p>
			<div class='sh-foot__cols'>
				<div>
					<h4>Visítanos</h4>
					<p>{info.address}<br />{info.postalCode} {info.city}</p>
				</div>
				<div>
					<h4>Horario</h4>
					<p>Todos los días<br />8:00 – 20:30</p>
				</div>
				<div>
					<h4>Contacto</h4>
					<p>
						<a href={info.phoneHref}>{info.phone}</a><br />
						<a href={info.instagram} target='_blank' rel='noopener'>Instagram</a> ·
						<a href={info.facebook} target='_blank' rel='noopener'>Facebook</a>
					</p>
				</div>
				<div>
					<h4>Explora</h4>
					<p><a href={homeHref}>Inicio</a><br /><a href={cartaHref}>Carta</a></p>
				</div>
			</div>
		</div>
		<div class='sh-foot__mark' aria-hidden='true'>
			<span>shanao</span>
			<Leaf class='sh-foot__leaf' size='1em' />
		</div>
		<div class='sh-foot__bottom'>
			<span>© {new Date().getFullYear()} Shanao Café · Málaga</span>
			<span>Web diseñada por <a href='https://domindez.com' target='_blank' rel='noopener'>Domindez Studio</a></span>
		</div>
	</div>
</footer>

<style is:global>
	.sh-foot { background: var(--ink); color: var(--paper); padding: clamp(60px, 8vw, 100px) 0 90px; overflow: hidden; --leaf-cut: var(--ink); }
	.sh-foot a { color: inherit; text-decoration: none; border-bottom: 1px solid rgba(250, 250, 245, 0.25); }
	.sh-foot a:hover { border-color: var(--matcha); color: var(--matcha); }
	.sh-foot__top { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; }
	.sh-foot .sh-foot__claim { font: 700 clamp(40px, 5vw, 72px) / 0.95 var(--f-display); letter-spacing: -0.035em; margin: 0; }
	.sh-foot__claim .serif-i { color: var(--matcha); }
	.sh-foot__cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
	.sh-foot h4 { font: 700 12px/1 var(--f-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--matcha); margin: 0 0 12px; }
	.sh-foot p { margin: 0; color: rgba(250, 250, 245, 0.8); font-size: 15px; line-height: 1.7; }
	.sh-foot__mark {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.05em;
		font: 800 clamp(90px, 22vw, 360px) / 0.8 var(--f-display);
		letter-spacing: -0.06em;
		color: var(--leaf-2);
		margin: clamp(48px, 8vw, 100px) 0 32px;
	}
	.sh-foot .sh-foot__leaf { height: clamp(70px, 17vw, 280px); width: auto; color: var(--leaf-2); flex: none; }
	.sh-foot__bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; color: rgba(250, 250, 245, 0.55); }
	@media (max-width: 900px) {
		.sh-foot__top { grid-template-columns: 1fr; }
		.sh-foot__cols { grid-template-columns: 1fr 1fr; }
	}
</style>
