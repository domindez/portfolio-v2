---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/inter/wght.css';
import './shanao.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DemoLayout from '../../layouts/DemoLayout.astro';
import Leaf from './components/Leaf.astro';
import Icon from './components/Icon.astro';
import Footer from './components/Footer.astro';
import T from './components/T.astro';
import { menu, formatPrice, type Tag } from './data/menu';

const base = '/shanao';
const carta = `${base}/carta`;

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/demos/shanao/seccion-*.jpg', { eager: true });
const img = (name?: string) => (name ? images[`../../assets/demos/shanao/${name}.jpg`]?.default : undefined);

// Foto de cada pan: el nombre del pan → panes/<slug>.jpg
const breadFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/demos/shanao/panes/*.jpg', { eager: true });
const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+de\s+/g, '-').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const breadImg = (name: string) => breadFiles[`../../assets/demos/shanao/panes/${slug(name)}.jpg`]?.default;
// Estas tres son fotos reales (no recortes sobre blanco): van a sangre en la tarjeta
const photoBreads = ['Sándwich multicereal XL', 'Bagel semillado', 'Mini crepe de sarraceno'];

const tagLabel: Record<Tag, { es: string; en: string }> = {
	vegan: { es: 'Vegano', en: 'Vegan' },
	gf: { es: 'Sin gluten', en: 'Gluten-free' },
	new: { es: 'Nuevo', en: 'New' },
	fav: { es: 'Favorito', en: 'Favourite' },
};
---

<DemoLayout
	title='Carta · Shanao Café · Málaga'
	description='Carta de Shanao Café: bocadillos, tostas, bowls, crepes, ensaladas, café de especialidad, zumos y batidos. Opciones veganas y sin gluten.'
	themeColor='#FAFAF5'
	favicon='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 120%22%3E%3Cpath d=%22M50 2C27 22 8 50 8 74c0 22 19 36 42 36s42-14 42-36C92 50 73 22 50 2Z%22 fill=%22%231F7A4D%22/%3E%3C/svg%3E'
	bodyClass='sh sh-carta'
>
	<script is:inline slot='head'>
		try {
			var l = localStorage.getItem('shanao-lang');
			if (!l) l = (navigator.language || 'es').slice(0, 2) === 'es' ? 'es' : 'en';
			document.documentElement.dataset.lang = l;
		} catch (e) {}
	</script>

	<header class='c-top' data-ctop>
		<div class='c-top__row wrap'>
			<a href={base} class='c-brand' aria-label='Shanao Café, inicio'>
				<Leaf size={26} class='c-brand__leaf' />
				<span class='c-brand__word'>shanao</span>
				<span class='c-brand__sub'><T es='Carta' en='Menu' /></span>
			</a>
			<div class='c-top__actions'>
				<div class='lang' role='group' aria-label='Idioma / Language'>
					<button type='button' data-set-lang='es' aria-label='Español'>ES</button>
					<button type='button' data-set-lang='en' aria-label='English'>EN</button>
				</div>
				<a class='c-iconbtn c-back' href={base} aria-label='Volver al inicio'>
					<Icon name='arrow' size={20} class='c-back__icon' />
					<span class='c-back__label'><T es='Inicio' en='Home' /></span>
				</a>
			</div>
		</div>

		<nav class='cats' aria-label='Categorías'>
			<div class='cats__track'>
				{menu.map((s) => (
					<a href={`#${s.id}`} data-cat={s.id} style={`--c:${s.color};--ci:${s.ink}`}>
						<T es={s.title} en={s.titleEn} />
					</a>
				))}
			</div>
		</nav>
	</header>

	<main>
		<h1 class='sr-only'><T es='Carta de Shanao Café' en='Shanao Café menu' /></h1>

		<!-- ======= SECTIONS ======= -->
		{menu.map((s) => {
			const hero = img(s.image);
			return (
				<section class='m-sec' id={s.id} data-section style={`--c:${s.color};--ci:${s.ink}`}>
					<header class='m-sec__head'>
						<div class='wrap'><div class='m-sec__head-inner'>
							<div>
								<h2 class='display m-sec__title'><T es={s.title} en={s.titleEn} /></h2>
								{s.story && <p class='m-sec__story serif-i'><T es={s.story} en={s.storyEn} /></p>}
							</div>
							{hero && (
								<div class='m-sec__img'>
									<Image src={hero} alt='' widths={[320, 560]} sizes='(max-width: 700px) 40vw, 280px' />
								</div>
							)}
						</div></div>
					</header>

					<div class='wrap m-sec__body'>
						{s.groups.map((g) => {
							// --- Panes: una tarjeta con foto para cada uno ---
							if (g.id === 'panes') {
								return (
									<div class='group'>
										<div class='group__head'>
											<h3 class='group__title'><T es='Monta tu bocadillo' en='Build your sandwich' /></h3>
											<p class='group__note'><T es='Elige el pan y luego la combinación o los ingredientes que quieras.' en='Pick your bread, then a combo or the fillings you like.' /></p>
										</div>
										<p class='builder__step'><T es='1 · Elige tu pan' en='1 · Pick your bread' /></p>
										<ul class='breads'>
											{g.items.map((it) => {
												const pic = breadImg(it.name);
												return (
													<li class='bread'>
														<span class:list={['bread__media', { 'bread__media--photo': photoBreads.includes(it.name) }]}>
															{pic && <Image class='bread__img' src={pic} alt={it.name} width={360} />}
														</span>
														<span class='bread__name'><T es={it.name} en={it.nameEn} /></span>
														{it.desc && <span class='bread__desc'><T es={it.desc} en={it.descEn} /></span>}
														<span class='bread__foot'>
															<span class='bread__price'><T es={formatPrice(it.price)} en={formatPrice(it.price, 'en')} /></span>
															{it.tags?.filter((t) => t === 'vegan' || t === 'gf').map((t) => (
																<span class={`tag tag--${t}`}><T es={tagLabel[t].es} en={tagLabel[t].en} /></span>
															))}
														</span>
													</li>
												);
											})}
										</ul>
									</div>
								);
							}
							// --- Ingredientes sueltos (monta el tuyo / plato inglés) ---
							if (g.builder) {
								return (
									<div class='group'>
										<div class='group__head'>
											<h3 class='group__title'><T es={g.title} en={g.titleEn} /></h3>
											{g.note && <p class='group__note'><T es={g.note} en={g.noteEn} /></p>}
										</div>
										{s.id === 'bocadillos' && g.id === 'monta' && <p class='builder__step'><T es='2 · Añade ingredientes' en='2 · Add fillings' /></p>}
										<ul class='chips'>
											{g.items.map((it) => (
												<li class='chip'>
													<span class='chip__name'><T es={it.name} en={it.nameEn} /></span>
													<span class='chip__price'>+{formatPrice(it.price).replace(' €', '')}</span>
													{it.tags?.includes('vegan') && <span class='chip__mark' title='Vegano'><Icon name='leaf' size={14} /></span>}
												</li>
											))}
										</ul>
									</div>
								);
							}
							return (
								<div class='group'>
									<div class='group__head'>
										<h3 class='group__title'>
											<T es={g.title} en={g.titleEn} />
											{g.price && <span class='group__price'>{g.price} €</span>}
										</h3>
										{g.note && <p class='group__note'><T es={g.note} en={g.noteEn} /></p>}
									</div>

									{g.rows && g.columns && (
										<div class='ptable'>
											<div class='ptable__row ptable__row--head'>
												<span></span>
												{g.columns.map((c) => <span>{c}</span>)}
											</div>
											{g.rows.map((r) => (
												<div class='ptable__row'>
													<span class='ptable__name'><T es={r.name} en={r.nameEn} /></span>
													{r.prices.map((p) => <span>{formatPrice(p).replace(' €', '')}</span>)}
												</div>
											))}
										</div>
									)}

									{g.items.length > 0 && (
										<ul class='items'>
											{g.items.map((it) => (
												<li class='item'>
													<div class='item__head'>
														<h4 class='item__name'><T es={it.name} en={it.nameEn} /></h4>
														<span class='item__dots' aria-hidden='true'></span>
														{it.price !== undefined && (
															<span class='item__price'>
																<T es={formatPrice(it.price)} en={formatPrice(it.price, 'en')} />
															</span>
														)}
													</div>
													{it.desc && <p class='item__desc'><T es={it.desc} en={it.descEn} /></p>}
													{it.tags && it.tags.length > 0 && (
														<div class='item__tags'>
															{it.tags.map((t) => <span class={`tag tag--${t}`}><T es={tagLabel[t].es} en={tagLabel[t].en} /></span>)}
														</div>
													)}
												</li>
											))}
										</ul>
									)}
								</div>
							);
						})}
					</div>
				</section>
			);
		})}

		<section class='c-note wrap'>
			<p>
				<T
					es='¿Alergias o intolerancias? Pregúntanos y te contamos los alérgenos de cada plato. Precios con IVA incluido.'
					en='Allergies or intolerances? Ask us about the allergens in each dish. Prices include VAT.'
				/>
			</p>
		</section>
	</main>

	<Footer cartaHref={carta} homeHref={base} />
</DemoLayout>

<style is:global>
	.sh-carta .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

	/* ===== cabecera fija: marca + navegación de secciones ===== */
	.sh-carta .c-top {
		position: sticky;
		top: 0;
		z-index: 60;
		background: rgba(250, 250, 245, 0.9);
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		border-bottom: 1px solid var(--line);
	}
	.sh-carta .c-top__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 64px; }
	.sh-carta .c-brand { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--leaf); --leaf-cut: var(--paper); }
	.sh-carta .c-brand__leaf { height: 26px; width: auto; }
	.sh-carta .c-brand__word { font: 800 24px/1 var(--f-display); letter-spacing: -0.04em; }
	.sh-carta .c-brand__sub {
		margin-left: 4px;
		padding: 5px 9px;
		border-radius: 999px;
		background: var(--matcha);
		color: #164d2f;
		font: 700 11px/1 var(--f-body);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.sh-carta .c-top__actions { display: flex; align-items: center; gap: 8px; }
	.sh-carta .c-iconbtn {
		height: 40px;
		min-width: 40px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 0 10px;
		border: 0;
		border-radius: 999px;
		background: #fff;
		box-shadow: inset 0 0 0 1.5px var(--line);
		color: var(--ink);
		text-decoration: none;
		font: 600 14px/1 var(--f-body);
		cursor: pointer;
		transition: background 0.25s, color 0.25s;
	}
	.sh-carta .c-iconbtn:hover,
	.sh-carta .c-iconbtn[aria-expanded='true'] { background: var(--ink); color: var(--paper); box-shadow: none; }
	.sh-carta .c-back { padding: 0 14px 0 12px; }
	.sh-carta .c-back__icon { transform: rotate(180deg); }

	.sh-carta .lang { display: flex; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); background: #fff; }
	.sh-carta .lang button { border: 0; background: none; padding: 9px 11px; border-radius: 999px; font: 700 12px/1 var(--f-body); cursor: pointer; color: var(--ink-3); }
	html:not([data-lang='en']) .sh-carta .lang [data-set-lang='es'],
	html[data-lang='en'] .sh-carta .lang [data-set-lang='en'] { background: var(--ink); color: var(--paper); }

	/* navegación de secciones */
	.sh-carta .cats { padding: 0 0 12px; }
	.sh-carta .cats__track {
		display: flex;
		gap: 6px;
		overflow-x: auto;
		scrollbar-width: none;
		padding-inline: var(--gutter);
		max-width: var(--max);
		margin: 0 auto;
	}
	.sh-carta .cats__track::-webkit-scrollbar { display: none; }
	.sh-carta .cats a {
		flex: none;
		padding: 10px 16px;
		border-radius: 999px;
		text-decoration: none;
		font: 600 14px/1 var(--f-body);
		white-space: nowrap;
		box-shadow: inset 0 0 0 1.5px var(--line);
		transition: background 0.3s, color 0.3s, box-shadow 0.3s;
	}
	.sh-carta .cats a:hover { box-shadow: inset 0 0 0 1.5px var(--ink); }
	.sh-carta .cats a.is-active { background: var(--c); color: var(--ci); box-shadow: none; }
	.sh-carta .cats a.is-empty { opacity: 0.35; }

	.sh-carta .empty { text-align: center; font-size: 18px; padding: 80px var(--gutter); color: var(--ink-3); }

	/* ===== secciones ===== */
	.sh-carta main { padding-top: 8px; }
	.sh-carta .m-sec { padding: 24px 0 24px; scroll-margin-top: 130px; }
	.sh-carta .m-sec[hidden] { display: none; }
	.sh-carta .m-sec__head-inner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		background: var(--c);
		color: var(--ci);
		border-radius: var(--r-lg);
		padding: clamp(24px, 4vw, 48px);
		overflow: hidden;
		min-height: 200px;
	}
	.sh-carta .m-sec__title { font-size: clamp(44px, 7vw, 110px); }
	.sh-carta .m-sec__story { margin: 12px 0 0; font-size: clamp(18px, 1.8vw, 26px); max-width: 30ch; opacity: 0.9; }
	.sh-carta .m-sec__img {
		flex: none;
		width: clamp(130px, 22vw, 280px);
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		margin: -10px -10px -10px 0;
		box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5);
		transform: rotate(-6deg);
	}
	.sh-carta .m-sec__img img { width: 100%; height: 100%; object-fit: cover; }
	.sh-carta .m-sec__body { padding-top: 12px; }

	/* grupos */
	.sh-carta .group { padding: 32px 0 8px; }
	.sh-carta .group[hidden] { display: none; }
	.sh-carta .group__head { margin-bottom: 18px; }
	.sh-carta .group__title {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		font: 700 clamp(26px, 2.6vw, 38px) / 1.05 var(--f-display);
		letter-spacing: -0.03em;
		margin: 0;
	}
	.sh-carta .group__price { padding: 6px 12px; border-radius: 999px; background: var(--ink); color: var(--paper); font: 700 15px/1 var(--f-body); letter-spacing: 0; }
	.sh-carta .group__note { margin: 8px 0 0; color: var(--ink-3); font-size: 15px; max-width: 70ch; }

	/* platos: sin líneas, solo aire */
	.sh-carta .items { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 26px 56px; }
	.sh-carta .item[hidden] { display: none; }
	.sh-carta .item__head { display: flex; align-items: baseline; gap: 10px; }
	.sh-carta .item__name { margin: 0; font: 700 19px/1.2 var(--f-display); letter-spacing: -0.01em; }
	.sh-carta .item__dots { flex: 1; border-bottom: 2px dotted rgba(15, 31, 23, 0.18); transform: translateY(-4px); min-width: 16px; }
	.sh-carta .item__price { font: 700 17px/1 var(--f-body); white-space: nowrap; font-variant-numeric: tabular-nums; }
	.sh-carta .item__desc { margin: 6px 0 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.5; max-width: 52ch; }
	.sh-carta .item__tags { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }

	/* tabla de precios */
	.sh-carta .ptable { border-radius: var(--r-md); background: #fff; box-shadow: 0 0 0 1px var(--line); overflow: hidden; max-width: 640px; }
	.sh-carta .ptable__row { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); padding: 14px 20px; font-variant-numeric: tabular-nums; }
	.sh-carta .ptable__row:nth-child(odd):not(.ptable__row--head) { background: var(--paper); }
	.sh-carta .ptable__row span:not(:first-child) { text-align: right; }
	.sh-carta .ptable__row--head { background: var(--ink); color: var(--paper); font: 700 12px/1 var(--f-body); letter-spacing: 0.1em; text-transform: uppercase; }
	.sh-carta .ptable__name { font-weight: 700; }

	/* ===== panes (mismo aspecto que antes, ahora solo informativo) ===== */
	.sh-carta .builder__step { font: 700 13px/1 var(--f-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--leaf); margin: 4px 0 14px; }
	.sh-carta .breads { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
	.sh-carta .bread { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; border-radius: var(--r-md); background: #fff; box-shadow: 0 0 0 1.5px var(--line); }
	.sh-carta .bread__media { display: block; height: 96px; margin-bottom: 8px; border-radius: 12px; overflow: hidden; }
	.sh-carta .bread__img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
	.sh-carta .bread__media--photo .bread__img { object-fit: cover; mix-blend-mode: normal; }
	.sh-carta .bread__name { font: 700 17px/1.2 var(--f-display); }
	.sh-carta .bread__desc { font-size: 13px; color: var(--ink-3); line-height: 1.35; }
	.sh-carta .bread__foot { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 8px; }
	.sh-carta .bread__price { font: 700 15px/1 var(--f-body); }

	/* ===== ingredientes (mismo aspecto que antes, ahora solo informativo) ===== */
	.sh-carta .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
	.sh-carta .chip { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1.5px var(--line); font: 600 14px/1 var(--f-body); }
	.sh-carta .chip__price { color: var(--ink-3); font-weight: 600; font-variant-numeric: tabular-nums; }
	.sh-carta .chip__mark { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--matcha); color: #164d2f; }

	.sh-carta .c-note { padding-block: 40px 80px; color: var(--ink-3); font-size: 14px; text-align: center; }

	@media (max-width: 760px) {
		.sh-carta .c-top__row { height: 58px; }
		.sh-carta .c-back__label { display: none; }
		.sh-carta .c-back { padding: 0 10px; }
		.sh-carta .c-brand__word { font-size: 22px; }
		.sh-carta .items { grid-template-columns: 1fr; gap: 22px; }
		.sh-carta .m-sec { scroll-margin-top: 120px; }
		.sh-carta .m-sec__head-inner { min-height: 150px; }
		.sh-carta .m-sec__img { width: 110px; margin: -20px -30px -20px 0; }
		.sh-carta .breads { grid-template-columns: repeat(2, 1fr); gap: 8px; }
		.sh-carta .bread { padding: 10px; }
		.sh-carta .bread__media { height: 70px; }
		.sh-carta .bread__name { font-size: 14px; }
		.sh-carta .bread__desc { display: none; }
		.sh-carta .ptable__row { padding: 12px 14px; font-size: 14px; }
	}
	@media (max-width: 440px) {
		.sh-carta .c-brand__sub { display: none; }
		.sh-carta .c-top__actions { gap: 6px; }
	}
</style>

<script>
	import { initShanaoCommon } from './scripts/common';

	const lenis = initShanaoCommon();
	const root = document.documentElement;

	// ---------- idioma ----------
	const setLang = (l: 'es' | 'en') => {
		root.dataset.lang = l;
		root.lang = l;
		try {
			localStorage.setItem('shanao-lang', l);
		} catch {}
	};
	document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((b) =>
		b.addEventListener('click', () => setLang(b.dataset.setLang as 'es' | 'en')),
	);
	setLang(root.dataset.lang === 'en' ? 'en' : 'es');

	// ---------- navegación de secciones (resalta la sección visible) ----------
	const cats = document.querySelector<HTMLElement>('.cats__track');
	const links = new Map<string, HTMLElement>();
	document.querySelectorAll<HTMLElement>('[data-cat]').forEach((a) => links.set(a.dataset.cat!, a));
	const io = new IntersectionObserver(
		(entries) => {
			entries.forEach((e) => {
				if (!e.isIntersecting) return;
				links.forEach((l) => l.classList.remove('is-active'));
				const link = links.get(e.target.id);
				if (link && cats) {
					link.classList.add('is-active');
					cats.scrollTo({ left: link.offsetLeft - cats.clientWidth / 2 + link.clientWidth / 2, behavior: 'smooth' });
				}
			});
		},
		{ rootMargin: '-35% 0px -60% 0px' },
	);
	document.querySelectorAll<HTMLElement>('[data-section]').forEach((s) => io.observe(s));

	links.forEach((a) =>
		a.addEventListener('click', (e) => {
			const t = document.getElementById(a.dataset.cat!);
			if (!t) return;
			e.preventDefault();
			const offset = -((document.querySelector<HTMLElement>('[data-ctop]')?.offsetHeight ?? 120) + 8);
			if (lenis) lenis.scrollTo(t, { offset, duration: 1.2 });
			else t.scrollIntoView({ behavior: 'smooth' });
			history.replaceState(null, '', '#' + t.id);
		}),
	);
</script>
