---
/**
 * Texto bilingüe: pinta ES y EN y el CSS muestra el idioma activo.
 * Con `html`, el texto entre *asteriscos* se pinta en <em> (acento en cursiva).
 */
interface Props {
	es?: string;
	en?: string;
	html?: boolean;
}
const { es = '', en, html = false } = Astro.props as Props;
const same = !en || en === es;
const fmt = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

{
	html ? (
		same ? (
			<Fragment set:html={fmt(es)} />
		) : (
			<>
				<span data-es set:html={fmt(es)} />
				<span data-en set:html={fmt(en!)} />
			</>
		)
	) : same ? (
		es
	) : (
		<>
			<span data-es>{es}</span>
			<span data-en>{en}</span>
		</>
	)
}
