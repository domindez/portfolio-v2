---
/** Iconos de línea propios (24×24, stroke = currentColor). */
interface Props {
	name: 'arrow' | 'arrow-down' | 'pin' | 'clock' | 'phone' | 'insta' | 'star' | 'menu' | 'close' | 'leaf' | 'search' | 'mug' | 'screen' | 'sun' | 'globe' | 'chat' | 'calendar' | 'users' | 'minus' | 'plus';
	size?: number;
	class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props as Props;
---

<svg
	class={cls}
	width={size}
	height={size}
	viewBox='0 0 24 24'
	fill='none'
	stroke='currentColor'
	stroke-width='1.8'
	stroke-linecap='round'
	stroke-linejoin='round'
	aria-hidden='true'
>
	{name === 'arrow' && <path d='M5 12h14M13 6l6 6-6 6' />}
	{name === 'arrow-down' && <path d='M12 5v14M6 13l6 6 6-6' />}
	{name === 'pin' && (
		<>
			<path d='M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z' />
			<circle cx='12' cy='9.5' r='2.5' />
		</>
	)}
	{name === 'clock' && (
		<>
			<circle cx='12' cy='12' r='9' />
			<path d='M12 7v5l3 2' />
		</>
	)}
	{name === 'phone' && <path d='M5 4h3.5l1.6 4.2-2.2 1.5a11 11 0 0 0 6.4 6.4l1.5-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z' />}
	{name === 'insta' && (
		<>
			<rect x='3.5' y='3.5' width='17' height='17' rx='5' />
			<circle cx='12' cy='12' r='4' />
			<circle cx='17.2' cy='6.8' r='.6' fill='currentColor' />
		</>
	)}
	{name === 'star' && <path d='m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8L12 3.5Z' fill='currentColor' stroke='none' />}
	{name === 'menu' && <path d='M4 8h16M4 16h16' />}
	{name === 'close' && <path d='M6 6l12 12M18 6 6 18' />}
	{name === 'leaf' && (
		<>
			<path d='M20 4C10 4 4 9 4 15c0 2.8 2 5 5 5 6 0 11-6 11-16Z' />
			<path d='M4 20c4-6 8-9 12-11' />
		</>
	)}
	{name === 'search' && (
		<>
			<circle cx='11' cy='11' r='6.5' />
			<path d='m20 20-4.2-4.2' />
		</>
	)}
	{name === 'mug' && (
		<>
			<path d='M5 7h10v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7Z' />
			<path d='M15 9.5h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2' />
			<path d='M5 7c0-1.7 1.3-3 3-3 .6-1 1.6-1.5 2.7-1.2 1-.5 2.3-.2 3 .7C15 3.6 15.5 5.4 15 7' />
			<path d='M8.5 11v6M11.5 11v6' />
		</>
	)}
	{name === 'screen' && (
		<>
			<rect x='3' y='4.5' width='18' height='12' rx='1.5' />
			<path d='M8 20h8M12 16.5V20' />
		</>
	)}
	{name === 'sun' && (
		<>
			<circle cx='12' cy='12' r='4' />
			<path d='M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4' />
		</>
	)}
	{name === 'globe' && (
		<>
			<circle cx='12' cy='12' r='9' />
			<path d='M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z' />
		</>
	)}
	{name === 'chat' && <path d='M12 3.5a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.4-1.1A8.5 8.5 0 1 0 12 3.5Z' />}
	{name === 'calendar' && (
		<>
			<rect x='3.5' y='5' width='17' height='15' rx='1.5' />
			<path d='M3.5 10h17M8 3v4M16 3v4' />
		</>
	)}
	{name === 'users' && (
		<>
			<circle cx='9' cy='8.5' r='3.5' />
			<path d='M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5M16 5.2a3.5 3.5 0 0 1 0 6.6M18.2 14.8c1.8.7 3 2.4 3.3 5.2' />
		</>
	)}
	{name === 'minus' && <path d='M6 12h12' />}
	{name === 'plus' && <path d='M6 12h12M12 6v12' />}
</svg>
