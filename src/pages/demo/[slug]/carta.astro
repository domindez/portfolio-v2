---
import { demos } from '../../../demos';

export function getStaticPaths() {
	return Object.entries(demos)
		.filter(([, demo]) => demo.Carta)
		.map(([slug]) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const { Carta } = demos[slug as string];
const Component = Carta!;
---

<Component />
