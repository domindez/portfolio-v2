---
import { demos } from '../../../../demos';

export function getStaticPaths() {
	return Object.entries(demos).flatMap(([slug, demo]) => (demo.Cartas ? demo.Cartas.ids.map((sala) => ({ params: { slug, sala } })) : []));
}

const { slug, sala } = Astro.params;
const { Page } = demos[slug as string].Cartas!;
---

<Page sala={sala} />
