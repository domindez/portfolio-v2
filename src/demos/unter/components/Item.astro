---
/** Fila de carta: nombre · línea de puntos · precio, y detalle debajo. */
import T from './T.astro';
import type { Dish } from '../data/menu';
import { euro } from '../data/beers';

interface Props {
	dish: Dish;
}
const { dish: d } = Astro.props;
---

<li class={`ct-item${d.star ? ' is-star' : ''}`} data-rv>
	<p class='ct-item__row'>
		<span class='ct-item__name'>
			<T es={d.name.es} en={d.name.en} />
			{d.star && <span class='ct-tag ct-tag--house'>✦ <T es='De la casa' en='House' /></span>}
			{d.vegan && <span class='ct-tag ct-tag--veg'><T es='Vegano*' en='Vegan*' /></span>}
		</span>
		<span class='ct-item__dots' aria-hidden='true'></span>
		<span class='ct-item__price'>{euro(d.price)}</span>
	</p>
	{d.desc && <p class='ct-item__desc'><T es={d.desc.es} en={d.desc.en} /></p>}
</li>
