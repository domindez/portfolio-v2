---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/big-shoulders-display';
import './unter.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import T from './components/T.astro';
import Icon from './components/Icon.astro';
import { info, timeline, fiestas, leagues, praise, toasts } from './data/info';
import { taps, tapSizes, bottleCountries, bottles, totalBeers, euro, countryByCode, sampler } from './data/beers';
import { platos, picar } from './data/menu';

import imgMedallon from '../../assets/demos/unter/medallon.png';
import imgBarra from '../../assets/demos/unter/barra.jpg';
import imgCarteles from '../../assets/demos/unter/pared-carteles.jpg';
import imgGrifoAzul from '../../assets/demos/unter/grifo-azul.jpg';
import imgTerrazaPretzel from '../../assets/demos/unter/terraza-pretzel.jpg';
import imgBotaPlaya from '../../assets/demos/unter/bota-playa.jpg';
import imgTerrazaTabla from '../../assets/demos/unter/terraza-tabla.jpg';
import imgTerrazaPretzels from '../../assets/demos/unter/terraza-pretzels.jpg';
import imgBotellasTerraza from '../../assets/demos/unter/botellas-terraza.jpg';
import imgSampler from '../../assets/demos/unter/sampler.jpg';
import imgBretzel from '../../assets/demos/unter/bretzel.jpg';
import imgPlato from '../../assets/demos/unter/plato.jpg';
import imgHamburguesa from '../../assets/demos/unter/hamburguesa.jpg';
import imgOktoberfest from '../../assets/demos/unter/oktoberfest.jpg';
import imgNeveras from '../../assets/demos/unter/neveras.jpg';
import imgDelirium from '../../assets/demos/unter/delirium.jpg';
import imgMesaLarga from '../../assets/demos/unter/mesa-larga.jpg';

const base = '/demo/unter';
const carta = `${base}/carta`;
const tel = `tel:+34${info.phone.replace(/\s/g, '')}`;

const nav = [
	{ href: '#grifos', es: 'Grifos', en: 'Taps' },
	{ href: '#mundo', es: 'Cervezas', en: 'Beers' },
	{ href: '#cocina', es: 'Cocina', en: 'Kitchen' },
	{ href: '#terraza', es: 'Terraza', en: 'Terrace' },
	{ href: '#agenda', es: 'Agenda', en: 'Events' },
	{ href: '#reserva', es: 'Reservar', en: 'Book' },
	{ href: '#visita', es: 'Visítanos', en: 'Visit' },
];

const world = bottleCountries.map((c) => {
	const list = bottles.filter((b) => b.country === c.code);
	const top = [...list].sort((a, b) => b.price - a.price).slice(0, 3).map((b) => b.name);
	return { ...c, top };
});

const findDish = (name: string) => [...platos.dishes, ...picar.dishes, ...(picar.extra?.dishes ?? [])].find((d) => d.name.es === name)!;
const kitchen = [
	{ img: imgPlato, dish: findDish('Codillo de cerdo'), alt: 'Codillo de cerdo con salsa de cerveza y patatas, con una caña al lado' },
	{ img: imgBretzel, dish: findDish('Bretzel con mantequilla'), alt: 'Bretzel, salchichas y queso con mermelada sobre la mesa' },
	{ img: imgHamburguesa, dish: findDish('Hamburguesa'), alt: 'Hamburguesa con patatas horneadas y una copa de Tripel Karmeliet' },
	{ img: imgTerrazaTabla, dish: findDish('Variedad de fiambres y quesos'), alt: 'Tabla de quesos e ibéricos en la terraza con una Brugse Zot' },
];

const terrace = [
	{ img: imgTerrazaPretzel, alt: 'Paulaner y bretzel en la terraza con el paseo marítimo y las palmeras detrás', es: 'Paulaner y bretzel', en: 'Paulaner & pretzel' },
	{ img: imgBotaPlaya, alt: 'Una bota de cerveza en alto con la playa de La Malagueta detrás', es: 'Bota con vistas', en: 'Boot with a view' },
	{ img: imgTerrazaPretzels, alt: 'Dos jarras de Paulaner y bretzels en la terraza', es: 'Bretzel y Weissbier', en: 'Pretzels & Weissbier' },
	{ img: imgSampler, alt: 'Tabla de degustación de cinco Chouffe en la terraza', es: 'Sample Chouffe', en: 'Chouffe sampler' },
	{ img: imgBotellasTerraza, alt: 'Botellas de cerveza de varios países en una mesa de la terraza', es: 'Medio mundo en una mesa', en: 'Half the world on one table' },
];

const eventImgs: Record<string, { img: ImageMetadata; alt: string }> = {
	okto: { img: imgOktoberfest, alt: 'Amigos brindando durante el Oktoberfest en la cervecería' },
	deli: { img: imgDelirium, alt: 'Delirium servida en su copa' },
	chouffe: { img: imgSampler, alt: 'Tabla de degustación de Chouffe en la terraza' },
	futbol: { img: imgMesaLarga, alt: 'Mesa larga de amigos celebrando con cervezas' },
	patrick: { img: imgCarteles, alt: 'Pared de carteles de cerveza del local' },
};
const tapNames = ['Paulaner', 'Weihenstephaner', 'Chouffe', 'Delirium Tremens', 'Gulden Draak', 'Pilsner Urquell', 'Guinness', 'Duvel', 'Brugse Zot', 'Schlenkerla', 'Staropramen', 'Brewdog'];
const slots = (from: number, to: number) => {
	const out: string[] = [];
	for (let m = from; m <= to; m += 30) out.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
	return out;
};
const slotGroups = [
	{ es: 'Mediodía', en: 'Lunch', times: slots(13 * 60, 15 * 60 + 30) },
	{ es: 'Tarde', en: 'Afternoon', times: slots(17 * 60, 19 * 60 + 30) },
	{ es: 'Noche', en: 'Evening', times: slots(20 * 60 + 30, 23 * 60) },
];
const whatsapp = `34${info.phone.replace(/\s/g, '')}`;

const stampText = 'Cervecería alemana · Seit 2004 · Buenos Aires · Málaga · ';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	name: info.name,
	servesCuisine: ['Alemana', 'Tapas'],
	telephone: `+34 ${info.phone}`,
	address: { '@type': 'PostalAddress', streetAddress: info.address, addressLocality: 'Málaga', postalCode: '29016', addressCountry: 'ES' },
	openingHours: 'Mo-Su 12:00-00:30',
	aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.6', reviewCount: info.reviews },
	sameAs: [info.instagram],
};
const first = taps[1];
const tapCountries = new Set(taps.map((t) => t.country)).size;
---

<DemoLayout
	title='Cervecería Untertürkheim · Cervecería alemana frente al mar en Málaga'
	description='Más de 200 cervezas, 20 grifos y cocina alemana en el Paseo Marítimo de La Malagueta. Terraza frente al mar, fútbol y fiestas cerveceras.'
	themeColor='#0f2a1c'
	ogImage='/demo-og/unter.jpg'
	ogImageAlt='Cervecería Untertürkheim: cervecería alemana frente al mar en Málaga.'
	siteName='Cervecería Untertürkheim'
	bodyClass='ut'
>
	<script slot='head' type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
	<script slot='head' is:inline>
		(function () {
			var r = document.documentElement;
			r.classList.add('ut-js');
			var l = null;
			try { l = localStorage.getItem('unter-lang'); } catch (e) {}
			if (!l) l = (navigator.language || 'es').slice(0, 2) === 'es' ? 'es' : 'en';
			r.dataset.lang = l;
			r.lang = l;
		})();
	</script>

	<a class='ut-skip' href='#casa'>Saltar al contenido</a>

	<!-- ============ NAV ============ -->
	<header class='nav' data-nav>
		<a class='nav__brand' href='#top' aria-label='Cervecería Untertürkheim, inicio'>
			<Image src={imgMedallon} alt='' width={128} height={128} class='nav__logo' loading='eager' />
			<span class='nav__id'>
				<span class='nav__name'>Untertürkheim</span>
			</span>
		</a>
		<nav class='nav__links' aria-label='Secciones'>
			{nav.map((l) => <a href={l.href}><T es={l.es} en={l.en} /></a>)}
		</nav>
		<div class='nav__right'>
			<div class='lang' role='group' aria-label='Idioma / Language'>
				<button type='button' data-set-lang='es'>ES</button>
				<button type='button' data-set-lang='en'>EN</button>
			</div>
			<a class='btn btn--gold nav__cta' href={carta}><T es='La carta' en='Menu' /></a>
			<button class='nav__burger' type='button' aria-label='Abrir menú' aria-expanded='false' data-menu-open>
				<Icon name='menu' />
			</button>
		</div>
	</header>

	<div class='menu' data-menu aria-hidden='true'>
		<div class='menu__head'>
			<Image src={imgMedallon} alt='' width={96} height={96} class='menu__logo' />
			<span class='menu__id'>
				<span class='menu__name'>Untertürkheim</span>
				<span class='menu__tag'><T es='Cervecería alemana' en='German beer hall' /></span>
			</span>
		</div>
		<button class='menu__close' type='button' aria-label='Cerrar menú' data-menu-close><Icon name='close' size={26} /></button>
		<nav class='menu__links' aria-label='Menú'>
			{nav.map((l, i) => <a href={l.href} style={`--i:${i}`}><span class='menu__n'>{String(i + 1).padStart(2, '0')}</span><T es={l.es} en={l.en} /></a>)}
			<a href={carta} style={`--i:${nav.length}`}><span class='menu__n'>—</span><T es='La carta' en='The menu' /></a>
		</nav>
		<p class='menu__foot'>{info.address} · {info.area}</p>
	</div>

	<main id='top'>
		<!-- ============ HERO ============ -->
		<section class='hero' data-hero>
			<div class='hero__stage wrap'>
				<p class='hero__kicker' data-in>
					<span>Cervecería Untertürkheim</span>
					<span class='hero__dot' aria-hidden='true'>·</span>
					<span>La Malagueta, Málaga</span>
				</p>

				<h1 class='hero__title'>
					<span class='sr-only'>Cervecería Untertürkheim: </span>
					<span class='hero__line hero__line--sign'><span data-line><T es='Cervecería' en='German' /></span></span>
					<span class='hero__line hero__line--sign'><span data-line><T es='alemana' en='beer hall' /></span></span>
					<span class='hero__line hero__line--script'>
						<span data-line><T es='frente al mar' en='by the sea' /></span>
					</span>
				</h1>

				<p class='hero__lead' data-in>
					<T
						es={`Más de ${totalBeers} cervezas de 17 países, ${info.taps} grifos y cocina alemana en pleno Paseo Marítimo. El Mediterráneo, a diez pasos de la jarra.`}
						en={`Over ${totalBeers} beers from 17 countries, ${info.taps} taps and German cooking right on the seafront. The Mediterranean, ten steps from your stein.`}
					/>
				</p>

				<div class='hero__ctas' data-in>
					<a class='btn btn--gold' href={carta}><T es='Ver la carta' en='See the menu' /> <Icon name='arrow' size={18} /></a>
					<a class='btn btn--line' href='#reserva'><T es='Reservar mesa' en='Book a table' /></a>
				</div>

				<div class='hero__visual'>
					<figure class='hero__arch' data-hero-photo>
						<Image src={imgTerrazaPretzel} alt='Una Paulaner Weißbier y un bretzel en la terraza, con las palmeras del paseo marítimo detrás' widths={[480, 720, 960]} sizes='(max-width: 900px) 80vw, 36vw' loading='eager' fetchpriority='high' />
					</figure>
					<div class='stamp hero__stamp' data-hero-stamp>
						<svg class='stamp__ring' viewBox='0 0 200 200' aria-hidden='true'>
							<defs><path id='stamp-path' d='M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0' /></defs>
							<text><textPath href='#stamp-path' textLength='486'>{stampText.toUpperCase()}</textPath></text>
						</svg>
						<Image src={imgMedallon} alt='' width={300} height={300} class='stamp__seal' loading='eager' />
					</div>
				</div>
			</div>

			<div class='board' data-board role='region' aria-roledescription='carrusel' aria-label='Cervezas de grifo'>
				<span class='board__bar' aria-hidden='true'><span data-b-bar></span></span>
				<div class='board__in wrap'>
					<p class='board__label'>
						<span class='board__title'><T es='Ahora de grifo' en='On tap now' /></span>
						<span class='board__sub'><T es={`${info.taps} grifos · ${tapCountries} países`} en={`${info.taps} taps · ${tapCountries} countries`} /></span>
					</p>
					<a class='board__slot' href='#grifos' data-b-go aria-live='off'>
						<span class='board__n'><span data-b='n'>02</span></span>
						<span class='board__glass'><span class='board__swatch' data-b-swatch style={`--beer:${first.color}; --foam:${first.foam ?? '#fff8e6'}`}></span></span>
						<span class='board__text'>
							<span class='board__name'><span data-b='name'>{first.name}</span></span>
							<span class='board__meta'><span data-b='meta'><T es={`${first.style.es} · ${countryByCode[first.country]?.name.es ?? ''} · ${first.abv}`} en={`${first.style.en} · ${countryByCode[first.country]?.name.en ?? ''} · ${first.abv}`} /></span></span>
						</span>
						<span class='board__price'><span data-b='price'>{euro(first.prices[2] ?? 0)}</span><small data-b='size'>50 cl</small></span>
					</a>
					<div class='board__nav'>
						<button type='button' class='board__btn board__btn--prev' data-b-step='-1' aria-label='Cerveza anterior'><Icon name='arrow' size={18} /></button>
						<button type='button' class='board__btn' data-b-step='1' aria-label='Siguiente cerveza'><Icon name='arrow' size={18} /></button>
					</div>
				</div>
				<script type='application/json' data-board-taps set:html={JSON.stringify(taps.map((t) => { const s = t.prices[2] != null ? 2 : t.prices[1] != null ? 1 : 0; return { name: t.name, abv: t.abv, price: t.prices[s], size: tapSizes[s].replace('cl', ' cl'), style: t.style, country: countryByCode[t.country]?.name ?? { es: '', en: '' }, color: t.color, foam: t.foam }; }))} />
			</div>
		</section>

		<!-- ============ LA CASA ============ -->
		<section class='sec sec--paper casa-sec' id='casa'>
			<p class='watermark' aria-hidden='true' data-drift>Willkommen</p>
			<div class='wrap casa'>
				<div class='casa__text'>
					<header class='hd'>
						<p class='hd__n'><span>01</span><T es='La casa' en='The house' /></p>
						<h2 class='hd__t reveal'>
							<T html es='Una cervecería alemana *con el mar enfrente*' en='A German beer hall *facing the sea*' />
						</h2>
					</header>
					<p class='lead reveal'>
						<T
							es='Abrimos en Buenos Aires en 2004 y en 2022 cruzamos el Atlántico hasta La Malagueta. Paredes forradas de carteles antiguos, posavasos hasta el techo, cerveza bien tirada y una terraza a pie de paseo marítimo.'
							en='We opened in Buenos Aires in 2004 and in 2022 crossed the Atlantic to La Malagueta. Walls lined with vintage beer signs, coasters up to the ceiling, properly poured beer and a terrace right on the seafront.'
						/>
					</p>
					<a class='link reveal' href='#historia'><T es='Nuestra historia' en='Our story' /> <Icon name='arrow' size={16} /></a>
				</div>
				<figure class='casa__img casa__img--a reveal-img' data-speed='-0.06'>
					<Image src={imgCarteles} alt='Pared cubierta de carteles de chapa de cervezas de todo el mundo' widths={[420, 720]} sizes='(max-width: 900px) 60vw, 26vw' />
				</figure>
				<figure class='casa__img casa__img--b reveal-img' data-speed='0.08'>
					<Image src={imgGrifoAzul} alt='Torre de grifo de Weihenstephaner sobre la pared roja de la barra' widths={[360, 600]} sizes='(max-width: 900px) 45vw, 18vw' />
				</figure>
			</div>
		</section>

		<!-- ============ GRIFOS ============ -->
		<section class='sec sec--dark' id='grifos' aria-labelledby='taps-title'>
			<div class='wrap'>
				<header class='hd hd--split'>
					<div>
						<p class='hd__n'><span>02</span><T es='De grifo' en='On tap' /></p>
						<h2 class='hd__t reveal' id='taps-title'><T html es='Diecinueve grifos, *recién tirados*' en='Nineteen taps, *freshly poured*' /></h2>
					</div>
					<p class='hd__sub reveal'>
						<T es='De la Paulaner de Múnich a la Gulden Draak de 10,5°. Elige una para ver sus medidas y precios.' en='From Munich’s Paulaner to a 10.5% Gulden Draak. Pick one to see sizes and prices.' />
					</p>
				</header>

				<div class='taps'>
					<ol class='taps__list' data-taps role='listbox' aria-label='Cervezas de grifo'>
						{taps.map((t, i) => (
							<li>
								<button
									type='button'
									class='taprow'
									role='option'
									aria-selected={t === first ? 'true' : 'false'}
									data-tap={t.id}
									data-name={t.name}
									data-abv={t.abv}
									data-style-es={t.style.es}
									data-style-en={t.style.en}
									data-country={t.country}
									data-color={t.color}
									data-foam={t.foam ?? '#f6efdf'}
									data-prices={JSON.stringify(t.prices)}
									style={`--beer:${t.color}`}
								>
									<span class='taprow__n'>{String(i + 1).padStart(2, '0')}</span>
									<span class='taprow__name'>{t.name}</span>
									<span class='taprow__style'><T es={t.style.es} en={t.style.en} /></span>
									<span class='taprow__abv'>{t.abv}</span>
								</button>
							</li>
						))}
					</ol>

					<aside class='tapcard' data-tapcard aria-live='polite' style={`--beer:${first.color};--foam:${first.foam ?? '#f6efdf'}`}>
						<div class='tapcard__glow' aria-hidden='true'></div>
						<svg class='tapcard__glass' viewBox='0 0 120 200' aria-hidden='true'>
							<defs>
								<clipPath id='glass-clip'><path d='M14 8 H106 L96 186 Q95 194 87 194 H33 Q25 194 24 186 Z' /></clipPath>
								<linearGradient id='glass-shine' x1='0' x2='1'>
									<stop offset='0' stop-color='#fff' stop-opacity='.0' />
									<stop offset='.18' stop-color='#fff' stop-opacity='.28' />
									<stop offset='.3' stop-color='#fff' stop-opacity='0' />
								</linearGradient>
							</defs>
							<g clip-path='url(#glass-clip)'>
								<rect class='tapcard__beer' data-beer x='0' y='0' width='120' height='200' />
								<g class='tapcard__bubbles'>
									{Array.from({ length: 10 }).map((_, i) => (
										<circle cx={30 + ((i * 23) % 62)} cy='190' r={0.9 + (i % 3) * 0.5} style={`--d:${(i * 0.41) % 2.6}s;--t:${2.2 + (i % 4) * 0.5}s`} />
									))}
								</g>
								<rect class='tapcard__foam' data-foam x='0' y='0' width='120' height='22' />
								<rect x='0' y='0' width='120' height='200' fill='url(#glass-shine)' />
							</g>
							<path d='M14 8 H106 L96 186 Q95 194 87 194 H33 Q25 194 24 186 Z' fill='none' stroke='currentColor' stroke-width='1.2' />
						</svg>
						<div class='tapcard__body'>
							<p class='label tapcard__meta'><span data-tc-country>{countryByCode[first.country]?.name.es}</span> · <span data-tc-abv>{first.abv}</span></p>
							<h3 class='tapcard__name' data-tc-name>{first.name}</h3>
							<p class='tapcard__style' data-tc-style>{first.style.es}</p>
							<ul class='tapcard__sizes'>
								{tapSizes.map((s, i) => (
									<li data-size={i} class={first.prices[i] == null ? 'is-off' : ''}>
										<span>{s}</span>
										<span data-price>{first.prices[i] == null ? '—' : euro(first.prices[i]!)}</span>
									</li>
								))}
							</ul>
						</div>
					</aside>
				</div>

				<div class='taps__foot'>
					<Image src={imgSampler} alt='' width={120} height={120} class='taps__foot-img' />
					<p>
						<strong><T es={sampler.name.es} en={sampler.name.en} /> · {euro(sampler.price)}</strong>
						<T es='Cinco copitas de 12 cl para probar la familia Chouffe.' en='Five 12 cl glasses to taste the Chouffe family.' />
					</p>
					<a class='link' href={`${carta}#grifo`}><T es='Ver todos los grifos' en='All taps' /> <Icon name='arrow' size={16} /></a>
				</div>
			</div>
		</section>

		<!-- ============ MARQUESINA ============ -->
		<div class='marquee marquee--mustard' aria-hidden='true'>
			<div class='marquee__track'>
				{[0, 1].map(() => (
					<div class='marquee__group'>
						{tapNames.map((n) => <span class='marquee__item'>{n}<i>✦</i></span>)}
					</div>
				))}
			</div>
		</div>

		<!-- ============ DEL MUNDO ============ -->
		<section class='sec sec--paper' id='mundo' aria-labelledby='world-title'>
			<div class='wrap'>
				<header class='hd hd--split'>
					<div>
						<p class='hd__n'><span>03</span><T es='Botellas' en='Bottles' /></p>
						<h2 class='hd__t reveal' id='world-title'><T html es={`*La vuelta al mundo* en ${bottles.length} cervezas`} en={`*Around the world* in ${bottles.length} beers`} /></h2>
					</div>
					<p class='hd__sub reveal'>
						<T es='Trapenses belgas, ahumadas de Bamberg, IPAs americanas y una Saigon bien fría. Elige un país y te llevamos a su página de la carta.' en='Belgian Trappists, smoked beers from Bamberg, American IPAs and an ice-cold Saigon. Pick a country to jump to it on the menu.' />
					</p>
				</header>

				<div class='world'>
					<ul class='world__index'>
						{world.map((c) => (
							<li>
								<a class='wrow' href={`${carta}?pais=${c.code}#mundo`}>
									<span class='wrow__name'><T es={c.name.es} en={c.name.en} /></span>
									<span class='wrow__n'>{c.count}</span>
									<span class='wrow__top'>{c.top.join(' · ')}</span>
									<Icon name='arrow' size={18} class='wrow__arrow' />
								</a>
							</li>
						))}
					</ul>
					<div class='world__media'>
