<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { initCommon, initLenis, getLang } from './scripts/common';
	import { initTaps } from './scripts/taps';

	gsap.registerPlugin(ScrollTrigger);
	initCommon();
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const lenis = initLenis();
	if (lenis) {
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);
	}

	/* ---------- Menú móvil ---------- */
	const menu = document.querySelector<HTMLElement>('[data-menu]')!;
	const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
	const setMenu = (open: boolean) => {
		menu.classList.toggle('is-open', open);
		menu.setAttribute('aria-hidden', String(!open));
		openBtn.setAttribute('aria-expanded', String(open));
		document.documentElement.classList.toggle('menu-open', open);
		if (open) lenis?.stop();
		else lenis?.start();
	};
	openBtn.addEventListener('click', () => setMenu(true));
	document.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));
	menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

	/* ---------- Hero en pantalla ---------- */
	const heroEl = document.querySelector<HTMLElement>('[data-hero]')!;
	let heroVisible = true;
	const heroIO: ((v: boolean) => void)[] = [];
	new IntersectionObserver(([e]) => {
		heroVisible = e.isIntersecting;
		heroIO.forEach((fn) => fn(e.isIntersecting));
	}, { rootMargin: '-80px 0px 0px 0px' }).observe(heroEl);

	/* ---------- Hero: barra "Ahora de grifo" ---------- */
	initBoard();
	function initBoard() {
		const board = document.querySelector<HTMLElement>('[data-board]');
		const json = board?.querySelector('[data-board-taps]');
		if (!board || !json) return;
		type BT = { name: string; abv: string; price: number; size: string; style: { es: string; en: string }; country: { es: string; en: string }; color: string; foam?: string };
		const list: BT[] = JSON.parse(json.textContent || '[]');
		if (!list.length) return;
		const DURATION = 6.2;
		const field = (k: string) => board.querySelector<HTMLElement>(`[data-b="${k}"]`)!;
		const els = { n: field('n'), name: field('name'), meta: field('meta'), price: field('price'), size: field('size') };
		const swatch = board.querySelector<HTMLElement>('[data-b-swatch]')!;
		const moving = [els.n, swatch, els.name, els.meta, els.price, els.size];
		const euroFmt = (n: number) => n.toFixed(2).replace('.', ',') + ' €';
		let i = 1;
		let swap: gsap.core.Timeline | null = null;

		const apply = (idx: number) => {
			const t = list[idx];
			const l = getLang();
			els.n.textContent = String(idx + 1).padStart(2, '0');
			els.name.textContent = t.name;
			els.meta.textContent = `${t.style[l]} · ${t.country[l]} · ${t.abv}`;
			els.price.textContent = euroFmt(t.price);
			els.size.textContent = t.size;
			swatch.style.setProperty('--beer', t.color);
			swatch.style.setProperty('--foam', t.foam ?? '#fff8e6');
		};

		const go = (dir: number) => {
			i = (i + dir + list.length) % list.length;
			const idx = i;
			restart();
			if (reduce) return apply(idx);
			swap?.progress(1).kill();
			swap = gsap.timeline()
				.to(moving, { yPercent: -110 * dir, opacity: 0, duration: 0.28, ease: 'power2.in', stagger: 0.03 })
				.add(() => apply(idx))
				.fromTo(moving, { yPercent: 110 * dir, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.5, ease: 'power3.out', stagger: 0.04 });
		};

		// Autoplay; se pausa al pasar el ratón, con el foco o fuera de pantalla
		const bar = board.querySelector<HTMLElement>('[data-b-bar]')!;
		if (reduce) bar.parentElement!.style.display = 'none';
		const auto = gsap.fromTo(bar, { scaleX: 0 }, { scaleX: 1, duration: DURATION, ease: 'none', onComplete: () => go(1) }).pause();
		const holds = new Set<string>();
		const sync = () => (holds.size || reduce ? auto.pause() : auto.play());
		const hold = (k: string, on: boolean) => {
			if (on) holds.add(k);
			else holds.delete(k);
			sync();
		};
		function restart() {
			auto.pause(0);
			sync();
		}
		board.addEventListener('pointerenter', () => hold('hover', true));
		board.addEventListener('pointerleave', () => hold('hover', false));
		board.addEventListener('focusin', () => hold('focus', true));
		board.addEventListener('focusout', (e) => !board.contains(e.relatedTarget as Node) && hold('focus', false));
		heroIO.push((v) => hold('offscreen', !v));
		document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
		if (!heroVisible) holds.add('offscreen');

		board.querySelectorAll<HTMLButtonElement>('[data-b-step]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.bStep))));
		board.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
				e.preventDefault();
				go(e.key === 'ArrowRight' ? 1 : -1);
			}
		});
		// Swipe en móvil
		let x0: number | null = null;
		board.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
		board.addEventListener('touchend', (e) => {
			if (x0 == null) return;
			const dx = e.changedTouches[0].clientX - x0;
			x0 = null;
			if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
		});

		// Al pulsar la cerveza: baja a los grifos con ella ya servida
		board.querySelector('[data-b-go]')?.addEventListener('click', () => {
			const name = list[i].name;
			const btn = [...document.querySelectorAll<HTMLButtonElement>('[data-tap]')].find((b) => b.dataset.name === name);
			btn?.click();
		});

		apply(i);
		window.addEventListener('unter:lang', () => apply(i));
		sync();
	}

	/* ---------- Reserva por WhatsApp ---------- */
	initBooking();
	function initBooking() {
		const form = document.querySelector<HTMLFormElement>('[data-book]');
		if (!form) return;
		const daysEl = form.querySelector<HTMLElement>('[data-book-days]')!;
		const peopleEl = form.querySelector<HTMLOutputElement>('[data-people]')!;
		const nameEl = form.querySelector<HTMLInputElement>('[data-book-name]')!;
		const sumEl = form.querySelector<HTMLElement>('[data-book-sum]')!;
		const timeInputs = [...form.querySelectorAll<HTMLInputElement>('input[name=time]')];
		let people = 2;
		const MAX = 12;

		const today = new Date();
		today.setHours(0, 0, 0, 0);
		const days = Array.from({ length: 14 }, (_, i) => new Date(today.getFullYear(), today.getMonth(), today.getDate() + i));
		const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

		const renderDays = () => {
			const lang = getLang();
			const loc = lang === 'es' ? 'es-ES' : 'en-GB';
			const checked = form.querySelector<HTMLInputElement>('input[name=day]:checked')?.value ?? iso(days[0]);
			daysEl.innerHTML = days
				.map((d, i) => {
					const wd = i === 0 ? (lang === 'es' ? 'Hoy' : 'Today') : i === 1 ? (lang === 'es' ? 'Mañana' : 'Tmrw') : d.toLocaleDateString(loc, { weekday: 'short' }).replace('.', '');
					const mo = d.toLocaleDateString(loc, { month: 'short' }).replace('.', '');
					return `<label class="day"><input type="radio" name="day" value="${iso(d)}"${iso(d) === checked ? ' checked' : ''}><span class="day__w">${wd}</span><span class="day__n">${d.getDate()}</span><span class="day__m">${mo}</span></label>`;
				})
				.join('');
		};

		const syncTimes = () => {
			const day = form.querySelector<HTMLInputElement>('input[name=day]:checked')?.value;
			const isToday = day === iso(days[0]);
			const now = new Date();
			const nowMin = now.getHours() * 60 + now.getMinutes() + 30;
			timeInputs.forEach((inp) => {
				const [h, m] = inp.value.split(':').map(Number);
				const past = isToday && h * 60 + m < nowMin;
				inp.disabled = past;
				if (past && inp.checked) inp.checked = false;
			});
		};

		const dateLabel = (v: string) => {
			const [y, m, d] = v.split('-').map(Number);
			return new Date(y, m - 1, d).toLocaleDateString(getLang() === 'es' ? 'es-ES' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
		};

		const update = () => {
			const es = getLang() === 'es';
			const day = form.querySelector<HTMLInputElement>('input[name=day]:checked')?.value;
			const time = form.querySelector<HTMLInputElement>('input[name=time]:checked')?.value;
			peopleEl.textContent = String(people);
			nameEl.placeholder = es ? 'A nombre de…' : 'Name for the booking…';
			const who = es ? `${people} ${people === 1 ? 'persona' : 'personas'}` : `${people} ${people === 1 ? 'guest' : 'guests'}`;
			sumEl.innerHTML = day && time ? `<strong>${dateLabel(day)}</strong> · ${time} · ${who}` : es ? 'Elige una hora' : 'Pick a time';
		};

		renderDays();
		syncTimes();
		// Si hoy ya no quedan horas, se propone mañana
		if (timeInputs.every((i) => i.disabled)) {
			form.querySelector<HTMLInputElement>(`input[name=day][value="${iso(days[1])}"]`)!.checked = true;
			syncTimes();
		}
		update();

		form.addEventListener('change', (e) => {
			if ((e.target as HTMLInputElement).name === 'day') syncTimes();
			update();
		});
		form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
			b.addEventListener('click', () => {
				people = Math.min(MAX, Math.max(1, people + Number(b.dataset.step)));
				update();
			}),
		);
		window.addEventListener('unter:lang', () => {
			renderDays();
			syncTimes();
			update();
		});

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const es = getLang() === 'es';
			const day = form.querySelector<HTMLInputElement>('input[name=day]:checked')?.value;
			const time = form.querySelector<HTMLInputElement>('input[name=time]:checked')?.value;
			const name = nameEl.value.trim();
			form.classList.remove('is-invalid-time', 'is-invalid-name');
			if (!time) form.classList.add('is-invalid-time');
			if (!name) form.classList.add('is-invalid-name');
			if (!day || !time || !name) {
				sumEl.textContent = es ? (!time ? 'Elige una hora' : 'Dinos a nombre de quién') : !time ? 'Pick a time' : 'Tell us your name';
				if (!name && time) nameEl.focus();
				return;
			}
			const msg = es
				? `¡Hola! Me gustaría reservar mesa en Untertürkheim:\n\n📅 ${dateLabel(day)}\n🕗 ${time}\n👥 ${people} ${people === 1 ? 'persona' : 'personas'}\n🙋 A nombre de ${name}\n\n¡Gracias!`
				: `Hi! I'd like to book a table at Untertürkheim:\n\n📅 ${dateLabel(day)}\n🕗 ${time}\n👥 ${people} ${people === 1 ? 'guest' : 'guests'}\n🙋 Name: ${name}\n\nThanks!`;
			window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
		});
	}

	if (!reduce) {
		/* ---------- Hero ---------- */
		const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
		tl.from('[data-line]', { yPercent: 110, duration: 1.3, stagger: 0.12 }, 0.1)
			.from('[data-hero-photo]', { clipPath: 'inset(100% 0 0 0 round 999px 999px 0 0)', duration: 1.5, ease: 'expo.inOut' }, 0)
			.from('[data-hero-photo] img', { scale: 1.3, duration: 2.2, ease: 'power3.out' }, 0.2)
			.from('[data-hero-stamp]', { scale: 0.6, opacity: 0, duration: 1.1, ease: 'back.out(1.4)' }, 0.9)
			.from('[data-in]', { y: 22, opacity: 0, duration: 1, stagger: 0.08, ease: 'power3.out' }, 0.45)
			.from('[data-board] .board__in', { y: 30, opacity: 0, duration: 1, ease: 'power3.out' }, 0.9);

		const heroST = { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true };
		gsap.to('[data-hero-photo] img', { yPercent: 10, ease: 'none', scrollTrigger: heroST });
		gsap.to('[data-hero-stamp]', { yPercent: -40, ease: 'none', scrollTrigger: heroST });
		gsap.to('[data-hero-stamp] .stamp__ring', { rotate: 90, ease: 'none', scrollTrigger: heroST });
		gsap.to('.hero__title', { yPercent: -10, ease: 'none', scrollTrigger: heroST });

		/* ---------- Reveals ---------- */
		gsap.utils.toArray<HTMLElement>('.reveal, .hd__n, .dish__row, .wrow').forEach((el) => {
			gsap.from(el, { y: 26, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } });
		});
		gsap.utils.toArray<HTMLElement>('.reveal-img').forEach((el) => {
			gsap.fromTo(el, { clipPath: 'inset(14% 0 14% 0)' }, { clipPath: 'inset(0% 0 0% 0)', duration: 1.4, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
			const img = el.querySelector('img');
			if (img) gsap.fromTo(img, { scale: 1.18 }, { scale: 1, duration: 1.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
		});

		/* ---------- Parallax suave ---------- */
		gsap.utils.toArray<HTMLElement>('[data-speed]').forEach((el) => {
			const s = Number(el.dataset.speed);
			gsap.to(el, { yPercent: s * -100, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
		});
		gsap.utils.toArray<HTMLElement>('[data-drift]').forEach((el) => {
			gsap.fromTo(el, { xPercent: 8 }, { xPercent: -14, ease: 'none', scrollTrigger: { trigger: el.parentElement, start: 'top bottom', end: 'bottom top', scrub: true } });
		});

		/* ---------- Historia: la regla se dibuja ---------- */
		const ax = window.matchMedia('(max-width: 900px)').matches ? 'scaleY' : 'scaleX';
		gsap.fromTo('[data-story-line]', { [ax]: 0 }, { [ax]: 1, ease: 'none', scrollTrigger: { trigger: '[data-story]', start: 'top 80%', end: 'bottom 70%', scrub: true } });

		/* ---------- Marquesinas: aceleran con el scroll ---------- */
		document.querySelectorAll<HTMLElement>('.marquee__track').forEach((track, i) => {
			const dir = i % 2 ? 1 : -1;
			const loop = gsap.fromTo(track, { xPercent: dir < 0 ? 0 : -50 }, { xPercent: dir < 0 ? -50 : 0, duration: 45, ease: 'none', repeat: -1 });
			ScrollTrigger.create({
				trigger: track,
				onUpdate: (st) => {
					const v = Math.min(5, 1 + Math.abs(st.getVelocity()) / 500);
					gsap.timeline({ overwrite: true }).to(loop, { timeScale: v, duration: 0.2 }).to(loop, { timeScale: 1, duration: 1.4 });
				},
			});
		});
	}

	/* ---------- Grifos ---------- */
	initTaps({ reduce, getLang });

	/* ---------- Terraza: galería horizontal fijada ---------- */
	const hWrap = document.querySelector<HTMLElement>('[data-hscroll]')!;
	const hView = document.querySelector<HTMLElement>('[data-hscroll-viewport]')!;
	const hTrack = document.querySelector<HTMLElement>('[data-hscroll-track]')!;
	const tBar = document.querySelector<HTMLElement>('[data-tprogress]')!;
	const tCount = document.querySelector<HTMLElement>('[data-tcount]')!;
	const nPhotos = hTrack.children.length;
	const setProgress = (p: number) => {
		tBar.style.transform = `scaleX(${Math.max(0.04, p)})`;
		tCount.textContent = String(Math.min(nPhotos, 1 + Math.round(p * (nPhotos - 1)))).padStart(2, '0');
	};
	setProgress(0);
	const mm = gsap.matchMedia();
	mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
		const dist = () => hTrack.scrollWidth - hView.clientWidth;
		const tween = gsap.to(hTrack, {
			x: () => -dist(),
			ease: 'none',
			scrollTrigger: { trigger: hWrap, start: 'top top', end: () => `+=${dist()}`, pin: true, scrub: 0.8, invalidateOnRefresh: true, onUpdate: (st) => setProgress(st.progress) },
		});
		return () => tween.kill();
	});
	mm.add('(max-width: 899px), (prefers-reduced-motion: reduce)', () => {
		const onScroll = () => setProgress(hView.scrollLeft / Math.max(1, hView.scrollWidth - hView.clientWidth));
		hView.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
		return () => hView.removeEventListener('scroll', onScroll);
	});

	/* ---------- Agenda: la foto sigue al cursor ---------- */
	const float = document.querySelector<HTMLElement>('[data-float]');
	const events = document.querySelector<HTMLElement>('[data-events]');
	if (float && events && window.matchMedia('(hover: hover) and (min-width: 1001px)').matches) {
		const imgs = [...float.querySelectorAll('img')];
		const rows = [...events.querySelectorAll<HTMLElement>('[data-event]')];
		rows.forEach((row) => {
			row.addEventListener('pointerenter', () => {
				const i = Number(row.dataset.event);
				rows.forEach((r, j) => r.classList.toggle('is-active', j === i));
				imgs.forEach((im, j) => im.classList.toggle('is-on', j === i));
			});
		});
	}

	window.addEventListener('load', () => ScrollTrigger.refresh());
</script>
