<script>
	import { initLang } from './scripts/common';

	initLang();

	/* ---------- Pestañas con scroll-spy ---------- */
	const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
	const secs = [...document.querySelectorAll<HTMLElement>('[data-sec]')];
	const setActive = (id: string) => {
		tabs.forEach((t) => {
			const on = t.dataset.tab === id;
			t.classList.toggle('is-active', on);
			if (on) t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
		});
	};
	const io = new IntersectionObserver((entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)), { rootMargin: '-45% 0px -50% 0px' });
	secs.forEach((s) => io.observe(s));

	/* ---------- Países: marca el país visible ---------- */
	const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-country]')];
	const groups = [...document.querySelectorAll<HTMLElement>('.ct-group')];
	const gio = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (!e.isIntersecting) return;
				const code = e.target.id.replace('pais-', '');
				chips.forEach((c) => c.classList.toggle('is-on', c.dataset.country === code));
			}),
		{ rootMargin: '-40% 0px -55% 0px' },
	);
	groups.forEach((g) => gio.observe(g));

	// Deep-link desde la home: ?pais=BE
	const p = new URLSearchParams(location.search).get('pais');
	if (p) requestAnimationFrame(() => document.getElementById(`pais-${p}`)?.scrollIntoView());

	/* ---------- Aparición suave ---------- */
	const rv = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (e.isIntersecting) {
					e.target.classList.add('is-in');
					rv.unobserve(e.target);
				}
			}),
		{ rootMargin: '0px 0px -8% 0px' },
	);
	document.querySelectorAll('[data-rv]').forEach((el) => rv.observe(el));
</script>
