	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { initShanaoCommon } from './scripts/common';

	gsap.registerPlugin(ScrollTrigger);
	const lenis = initShanaoCommon();
	lenis?.on('scroll', ScrollTrigger.update);

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// ---------- Hero: los platos se turnan en el marco, con su nombre ----------
	{
		const slides = [...document.querySelectorAll<HTMLElement>('.hero__slide')];
		const caps = [...document.querySelectorAll<HTMLElement>('.hero__cap')];
		let i = 0;
		if (slides.length > 1 && !reduce) {
			setInterval(() => {
				const prev = caps[i];
				slides[i].classList.remove('is-on');
				prev?.classList.replace('is-on', 'is-out');
				setTimeout(() => prev?.classList.remove('is-out'), 800);
				i = (i + 1) % slides.length;
				slides[i].classList.add('is-on');
				caps[i]?.classList.add('is-on');
			}, 4200);
		}
	}

	if (!reduce) {
		const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
		tl.from('.hero__eyebrow', { y: 14, opacity: 0, duration: 0.9 }, 0.1)
			.from('.hero__line-in', { yPercent: 110, duration: 1.3, stagger: 0.1 }, 0.15)
			.from('.hero__title-leaf', { scale: 0, rotate: -60, duration: 1.1, ease: 'back.out(1.8)' }, 0.75)
			.from('.hero__lead, .hero__ctas, .hero__proof', { y: 22, opacity: 0, duration: 1, stagger: 0.08 }, 0.5)
			.from('.hero__frame', { clipPath: 'inset(100% 0% 0% 0%)', duration: 1.5, ease: 'expo.inOut', clearProps: 'clipPath' }, 0)
			.from('.hero__slide.is-on', { scale: 1.3, duration: 2.2, ease: 'power3.out', clearProps: 'transform' }, 0.2)
			.from('.hero__badge', { scale: 0, duration: 1.2, ease: 'back.out(1.6)' }, 0.9);


		// scroll: la composición se separa un poco al salir
		const st = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true };
		gsap.to('.hero__frame', { yPercent: -8, ease: 'none', scrollTrigger: st });
		gsap.to('.hero__badge', { yPercent: -60, ease: 'none', scrollTrigger: st });

		// Reveal genérico
		gsap.utils.toArray<HTMLElement>('.sec-head, .story__intro, .reviews__head, .local__copy > *, .visit__copy > *').forEach((el) => {
			gsap.from(el, { y: 40, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%' } });
		});
		gsap.from('.pillar', { y: 80, opacity: 0, rotate: 3, duration: 1.1, ease: 'expo.out', stagger: 0.12, scrollTrigger: { trigger: '.pillars__grid', start: 'top 85%' } });
		gsap.from('.feat', { y: 30, opacity: 0, duration: 0.9, ease: 'back.out(1.6)', stagger: 0.08, scrollTrigger: { trigger: '.feats', start: 'top 90%' } });
		gsap.from('.stop', { y: 50, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.1, scrollTrigger: { trigger: '.day__stops', start: 'top 85%' } });
	}

	const mm = gsap.matchMedia();

	// ---------- Un día en Shanao: el sol recorre el día ----------
	const stops = gsap.utils.toArray<HTMLElement>('.stop');
	const lightStops = (p: number) => stops.forEach((s, i) => s.classList.toggle('is-lit', p >= i / (stops.length - 1) - 0.02));
	mm.add('(min-width: 961px)', () => {
		gsap.timeline({ scrollTrigger: { trigger: '.day__rail', start: 'top 75%', end: 'bottom 45%', scrub: 0.6, onUpdate: (s) => lightStops(s.progress) } })
			.to('.day__sun', { left: '100%', rotate: 360, ease: 'none' }, 0)
			.to('.day__progress', { width: '100%', ease: 'none' }, 0);
	});
	mm.add('(max-width: 960px)', () => {
		gsap.timeline({ scrollTrigger: { trigger: '.day__rail', start: 'top 70%', end: 'bottom 60%', scrub: 0.6, onUpdate: (s) => lightStops(s.progress) } })
			.to('.day__sun', { top: '100%', rotate: 360, ease: 'none' }, 0)
			.to('.day__progress', { height: '100%', ease: 'none' }, 0);
	});

	if (!reduce) {
		// ---------- Story: scroll horizontal fijado (escritorio) ----------
		mm.add('(min-width: 961px)', () => {
			const track = document.querySelector<HTMLElement>('.story__track');
			const pin = document.querySelector<HTMLElement>('.story__pin');
			if (!track || !pin) return;
			const distance = () => track.scrollWidth - window.innerWidth;
			const tween = gsap.to(track, {
				x: () => -distance(),
				ease: 'none',
				scrollTrigger: { trigger: pin, start: 'center center', end: () => `+=${distance()}`, pin: true, scrub: 0.8, invalidateOnRefresh: true },
			});
			gsap.utils.toArray<HTMLElement>('.panel__media').forEach((m) => {
				gsap.fromTo(m, { rotate: -25, scale: 0.85 }, { rotate: 8, scale: 1, ease: 'none', scrollTrigger: { trigger: m.parentElement, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true } });
			});
		});

		// ---------- Favoritos: tarjetas apiladas ----------
		const cards = gsap.utils.toArray<HTMLElement>('.card');
		cards.forEach((card, idx) => {
			if (idx === cards.length - 1) return;
			gsap.fromTo(card, { scale: 1, filter: 'brightness(1)' }, { scale: 0.92, filter: 'brightness(0.82)', ease: 'none', scrollTrigger: { trigger: cards[idx + 1], start: 'top bottom', end: 'top 20%', scrub: true } });
		});

		// ---------- Local ----------
		gsap.fromTo('.local__reveal', { clipPath: 'inset(18% 18% 18% 18% round 36px)' }, { clipPath: 'inset(0% 0% 0% 0% round 36px)', ease: 'none', scrollTrigger: { trigger: '.local__media', start: 'top 85%', end: 'center center', scrub: true } });
		gsap.fromTo('.local__reveal img', { scale: 1.3 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.local__media', start: 'top bottom', end: 'bottom top', scrub: true } });
		gsap.from('.local__mini', { scale: 0, rotate: -40, duration: 1, ease: 'back.out(1.7)', stagger: 0.15, scrollTrigger: { trigger: '.local__media', start: 'top 70%' } });
		gsap.from('.visit__card', { y: 80, scale: 0.96, opacity: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: '.visit', start: 'top 85%' } });
	}

	// ---------- Contadores ----------
	document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
		const end = parseFloat(el.dataset.count || '0');
		const dec = parseInt(el.dataset.decimals || '0', 10);
		const fmt = (v: number) => v.toFixed(dec).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
		if (reduce) {
			el.textContent = fmt(end);
			return;
		}
		const obj = { v: 0 };
		el.textContent = fmt(0);
		ScrollTrigger.create({
			trigger: el,
			start: 'top 90%',
			once: true,
			onEnter: () => gsap.to(obj, { v: end, duration: 2, ease: 'power2.out', onUpdate: () => (el.textContent = fmt(obj.v)) }),
		});
	});
</script>
