---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/inter/wght.css';
import './shanao.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import Leaf from './components/Leaf.astro';
import Icon from './components/Icon.astro';
import Nav from './components/Nav.astro';
import Footer from './components/Footer.astro';
import { info } from './data/info';

import imgBowls from '../../assets/demos/shanao/seccion-bowls.jpg';
import imgCookie2 from '../../assets/demos/shanao/seccion-coffee-cookie.jpg';
import imgJuice from '../../assets/demos/shanao/zumo.jpg';
import imgTartas from '../../assets/demos/shanao/seccion-tartas.jpg';
import imgTostas from '../../assets/demos/shanao/seccion-tostas.jpg';
import imgSandwich from '../../assets/demos/shanao/seccion-sandwich.jpg';
import imgCrepes from '../../assets/demos/shanao/seccion-crepes-salados.jpg';
import imgEnsaladas from '../../assets/demos/shanao/seccion-ensaladas.jpg';
import imgPlato from '../../assets/demos/shanao/seccion-plato-ingles.jpg';
import imgCrunchy from '../../assets/demos/shanao/seccion-coffee-crunchy.jpg';
import imgTeam from '../../assets/demos/shanao/equipo.jpg';
import imgPitufo from '../../assets/demos/shanao/panes/pitufo-blanco.jpg';

const base = '/demo/shanao';
const carta = `${base}/carta`;

// Hero: los platos se van turnando en el marco, cada uno con su nombre (la gracia de la carta)
const heroSlides = [
	{ img: imgBowls, name: 'Arigató', kind: 'Smoothie bowl', alt: 'Smoothie bowl Arigató con plátano, granola y arándanos' },
	{ img: imgTostas, name: 'Lujuria', kind: 'Tosta', alt: 'Tosta Lujuria con huevos revueltos y aguacate' },
	{ img: imgEnsaladas, name: 'Tierra', kind: 'Ensalada', alt: 'Ensalada Tierra con rúcula, piña y tofu' },
	{ img: imgTartas, name: 'Tarta casera', kind: 'Merienda', alt: 'Tartas caseras de la vitrina de Shanao' },
];

const day = [
	{ t: '8:00', title: 'Abrimos', text: 'Pan recién horneado y el primer café del día.', img: imgPlato },
	{ t: '10:30', title: 'Desayuno sin prisa', text: 'Tostas, bocadillos a tu manera y zumos recién licuados.', img: imgTostas },
	{ t: '13:30', title: 'Algo ligero', text: 'Ensaladas de los cuatro elementos y crepes salados.', img: imgEnsaladas },
	{ t: '17:00', title: 'La merienda', text: 'Tarta casera, un matcha latte o el famoso Coffee Cookie.', img: imgTartas },
	{ t: '20:30', title: 'Hasta mañana', text: 'Cerramos, pero mañana volvemos a las 8:00. Todos los días.', img: imgTeam },
];

const story = [
	{ id: 'bocadillos', word: 'Árboles', what: 'Bocadillos', bg: '#C8E6A0', ink: '#0F1F17', img: imgPitufo, blend: true, names: ['Olivo', 'Secuoya', 'Baobab', 'Maquilishuat', 'Ébano', 'Jacaranda', 'Sabina', 'Ciprés'], line: 'Pan de horno de piedra y 25 combinaciones con nombre de árbol. O móntalo tú.' },
	{ id: 'tostas', word: 'Pecados', what: 'Tostas', bg: '#FFB23F', ink: '#1E1300', img: imgTostas, names: ['Gula', 'Lujuria', 'Ira', 'Envidia', 'Pereza'], line: 'Cinco tostas, cinco pecados capitales. Ninguno se arrepiente.' },
	{ id: 'tostas', word: 'Gemas', what: 'Sándwiches', bg: '#5B4BDB', ink: '#FFFFFF', img: imgSandwich, names: ['Cuarzo', 'Amatista', 'Coral', 'Rubí', 'Zafiro'], line: 'Sándwiches tallados como piedras preciosas.' },
	{ id: 'bowls', word: 'Gracias', what: 'Bowls', bg: '#FF6F91', ink: '#2A0A14', img: imgBowls, names: ['Arigató', 'Shukran', 'Merci', 'Kop Kun Krap'], line: '«Gracias» en otros idiomas. La gratitud también alimenta.' },
	{ id: 'crepes-salados', word: 'Flores', what: 'Crepes', bg: '#FFD6E0', ink: '#2A0A14', img: imgCrepes, names: ['Lirio', 'Geranio', 'Gardenia', 'Hortensia'], line: 'Crepes salados que florecen. Con masa vegana de sarraceno si quieres.' },
	{ id: 'ensaladas', word: 'Elementos', what: 'Ensaladas', bg: '#1F7A4D', ink: '#FFFFFF', img: imgEnsaladas, names: ['Tierra', 'Agua', 'Aire', 'Fuego'], line: 'Cuatro ensaladas, cuatro elementos. Todo lo que necesitas.' },
	{ id: 'zumos', word: 'Islas', what: 'Zumos', bg: '#FF8A3D', ink: '#2A0F00', img: imgJuice, names: ['Bali', 'Maldivas', 'Phuket', 'Santorini', 'Maui', 'Capri', 'Cíes'], line: 'Cada zumo y cada batido te lleva de viaje a una isla.' },
];

const featured = [
	{ name: 'Arigató', kind: 'Smoothie bowl', desc: 'Yogur con espirulina, chía, plátano y mango. Coco, granola y arándanos por encima.', price: '9,50', img: imgBowls, bg: '#FF6F91', ink: '#2A0A14', tag: 'Nuevo' },
	{ name: 'Lujuria', kind: 'Tosta', desc: 'Huevos revueltos con champiñones, aguacate triturado, tomate y sésamo tostado.', price: '7,50', img: imgTostas, bg: '#FFB23F', ink: '#1E1300', tag: 'Pecado favorito' },
	{ name: 'Coffee Cookie', kind: 'Café', desc: 'Tu café servido dentro de un vaso de galleta. Bébetelo y luego cómete el vaso.', price: '4,80', img: imgCookie2, bg: '#0F1F17', ink: '#FAFAF5', tag: 'Icono de la casa' },
	{ name: 'Santorini', kind: 'Licuado', desc: 'Manzana, zanahoria, fresa, arándanos y jengibre, recién licuado.', price: '5,20', img: imgJuice, bg: '#C8E6A0', ink: '#0F1F17', tag: '100% vegetal' },
	{ name: 'Tierra', kind: 'Ensalada', desc: 'Rúcula, canónigos, piña, tomate, zanahoria, tofu y sésamo con balsámico de Módena.', price: '11,00', img: imgEnsaladas, bg: '#5B4BDB', ink: '#FFFFFF', tag: 'Vegana' },
];

const pillars = [
	{ n: '01', title: 'Vegano sin renunciar a nada', text: 'Heura, tofu, seitán, alioli vegano, mozzarella vegetal y 6 bebidas vegetales. Desayuna bien sin sacrificar ningún animal.', color: 'var(--matcha)' },
	{ n: '02', title: 'Café de especialidad', text: 'Café de origen en Chemex o prensa francesa, matcha latte, chai y nuestro famoso café en vaso de galleta.', color: 'var(--mango)' },
	{ n: '03', title: 'A tu manera', text: 'Elige pan, elige relleno. Monta tu bocadillo, tu bowl, tu crepe o tu ensalada como más te guste.', color: 'var(--pitaya)' },
];

const features = [
	{ icon: 'paw', title: 'Pet friendly', text: 'Tu perro también es de la casa. El nuestro lleva hasta camiseta.', bg: '#FFE7B8' },
	{ icon: 'bag', title: 'Para llevar', text: 'Pide tu bocadillo, bowl o café y llévatelo de camino a la playa.', bg: '#DDF0C6' },
	{ icon: 'leaf', title: 'Opciones veganas', text: 'Heura, tofu, seitán, quesos vegetales y seis bebidas vegetales.', bg: '#FFDCE5' },
	{ icon: 'wheat', title: 'Sin gluten', text: 'Pan Viena sin gluten y crepes de trigo sarraceno.', bg: '#E4E1FF' },
] as const;

const marquee = ['Opciones veganas', 'Matcha', 'Café de especialidad', 'Bowls', 'Zumos naturales', 'Crepes', 'Gofres', 'Pancakes', 'Pet friendly', 'Take away'];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CafeOrCoffeeShop',
	name: info.name,
	slogan: info.tagline,
	telephone: '+34951072666',
	priceRange: info.priceRange,
	servesCuisine: ['Desayunos', 'Vegana', 'Healthy', 'Café de especialidad'],
	address: { '@type': 'PostalAddress', streetAddress: info.address, addressLocality: info.city, postalCode: info.postalCode, addressCountry: 'ES' },
	geo: { '@type': 'GeoCoordinates', latitude: info.geo.lat, longitude: info.geo.lng },
	openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: info.hours.open, closes: info.hours.close }],
	aggregateRating: { '@type': 'AggregateRating', ratingValue: info.rating, reviewCount: info.reviews },
	sameAs: [info.instagram, info.facebook],
	hasMenu: carta,
};
---

<DemoLayout
	title='Shanao Café · Come sano, vive feliz · Málaga'
	description='Desayunos healthy, bowls, zumos naturales y café de especialidad en Carretera de Cádiz, Málaga. Opciones veganas y pet friendly.'
	themeColor='#0F1F17'
	ogImage='/demo-og/shanao.jpg'
	ogImageAlt='Shanao Café: come sano, vive feliz. Bowls, zumos y café de especialidad en Málaga.'
	siteName='Shanao Café'
	favicon='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 120%22%3E%3Cpath d=%22M50 2C27 22 8 50 8 74c0 22 19 36 42 36s42-14 42-36C92 50 73 22 50 2Z%22 fill=%22%231F7A4D%22/%3E%3C/svg%3E'
	bodyClass='sh sh-home'
>
	<script slot='head' type='application/ld+json' set:html={JSON.stringify(jsonLd)} />

	<Nav cartaHref={carta} homeHref={base} />

	<main>
		<!-- ================= HERO ================= -->
		<section class='hero' id='inicio'>
			<div class='wrap hero__grid'>
				<div class='hero__copy'>
					<span class='eyebrow hero__eyebrow'>Cafetería healthy · Carretera de Cádiz, Málaga</span>
					<h1 class='display hero__title'>
						<span class='visually-hidden'>Shanao Café: </span>
						<span class='hero__line'><span class='hero__line-in'>Come sano,</span></span>
						<span class='hero__line'>
							<span class='hero__line-in'><span class='serif-i'>vive feliz.</span><Leaf class='hero__title-leaf' size='0.62em' /></span>
						</span>
					</h1>
					<p class='hero__lead'>
						Desayunos, bowls, zumos recién licuados y café de especialidad. Con opciones veganas y sin gluten, y
						platos que en vez de número tienen nombre.
					</p>
					<div class='hero__ctas'>
						<a class='btn' href={carta}>
							Ver la carta
							<Icon name='arrow' size={18} />
						</a>
						<a class='btn btn--ghost' href={info.mapsUrl} target='_blank' rel='noopener'>Cómo llegar</a>
					</div>
					<div class='hero__proof'>
						<a class='hero__rating' href={info.mapsUrl} target='_blank' rel='noopener' aria-label='4,5 estrellas en Google, 2.186 reseñas'>
							<span class='hero__rating-num'>4,5</span>
							<span class='hero__rating-body'>
								<span class='hero__rating-stars' aria-hidden='true'>★★★★★</span>
								<span class='hero__rating-txt'>2.186 reseñas en Google</span>
							</span>
						</a>
						<span class='hero__sep' aria-hidden='true'></span>
						<span class='hero__open' data-open-status>
							<span class='open-dot'></span>
							<span data-open-text>Todos los días · 8:00–20:30</span>
						</span>
					</div>
				</div>

				<div class='hero__visual'>
					<div class='hero__frame'>
						{heroSlides.map((sl, i) => (
							<Image class={i === 0 ? 'hero__slide is-on' : 'hero__slide'} src={sl.img} alt={sl.alt} widths={[560, 860, 1200]} sizes='(max-width: 960px) 90vw, 44vw' loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
						))}
						<div class='hero__caption'>
							{heroSlides.map((sl, i) => (
								<span class={i === 0 ? 'hero__cap is-on' : 'hero__cap'}>
									<strong>{sl.name}</strong>
									<span>{sl.kind}</span>
								</span>
							))}
						</div>
					</div>

					<div class='hero__badge' aria-hidden='true'>
						<svg class='hero__badge-ring' viewBox='0 0 200 200'>
							<defs><path id='hero-ring' d='M100,26 a74,74 0 1,1 0,148 a74,74 0 1,1 0,-148' /></defs>
							<text><textPath href='#hero-ring' textLength='462' lengthAdjust='spacing'>come sano · vive feliz · shanao café ·</textPath></text>
						</svg>
						<Leaf class='hero__badge-leaf' size={46} />
					</div>
				</div>
			</div>
		</section>

		<!-- ================= MARQUEE ================= -->
		<div class='marquee-wrap'>
		<div class='marquee' aria-hidden='true'>
			<div class='marquee__track'>
				{[0, 1].map(() => (
					<div class='marquee__group'>
						{marquee.map((w) => (
							<>
								<span>{w}</span>
								<Leaf size={26} class='marquee__leaf' />
							</>
						))}
					</div>
				))}
			</div>
		</div>
		</div>

		<!-- ================= UN DÍA EN SHANAO ================= -->
		<section class='day' id='dia'>
			<div class='wrap'>
				<header class='sec-head'>
					<span class='eyebrow'>Un día en Shanao</span>
					<h2 class='display sec-title'>De 8:00 a 20:30, <span class='serif-i'>siempre hay plan.</span></h2>
				</header>
			</div>
			<div class='day__rail wrap'>
				<div class='day__line' aria-hidden='true'>
					<span class='day__progress'></span>
					<span class='day__sun'><Icon name='sun' size={26} /></span>
				</div>
				<ol class='day__stops'>
					{day.map((d) => (
						<li class='stop'>
							<span class='stop__dot' aria-hidden='true'></span>
							<span class='stop__time display'>{d.t}</span>
							<div class='stop__img'><Image src={d.img} alt='' width={360} /></div>
							<h3 class='stop__title'>{d.title}</h3>
							<p class='stop__text'>{d.text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<!-- ================= PILLARS ================= -->
		<section class='pillars wrap' id='concepto'>
			<header class='sec-head'>
				<span class='eyebrow'>Nuestra filosofía</span>
				<h2 class='display sec-title'>Comida rica que <span class='serif-i'>te sienta</span> bien.</h2>
			</header>
			<div class='pillars__grid'>
				{pillars.map((p) => (
					<article class='pillar' style={`--c:${p.color}`}>
						<span class='pillar__n'>{p.n}</span>
						<h3 class='pillar__title'>{p.title}</h3>
						<p>{p.text}</p>
						<Leaf size={120} class='pillar__leaf' />
					</article>
				))}
			</div>
		</section>

		<!-- ================= STORY (horizontal) ================= -->
		<section class='story' id='historia'>
			<div class='story__intro wrap'>
				<span class='eyebrow'>Una carta con historia</span>
				<h2 class='display sec-title'>Aquí los platos <span class='serif-i'>no tienen número</span>. Tienen nombre.</h2>
				<p class='story__hint'>Desliza <span aria-hidden='true'>→</span></p>
			</div>
			<div class='story__pin'>
				<div class='story__track'>
					{story.map((s, idx) => (
						<a class='panel' href={`${carta}#${s.id}`} style={`--bg:${s.bg};--ink:${s.ink}`}>
							<div class='panel__top'>
								<span class='panel__idx'>{String(idx + 1).padStart(2, '0')} / {String(story.length).padStart(2, '0')}</span>
								<span class='panel__what'>{s.what}</span>
							</div>
							<h3 class='panel__word display'>{s.word}</h3>
							<div class:list={['panel__media', { 'panel__media--blend': s.blend }]}>
								<Image src={s.img} alt='' widths={[400, 700]} sizes='(max-width: 900px) 60vw, 32vw' />
							</div>
							<div class='panel__bottom'>
								<p class='panel__line'>{s.line}</p>
								<ul class='panel__names'>
									{s.names.map((n) => <li>{n}</li>)}
								</ul>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- ================= FEATURED (sticky stack) ================= -->
		<section class='featured wrap' id='favoritos'>
			<header class='sec-head sec-head--center'>
				<span class='eyebrow'>Los favoritos</span>
				<h2 class='display sec-title'>Lo que <span class='serif-i'>todo el mundo</span> pide.</h2>
			</header>
			<div class='stack'>
				{featured.map((f, idx) => (
					<article class='card' style={`--bg:${f.bg};--ink:${f.ink};--i:${idx}`}>
						<div class='card__copy'>
							<span class='card__kind'>{f.kind}</span>
							<h3 class='card__name display'>{f.name}</h3>
							<p class='card__desc'>{f.desc}</p>
							<div class='card__foot'>
								<span class='card__price'>{f.price} €</span>
								<span class='card__tag'>{f.tag}</span>
							</div>
						</div>
						<div class='card__media'>
							<Image src={f.img} alt={`${f.kind} ${f.name} de Shanao Café`} widths={[500, 900]} sizes='(max-width: 900px) 90vw, 50vw' />
						</div>
					</article>
				))}
			</div>
			<div class='featured__cta'>
				<a class='btn btn--leaf' href={carta}>
					Ver la carta completa
					<Icon name='arrow' size={18} />
				</a>
			</div>
		</section>

		<!-- ================= LOCAL ================= -->
		<section class='local' id='local'>
			<div class='wrap local__grid'>
				<div class='local__media'>
					<div class='local__reveal'>
						<Image src={imgTeam} alt='El equipo de Shanao Café, con su perro, en la puerta del local' widths={[600, 1000]} sizes='(max-width: 900px) 92vw, 50vw' />
					</div>
					<div class='local__mini local__mini--a'><Image src={imgCrunchy} alt='' width={320} /></div>
					<div class='local__mini local__mini--b'><Image src={imgPlato} alt='' width={320} /></div>
				</div>
				<div class='local__copy'>
					<span class='eyebrow'>El local</span>
					<h2 class='display sec-title'>Verde, colorido <span class='serif-i'>y con alma.</span></h2>
					<p class='local__text'>
						Ladrillo visto, banderines de ganchillo, plantas, libros y pizarras pintadas a mano. Un rincón de
						Carretera de Cádiz donde desayunar sin prisa, teletrabajar con un matcha o parar de camino a la playa.
					</p>
					<ul class='feats'>
						{features.map((f) => (
							<li class='feat' style={`--fbg:${f.bg}`}>
								<span class='feat__icon'><Icon name={f.icon} size={22} /></span>
								<span class='feat__body'>
									<strong>{f.title}</strong>
									<span>{f.text}</span>
								</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<!-- ================= REVIEWS ================= -->
		<section class='reviews' id='opiniones'>
			<div class='wrap reviews__head'>
				<span class='eyebrow'>Opiniones</span>
				<h2 class='display sec-title'><span class='count'><span class='count__ghost' aria-hidden='true'>2.186</span><span class='count__val' data-count='2186'>2.186</span></span> personas <span class='serif-i'>ya lo saben.</span></h2>
				<div class='reviews__score'>
					<span class='reviews__stars' aria-hidden='true'>★★★★★</span>
					<span><strong>{String(info.rating).replace('.', ',')}</strong> en Google Maps</span>
				</div>
			</div>
			<div class='reviews__rail' aria-label='Reseñas de clientes'>
				<div class='reviews__track'>
					{[...info.reviewsList, ...info.reviewsList].map((r, idx) => (
						<figure class='review' aria-hidden={idx >= info.reviewsList.length ? 'true' : undefined}>
							<span class='review__stars' aria-hidden='true'>★★★★★</span>
							<blockquote>«{r.text}»</blockquote>
							<figcaption>{r.author}</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<!-- ================= VISIT ================= -->
		<section class='visit wrap' id='visitanos'>
			<div class='visit__card'>
				<div class='visit__copy'>
					<span class='eyebrow eyebrow--light'>Visítanos</span>
					<h2 class='display visit__title'>Te esperamos <span class='serif-i'>con el café listo.</span></h2>
					<dl class='visit__list'>
						<div>
							<dt>Horario</dt>
							<dd>
								Todos los días<br /><strong>8:00 – 20:30</strong>
								<span class='visit__now' data-open-status><span class='open-dot'></span><span data-open-text></span></span>
							</dd>
						</div>
						<div>
							<dt>Dirección</dt>
							<dd>{info.address}<br />{info.postalCode} {info.city}</dd>
						</div>
						<div>
							<dt>Teléfono</dt>
							<dd><a href={info.phoneHref}>{info.phone}</a></dd>
						</div>
						<div>
							<dt>Síguenos</dt>
							<dd><a href={info.instagram} target='_blank' rel='noopener'>{info.instagramHandle}</a></dd>
						</div>
					</dl>
					<div class='visit__ctas'>
						<a class='btn btn--light' href={info.mapsUrl} target='_blank' rel='noopener'>
							Abrir en Google Maps
							<Icon name='arrow' size={18} />
						</a>
						<a class='btn btn--ghost-light' href={info.phoneHref}>Llamar</a>
					</div>
				</div>
				<div class='visit__map'>
					<iframe title='Mapa: Shanao Café en Google Maps' src={info.mapsEmbed} loading='lazy' referrerpolicy='no-referrer-when-downgrade' allowfullscreen></iframe>
				</div>
			</div>
		</section>
	</main>

	<Footer cartaHref={carta} homeHref={base} />
</DemoLayout>

<style is:global>
	/* ================= HERO ================= */
	.sh .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
	.sh-home .hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding: clamp(104px, 13vh, 140px) 0 clamp(40px, 6vh, 72px);
		background:
			radial-gradient(55% 65% at 85% 35%, rgba(200, 230, 160, 0.6), transparent 70%),
			radial-gradient(40% 50% at 5% 100%, rgba(255, 178, 63, 0.14), transparent 70%),
			var(--paper);
		overflow: hidden;
	}
	.sh-home .hero::after {
		content: '';
