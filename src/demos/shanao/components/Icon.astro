---
/** Iconos de línea propios (24×24, stroke = currentColor). */
interface Props {
	name: 'paw' | 'bag' | 'leaf' | 'wheat' | 'star' | 'search' | 'sun' | 'arrow' | 'close' | 'pin' | 'clock' | 'phone';
	size?: number;
	class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props as Props;
---

<svg
	class={cls}
	width={size}
	height={size}
	viewBox='0 0 24 24'
	fill='none'
	stroke='currentColor'
	stroke-width='1.8'
	stroke-linecap='round'
	stroke-linejoin='round'
	aria-hidden='true'
>
	{name === 'paw' && (
		<>
			<ellipse cx='12' cy='16.5' rx='4.2' ry='3.6' />
			<circle cx='6' cy='11' r='1.8' />
			<circle cx='18' cy='11' r='1.8' />
			<circle cx='9.2' cy='6.6' r='1.8' />
			<circle cx='14.8' cy='6.6' r='1.8' />
		</>
	)}
	{name === 'bag' && (
		<>
			<path d='M5 8h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8Z' />
			<path d='M9 10V6.5a3 3 0 0 1 6 0V10' />
		</>
	)}
	{name === 'leaf' && (
		<>
			<path d='M20 4C10 4 4 9 4 15c0 2.8 2 5 5 5 6 0 11-6 11-16Z' />
			<path d='M4 20c4-5 8-8 12-11' />
		</>
	)}
	{name === 'wheat' && (
		<>
			<path d='M12 21V8' />
			<path d='M12 8c-2.5 0-3.5-2-3.5-4 2.5 0 3.5 2 3.5 4Zm0 0c2.5 0 3.5-2 3.5-4-2.5 0-3.5 2-3.5 4Z' />
			<path d='M12 13c-2.5 0-4-1.8-4-4 2.5 0 4 1.8 4 4Zm0 0c2.5 0 4-1.8 4-4-2.5 0-4 1.8-4 4Z' />
			<path d='M12 18c-2.5 0-4-1.8-4-4 2.5 0 4 1.8 4 4Zm0 0c2.5 0 4-1.8 4-4-2.5 0-4 1.8-4 4Z' />
		</>
	)}
	{name === 'star' && <path d='m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z' />}
	{name === 'search' && (
		<>
			<circle cx='11' cy='11' r='6.5' />
			<path d='m20 20-4.2-4.2' />
		</>
	)}
	{name === 'sun' && (
		<>
			<circle cx='12' cy='12' r='4' />
			<path d='M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4' />
		</>
	)}
	{name === 'arrow' && <path d='M5 12h14M13 6l6 6-6 6' />}
	{name === 'close' && <path d='M6 6l12 12M18 6 6 18' />}
	{name === 'pin' && (
		<>
			<path d='M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z' />
			<circle cx='12' cy='9.5' r='2.5' />
		</>
	)}
	{name === 'clock' && (
		<>
			<circle cx='12' cy='12' r='8.5' />
			<path d='M12 7.5V12l3 2' />
		</>
	)}
	{name === 'phone' && <path d='M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z' />}
</svg>
