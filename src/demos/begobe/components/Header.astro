---
/** Cabecera + menú móvil compartidos por la landing y la carta. */
import { Image } from 'astro:assets';
import T from './T.astro';
import Icon from './Icon.astro';
import Picker from './Picker.astro';
import { venues, info } from '../data/info';
import logoWordNavy from '../../../assets/demos/begobe/logo-word-navy.png';
import logoWordCream from '../../../assets/demos/begobe/logo-word-cream.png';

interface Props {
	/** Prefijo de los enlaces a la landing ('' en la landing, '/demo/begobe' en la carta) */
	base?: string;
	/** Cabecera crema siempre visible (carta) */
	solid?: boolean;
}
const { base = '', solid = false } = Astro.props as Props;

const nav = [
	{ href: `${base}#obrador`, es: 'Obrador', en: 'Bakery' },
	{ href: `${base}#carta`, es: 'Carta', en: 'Menu' },
	{ href: `${base}#reservar`, es: 'Reservar', en: 'Book' },
	{ href: `${base}#cumples`, es: 'Cumples', en: 'Parties' },
	{ href: `${base}#locales`, es: 'Locales', en: 'Locations' },
];
const home = base || '#top';
---

<header class='bgb-nav' data-nav data-solid={solid ? '' : undefined}>
	<a class='bgb-nav__brand' href={solid ? '/demo/begobe' : home} aria-label='Begobé, inicio'>
		<Image src={logoWordCream} alt='' width={236} class='bgb-nav__logo bgb-nav__logo--light' loading='eager' />
		<Image src={logoWordNavy} alt='' width={236} class='bgb-nav__logo bgb-nav__logo--dark' loading='eager' />
	</a>
	<nav class='bgb-nav__links' aria-label='Secciones'>
		{nav.map((l) => <a href={l.href}><T es={l.es} en={l.en} /></a>)}
	</nav>
	<div class='bgb-nav__end'>
		<div class='bgb-lang' role='group' aria-label='Idioma / Language'>
			<button type='button' data-set-lang='es' aria-pressed='true'>ES</button>
			<button type='button' data-set-lang='en' aria-pressed='false'>EN</button>
		</div>
		<Picker />
		<button type='button' class='bgb-burger' data-menu-toggle aria-expanded='false' aria-controls='bgb-menu'>
			<span class='bgb-sr'><T es='Abrir menú' en='Open menu' /></span>
			<span class='bgb-burger__lines' aria-hidden='true'></span>
		</button>
	</div>
</header>

<div class='bgb-menu' id='bgb-menu' data-menu aria-hidden='true'>
	<nav class='bgb-menu__links' aria-label='Menú'>
		{nav.map((l) => <a href={l.href}><T es={l.es} en={l.en} /></a>)}
	</nav>
	<div class='bgb-menu__cartas'>
		<p class='bgb-hand'><T es='¿Qué te apetece? Mira la carta:' en='Hungry? Check the menu:' /></p>
		{venues.map((v) => (
			<a class='bgb-menu__carta' href={`/demo/begobe/carta/${v.id}`}>
				<span>
					<strong>{v.short}</strong>
					<span class='bgb-status' data-open-status data-venue={v.id}><i></i><span data-open-text>{v.hours}</span></span>
				</span>
				<Icon name='arrow' />
			</a>
		))}
	</div>
	<div class='bgb-menu__foot'>
		<div class='bgb-lang bgb-lang--light' role='group' aria-label='Idioma / Language'>
			<button type='button' data-set-lang='es' aria-pressed='true'>ES</button>
			<button type='button' data-set-lang='en' aria-pressed='false'>EN</button>
		</div>
		<a href={info.instagram} target='_blank' rel='noopener' class='bgb-menu__ig'><Icon name='instagram' /> {info.handle}</a>
	</div>
</div>
