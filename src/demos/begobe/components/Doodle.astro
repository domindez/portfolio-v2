---
/** Bocetos a mano alzada que se "dibujan" (pathLength=1 para el trazo animado). */
interface Props {
	name: 'arrow' | 'heart';
	class?: string;
}
const { name, class: cls = '' } = Astro.props as Props;
const vb = name === 'heart' ? '0 0 40 36' : '0 0 80 40';
---

<svg
	class={`bgb-doodle ${cls}`.trim()}
	viewBox={vb}
	fill='none'
	stroke='currentColor'
	stroke-width='2.4'
	stroke-linecap='round'
	stroke-linejoin='round'
	aria-hidden='true'
>
	{
		name === 'arrow' && (
			<>
				<path pathLength='1' d='M4 30c14-22 36-26 66-14' />
				<path pathLength='1' d='M58 8l13 8-10 10' />
			</>
		)
	}
	{name === 'heart' && <path pathLength='1' d='M20 32C6 22 4 14 8 9c4-5 11-3 12 3 1-6 8-8 12-3 4 5 2 13-12 23Z' />}
</svg>
