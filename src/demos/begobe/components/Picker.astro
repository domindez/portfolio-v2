---
/** Desplegable "Ver carta": elige entre los dos locales (estilo carta: nombre ····· estado). */
import T from './T.astro';
import Icon from './Icon.astro';
import { venues } from '../data/info';

interface Props {
	/** Clases del botón (p. ej. "bgb-btn bgb-btn--sm" o "bgb-cta bgb-cta--gold") */
	btnClass?: string;
	label?: { es: string; en: string };
}
const { btnClass = 'bgb-btn bgb-btn--sm', label = { es: 'Ver carta', en: 'Menu' } } = Astro.props as Props;
---

<div class='bgb-picker' data-picker>
	<button type='button' class={btnClass} data-picker-btn aria-expanded='false' aria-haspopup='true'>
		<T es={label.es} en={label.en} />
		<Icon name='chevron' size={16} />
	</button>
	<div class='bgb-picker__pop' role='menu'>
		<p class='bgb-picker__t'><T es='Elige tu carta' en='Pick your menu' /></p>
		{venues.map((v) => (
			<a href={`/demo/begobe/carta/${v.id}`} role='menuitem' class='bgb-picker__opt'>
				<span class='bgb-picker__name'>{v.short}</span>
				<span class='bgb-picker__dots' aria-hidden='true'></span>
				<Icon name='arrow' size={18} class='bgb-picker__go' />
			</a>
		))}
	</div>
</div>
