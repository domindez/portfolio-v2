---
/** Estado "Abierto · hasta las 23:30" — el texto lo calcula scripts/common.ts en hora de Madrid. */
import T from './T.astro';
import { hoursAttr, type Venue } from '../data/info';

interface Props {
	venue: Venue;
	class?: string;
}
const { venue, class: cls = '' } = Astro.props;
---

<span class={`pp-status ${cls}`} data-open-status data-hours={hoursAttr(venue)}>
	<span data-open-text><T es='Ver horario' en='See hours' /></span>
</span>
