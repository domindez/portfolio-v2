		</>
	)}
	{name === 'ticket' && (
		<>
			<path d='M3 7.5V5h18v2.5a2.5 2.5 0 0 0 0 5V19H3v-6.5a2.5 2.5 0 0 0 0-5Z' />
			<path d='M14.5 5v2M14.5 10.5v3M14.5 17v2' />
		</>
	)}
	{name === 'instagram' && (
		<>
			<rect x='3' y='3' width='18' height='18' rx='5' />
			<circle cx='12' cy='12' r='4' />
