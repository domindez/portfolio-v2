	{name === 'close' && <path d='M6 6l12 12M18 6 6 18' />}
	{name === 'film' && (
		<>
			<rect x='3' y='3' width='18' height='18' rx='1.5' />
			<path d='M7 3v18M17 3v18M3 7.5h4M3 12h4M3 16.5h4M17 7.5h4M17 12h4M17 16.5h4' />
		</>
	)}
