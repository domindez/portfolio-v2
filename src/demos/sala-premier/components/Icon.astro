---
/** Iconos de línea fina "grabado" (24×24, stroke = currentColor, 1.5px). */
interface Props {
	name:
		| 'beer'
		| 'cocktail'
		| 'dice'
		| 'screen'
		| 'note'
		| 'pin'
		| 'clock'
		| 'phone'
		| 'mail'
		| 'arrow'
		| 'ticket'
		| 'instagram'
		| 'facebook'
		| 'menu'
		| 'close'
		| 'film';
	size?: number;
	class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props as Props;
---

