---
import '@fontsource-variable/cinzel/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import './sala-premier.css';
import { Image } from 'astro:assets';
import DemoLayout from '../../layouts/DemoLayout.astro';
import Icon from './components/Icon.astro';
import { venues, week, cocktails, offers, marquee, info } from './data/info';

import imgWordmark from '../../assets/demos/sala-premier/wordmark.png';
import imgEmblema from '../../assets/demos/sala-premier/emblema.png';
import imgFachada from '../../assets/demos/sala-premier/fachada-centro.jpg';
import imgSalon from '../../assets/demos/sala-premier/salon-grupo.jpg';
import imgVentana from '../../assets/demos/sala-premier/ventana-reloj.jpg';
import imgMesas from '../../assets/demos/sala-premier/mesas.jpg';
import imgCoctel from '../../assets/demos/sala-premier/coctel.jpg';
import imgCocteles from '../../assets/demos/sala-premier/cocteles.jpg';
import imgNoche from '../../assets/demos/sala-premier/noche.jpg';
import imgHalloween from '../../assets/demos/sala-premier/halloween.jpg';
import imgNavidad from '../../assets/demos/sala-premier/navidad.jpg';
import imgTrivial from '../../assets/demos/sala-premier/trivial-telon.jpg';
import imgTandem from '../../assets/demos/sala-premier/tandem.jpg';
import imgCalle from '../../assets/demos/sala-premier/calle-centro.jpg';
import imgMarco1 from '../../assets/demos/sala-premier/marco-1.jpg';
import imgMarco2 from '../../assets/demos/sala-premier/marco-2.jpg';
import imgMarco3 from '../../assets/demos/sala-premier/marco-3.jpg';
import imgAmb1 from '../../assets/demos/sala-premier/ambiente-1.jpg';
import imgAmb2 from '../../assets/demos/sala-premier/ambiente-2.jpg';
import imgAmb3 from '../../assets/demos/sala-premier/ambiente-3.jpg';
import imgAmb4 from '../../assets/demos/sala-premier/ambiente-4.jpg';
import imgAmb5 from '../../assets/demos/sala-premier/ambiente-5.jpg';
import imgAmb6 from '../../assets/demos/sala-premier/ambiente-6.jpg';
import imgAmb9 from '../../assets/demos/sala-premier/ambiente-9.jpg';

const venuePhotos: Record<string, { img: ImageMetadata; alt: string }> = {
	centro: { img: imgFachada, alt: 'Fachada iluminada de Premier Centro con la Catedral de Málaga al fondo' },
	teatinos: { img: imgAmb4, alt: 'Pareja brindando junto al piano en Premier Teatinos' },
	huelin: { img: imgVentana, alt: 'Rincón con ventana redonda y reloj antiguo en Premier Huelin' },
	granada: { img: imgAmb5, alt: 'Dos amigas en un palco tapizado de Premier Granada' },
};

const seasons = [
	{ img: imgHalloween, kicker: 'Octubre', title: 'Halloween Premier', text: 'La noche más terrorífica del año. Disfraces, sustos y cócteles de sangre.', alt: 'Cliente disfrazado de payaso con un cóctel rojo en Halloween' },
	{ img: imgTrivial, kicker: 'Especial', title: 'Trivial Festival de Cine', text: 'Dos días, dos salas: la edición más peliculera de nuestro trivial.', alt: 'Cartel del Trivial Especial con telón rojo y el emblema de Sala Premier' },
	{ img: imgNavidad, kicker: 'Diciembre', title: 'Navidad en Premier', text: 'Árbol, luces y la barra más festiva del centro de Málaga.', alt: 'Camarera vestida de Mamá Noel junto al árbol de Navidad del local' },
	{ img: imgTandem, kicker: 'Cada jueves', title: 'Intercambio de idiomas', text: 'Con Málaga Tandem Club. Todos los niveles, todos los idiomas.', alt: 'Cartel luminoso de Málaga Tandem Club sobre una mesa del pub' },
	{ img: imgNoche, kicker: '17 de marzo', title: 'St. Patrick’s Day', text: 'Nuestro día grande: pintas, música irlandesa y verde hasta el cierre.', alt: 'Tres amigas haciéndose un selfie en una noche llena del pub' },
];

const igGrid = [
	{ img: imgAmb1, alt: 'Clientes bailando en la barra' },
	{ img: imgMarco2, alt: 'Foto en blanco y negro enmarcada en dorado' },
	{ img: imgAmb2, alt: 'Grupo brindando entre cuadros de cine' },
	{ img: imgCalle, alt: 'Calle Molina Lario con luces de Navidad y la fachada de Premier' },
	{ img: imgAmb9, alt: 'Pareja sonriendo bajo las pantallas' },
	{ img: imgAmb6, alt: 'Amigos alrededor de una mesa redonda' },
];

const features = [
	{ icon: 'beer', title: 'Pintas de verdad', text: 'Barril, artesanas, nacionales y de importación.' },
	{ icon: 'cocktail', title: 'Cócteles de película', text: 'Una carta con nombre de clásico del cine.' },
	{ icon: 'dice', title: 'Juegos de mesa', text: 'Pídelos en barra y monta tu propia partida.' },
	{ icon: 'screen', title: 'Deportes en directo', text: 'Todos los partidos en pantalla grande.' },
] as const;

const base = '/demo/sala-premier';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: info.name,
	slogan: info.tagline,
	sameAs: [info.instagram, info.facebook],
	subOrganization: venues.map((v) => ({
		'@type': 'BarOrPub',
		name: `Sala ${v.name}`,
		telephone: `+34${v.phone.replace(/\s/g, '')}`,
		email: v.email,
		address: { '@type': 'PostalAddress', streetAddress: v.address, addressLocality: v.city, addressCountry: 'ES' },
	})),
};

// Fechas de los tickets con la fecha del build; el script las corrige al día de hoy.
const fmtMon = new Intl.DateTimeFormat('es-ES', { month: 'short' });
const today = new Date();
const nextDate = (d: number) => {
	const t = new Date(today);
	t.setDate(today.getDate() + ((d - today.getDay() + 7) % 7));
	return t;
};
---

<DemoLayout
	title='Sala Premier · Un pub irlandés de película · Málaga y Granada'
	description='Cuatro salas en Málaga y Granada con decoración de cine: pintas, cócteles de película, trivial, deportes en directo y el mejor ambiente de la noche.'
	themeColor='#0d0909'
	ogImage='/demo-og/sala-premier.jpg'
	ogImageAlt='Sala Premier: un pub irlandés de película en Málaga y Granada.'
	siteName='Sala Premier'
	favicon='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%230d0909%22/%3E%3Cellipse cx=%2232%22 cy=%2232%22 rx=%2222%22 ry=%2226%22 fill=%22none%22 stroke=%22%23d1a650%22 stroke-width=%223%22 stroke-dasharray=%223 2%22/%3E%3Ctext x=%2232%22 y=%2243%22 font-family=%22Georgia,serif%22 font-size=%2232%22 text-anchor=%22middle%22 fill=%22%23d1a650%22%3EP%3C/text%3E%3C/svg%3E'
	bodyClass='sp'
>
	<script slot='head' type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
	<script slot='head' is:inline>
		document.documentElement.classList.add('sp-js');
	</script>

	<a class='sp-skip' href='#cartelera'>Saltar al contenido</a>

	<!-- ================= NAV ================= -->
	<header class='nav' data-nav>
		<div class='nav__inner'>
			<a class='nav__logo' href={base} aria-label='Sala Premier, inicio'>
				<Image src={imgWordmark} alt='' width={160} densities={[1, 2]} loading='eager' />
			</a>
			<nav class='nav__links' aria-label='Principal'>
				<a href='#cartelera'>Cartelera</a>
				<a href='#salas'>Salas</a>
				<a href='#barra'>La barra</a>
				<a href='#temporada'>Temporada</a>
				<a href='#celebraciones'>Celebraciones</a>
			</nav>
			<a class='sp-btn sp-btn--telon nav__cta' href='#reservas'>Reservar</a>
			<button class='nav__toggle' type='button' aria-expanded='false' aria-controls='nav-drawer' data-nav-toggle>
				<span class='visually-hidden'>Abrir menú</span>
				<Icon name='menu' size={26} />
			</button>
		</div>
		<div class='nav__drawer' id='nav-drawer' data-nav-drawer hidden>
			<a href='#cartelera'>Cartelera</a>
			<a href='#salas'>Las salas</a>
			<a href='#barra'>La barra</a>
			<a href='#temporada'>Temporada</a>
			<a href='#celebraciones'>Celebraciones</a>
			<a class='sp-btn sp-btn--telon' href='#reservas'>Reservar mesa</a>
		</div>
	</header>

	<main>
		<!-- ================= TELÓN / HERO ================= -->
		<section class='stage' id='inicio' aria-label='Sala Premier'>
			<div class='stage__pin'>
				<div class='stage__bg'>
					<Image src={imgFachada} alt='' widths={[800, 1280, 1800]} sizes='100vw' loading='eager' fetchpriority='high' />
				</div>

				<div class='stage__content'>
					<p class='sp-eyebrow stage__eyebrow'>Málaga · Granada · Cuatro salas</p>
					<div class='marquee-sign'>
						<div class='bulbs bulbs--top' aria-hidden='true'>{Array.from({ length: 15 }, () => <span class='bulb' />)}</div>
						<h1 class='marquee-sign__title'>
							<Image src={imgWordmark} alt='Sala Premier' width={900} densities={[1, 2]} loading='eager' class='marquee-sign__logo' />
						</h1>
						<div class='bulbs bulbs--bottom' aria-hidden='true'>{Array.from({ length: 15 }, () => <span class='bulb' />)}</div>
					</div>
					<p class='stage__tagline'>Un pub irlandés <em>de película.</em></p>
					<p class='stage__lead'>Pintas, cócteles con nombre de clásico, trivial, partidos y el ambientazo que buscas. Se levanta el telón a las 12:00h.</p>
					<div class='stage__ctas'>
						<a class='sp-btn sp-btn--telon' href='#reservas'><Icon name='ticket' size={18} />Reservar mesa</a>
						<a class='sp-btn sp-btn--fantasma' href='#cartelera'>Ver cartelera</a>
					</div>
				</div>

				<canvas class='curtain-gl' aria-hidden='true' data-curtain></canvas>
				<div class='curtain-badge' aria-hidden='true'>
					<Image src={imgEmblema} alt='' width={220} densities={[1, 2]} loading='eager' />
					<span>Desliza para levantar el telón</span>
				</div>
				<div class='stage__floor' aria-hidden='true'></div>
			</div>
		</section>

		<!-- ================= MARQUESINA ================= -->
		<div class='ticker' aria-label='Lo que pasa en Premier'>
			<div class='ticker__track'>
				{[0, 1].map((k) => (
					<div class='ticker__group' aria-hidden={k === 1 ? 'true' : undefined}>
						{marquee.map((m) => (
							<>
								<span>{m}</span>
								<i>✱</i>
							</>
						))}
					</div>
				))}
			</div>
		</div>

		<!-- ================= CARTELERA ================= -->
		<section class='section cartelera' id='cartelera'>
			<div class='wrap'>
				<header class='sec-head'>
					<p class='sp-eyebrow'>Cartelera</p>
					<h2 class='display-l'>Esta semana en Premier</h2>
					<p class='entradilla'>Cada noche tiene su función. Elige la tuya y te guardamos la mejor mesa.</p>
				</header>

				<div class='cartelera__grid'>
					<div class='cartelera__today'>
						<div class='sp-cartel' data-today>
							<div class='sp-cartel__head'><span>✱</span>TO-DAY<span>✱</span></div>
							<div class='sp-cartel__card'>
								<p class='sp-cartel__when' data-today-when>Esta noche</p>
								<p class='sp-cartel__what' data-today-what>Día de la Cerveza</p>
								<p class='sp-cartel__detail' data-today-detail>Precios especiales en barril e importación</p>
								<p class='sp-cartel__time' data-today-venue>Todas las salas</p>
							</div>
						</div>
						<p class='cartelera__note'>Programación orientativa: cada sala anuncia sus especiales en Instagram.</p>
					</div>

					<ol class='tickets' data-tickets>
						{week.map((s) => {
							const d = nextDate(s.day);
							return (
								<li class='sp-ticket' data-day={s.day}>
									<div class='sp-ticket__date'>
										<span class='sp-ticket__dow'>{s.dayName.slice(0, 3)}</span>
										<span class='sp-ticket__day' data-num>{d.getDate()}</span>
										<span class='sp-ticket__mon' data-mon>{fmtMon.format(d).replace('.', '')}</span>
									</div>
									<div class='sp-ticket__info'>
										<p class='sp-ticket__title'>{s.title}</p>
										<p class='sp-ticket__meta'>{s.detail}</p>
										<p class='sp-ticket__venue'>
											<Icon name='pin' size={15} />
											{s.venue}
											<span class='sp-chip sp-chip--hoy' data-hoy hidden>Hoy</span>
											{s.tag && <span class='sp-chip'>{s.tag}</span>}
										</p>
									</div>
									<div class='sp-ticket__cta'>
										<a class='sp-btn sp-btn--fantasma sp-btn--s' href='#reservas' data-book={s.dayName}>Reservar</a>
									</div>
								</li>
							);
						})}
					</ol>
				</div>
			</div>
		</section>

		<!-- ================= LA EXPERIENCIA ================= -->
		<section class='section experiencia' id='experiencia'>
			<div class='wrap experiencia__grid'>
				<div class='experiencia__copy'>
					<p class='sp-eyebrow'>La experiencia</p>
					<blockquote class='cita'>
						«Entras a tomar una pinta y acabas dentro de una película.»
					</blockquote>
					<p class='body-l'>
						Con una decoración inspirada en el maravilloso mundo del cine y la televisión, Premier se parece a un pub irlandés…
						pero con un giro original. Puertas redondas, relojes antiguos, butacas de terciopelo, cuadros de estrellas de cine
						y una barra donde siempre está a punto de empezar algo.
					</p>
					<ul class='features'>
						{features.map((f) => (
							<li class='feature'>
								<span class='feature__icon'><Icon name={f.icon} size={26} /></span>
								<span>
									<strong>{f.title}</strong>
									{f.text}
								</span>
							</li>
						))}
					</ul>
					<dl class='stats'>
						<div><dt>Salas</dt><dd data-count='4'>4</dd></div>
						<div><dt>Ciudades</dt><dd data-count='2'>2</dd></div>
						<div><dt>Hasta las</dt><dd>3:30<small>h</small></dd></div>
						<div><dt>En Instagram</dt><dd><span data-count={info.followers}>{info.followers.toLocaleString('es-ES')}</span></dd></div>
					</dl>
				</div>
				<div class='experiencia__media'>
					<figure class='arch arch--tall' data-parallax='-6'>
						<Image src={imgSalon} alt='Grupo de amigos en una mesa redonda del salón principal, con paredes ocres y lámparas antiguas' widths={[480, 760, 1100]} sizes='(max-width: 960px) 80vw, 520px' />
					</figure>
					<figure class='arch arch--small' data-parallax='10'>
						<Image src={imgMesas} alt='Amigas en una mesa bajo guirnaldas de luces' widths={[360, 600]} sizes='(max-width: 960px) 46vw, 300px' />
					</figure>
					<div class='seal' aria-hidden='true'>
						<svg class='seal__ring' viewBox='0 0 120 120'>
							<defs><path id='seal-path' d='M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0' /></defs>
							<text><textPath href='#seal-path'>PUB IRLANDÉS · DE PELÍCULA · DESDE MÁLAGA · </textPath></text>
						</svg>
						<Icon name='film' size={30} />
					</div>
				</div>
			</div>
		</section>

		<!-- ================= LAS SALAS ================= -->
		<section class='section salas' id='salas'>
			<div class='wrap'>
				<header class='sec-head sec-head--center'>
					<p class='sp-eyebrow'>Las salas</p>
					<h2 class='display-l'>Cuatro salas. Un mismo estreno.</h2>
					<p class='entradilla'>Tres en Málaga y una en Granada, cada una con su decorado y la misma noche de película.</p>
				</header>
				<div class='salas__grid'>
					{venues.map((v) => (
						<article class='sp-venue'>
							<div class='sp-venue__frame'>
								<Image class='sp-venue__img' src={venuePhotos[v.id].img} alt={venuePhotos[v.id].alt} widths={[360, 560, 800]} sizes='(max-width: 640px) 86vw, (max-width: 1100px) 44vw, 300px' />
							</div>
							<div class='sp-venue__body'>
								<p class='sp-eyebrow'>{v.city} · {v.area}</p>
								<h3 class='sp-venue__name'>{v.name}</h3>
								<p class='sp-venue__meta'><Icon name='pin' size={16} />{v.address}</p>
								<p class='sp-venue__meta'>
									<Icon name='clock' size={16} />
									<span>{v.hours.map((h) => <span class='sp-venue__hour'>{h}</span>)}</span>
								</p>
								<p class='sp-venue__meta'><Icon name='phone' size={16} /><a href={`tel:+34${v.phone.replace(/\s/g, '')}`}>{v.phone}</a></p>
								<div class='sp-venue__links'>
									<a class='sp-venue__link' href={v.maps} target='_blank' rel='noopener'>Cómo llegar</a>
									<a class='sp-venue__link' href='#reservas' data-book-venue={v.id}>Reservar</a>
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ================= LA BARRA ================= -->
		<section class='section barra' id='barra'>
			<div class='wrap barra__grid'>
				<div class='barra__media'>
					<figure class='arch arch--bar' data-parallax='-5'>
						<Image src={imgCocteles} alt='Dos clientas brindando con cócteles de maracuyá frente a las pantallas' widths={[480, 760, 1100]} sizes='(max-width: 960px) 80vw, 480px' />
					</figure>
					<figure class='frame-gold barra__coctel' data-parallax='12'>
						<Image src={imgCoctel} alt='Cóctel rojo con cerezas y pajita de rayas sobre una mesa con dibujos dorados' widths={[300, 520]} sizes='(max-width: 960px) 44vw, 260px' />
					</figure>
				</div>
				<div class='barra__copy'>
					<header class='sec-head'>
						<p class='sp-eyebrow'>La barra</p>
						<h2 class='display-l'>Cócteles de película</h2>
						<p class='entradilla'>Cada copa lleva el nombre de un clásico. Las pintas, el de la casa.</p>
					</header>
					<ul class='programa'>
						{cocktails.map((c) => (
							<li class='programa__item'>
								<div class='programa__row'>
									<h3 class='programa__name'>{c.name}</h3>
									<span class='programa__dots' aria-hidden='true'></span>
									<span class='programa__price'>{c.price} €</span>
								</div>
								<p class='programa__desc'>{c.desc}</p>
							</li>
						))}
					</ul>
				</div>
			</div>
			<div class='wrap'>
				<ul class='vales'>
					{offers.map((o) => (
						<li class='vale'>
							<span class='vale__big'>{o.big}</span>
							<span class='vale__text'>{o.text}</span>
							<span class='vale__note'>{o.note}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- ================= SAL EN EL CUADRO ================= -->
		<section class='section cuadro' id='cuadro'>
			<div class='wrap cuadro__grid'>
				<header class='sec-head'>
					<p class='sp-eyebrow'>Photocall</p>
					<h2 class='display-l'>Sal en el cuadro</h2>
					<p class='entradilla'>Los fines de semana nuestro fotógrafo recorre las salas. Las mejores noches acaban enmarcadas en pan de oro.</p>
					<a class='sp-btn sp-btn--fantasma' href={info.instagram} target='_blank' rel='noopener'><Icon name='instagram' size={18} />Búscate en Instagram</a>
				</header>
				<div class='cuadro__frames'>
					<figure class='cuadro__frame cuadro__frame--1'><Image src={imgMarco1} alt='Pareja retratada en blanco y negro dentro de un marco dorado' widths={[320, 560]} sizes='(max-width: 960px) 44vw, 300px' /></figure>
					<figure class='cuadro__frame cuadro__frame--2'><Image src={imgMarco3} alt='Pareja en la calle retratada en blanco y negro con marco barroco' widths={[320, 560]} sizes='(max-width: 960px) 44vw, 300px' /></figure>
					<figure class='cuadro__frame cuadro__frame--3'><Image src={imgMarco2} alt='Grupo de amigos en blanco y negro con marco dorado' widths={[320, 560]} sizes='(max-width: 960px) 44vw, 300px' /></figure>
				</div>
			</div>
		</section>

		<!-- ================= TEMPORADA ================= -->
		<section class='section temporada' id='temporada'>
			<div class='wrap'>
				<header class='sec-head temporada__head'>
					<div>
						<p class='sp-eyebrow'>Temporada</p>
						<h2 class='display-l'>Noches que se esperan todo el año</h2>
					</div>
					<div class='temporada__nav'>
						<button type='button' class='round-btn' data-season-prev aria-label='Anterior'><Icon name='arrow' size={20} class='flip' /></button>
						<button type='button' class='round-btn' data-season-next aria-label='Siguiente'><Icon name='arrow' size={20} /></button>
					</div>
				</header>
			</div>
			<ul class='posters' data-posters>
				{seasons.map((s) => (
					<li class='poster'>
						<div class='poster__img'>
							<Image src={s.img} alt={s.alt} widths={[360, 600]} sizes='(max-width: 640px) 78vw, 340px' />
						</div>
						<div class='poster__body'>
							<p class='poster__kicker'>{s.kicker}</p>
							<h3 class='poster__title'>{s.title}</h3>
							<p class='poster__text'>{s.text}</p>
						</div>
					</li>
				))}
			</ul>
		</section>

		<!-- ================= CELEBRACIONES ================= -->
		<section class='celebra' id='celebraciones'>
			<div class='wrap celebra__grid'>
				<div class='celebra__copy'>
					<p class='sp-eyebrow sp-eyebrow--claro'>Celebraciones</p>
					<h2 class='display-l'>La vida sabe mejor cuando lo celebras todo</h2>
					<p class='entradilla'>Cumpleaños, despedidas, cenas de empresa o el ascenso de tu equipo: preparamos tu zona, tu música y tus detalles en cualquiera de las salas.</p>
					<ul class='celebra__list'>
						<li>Cumpleaños</li>
						<li>Despedidas</li>
						<li>Empresas</li>
						<li>Grupos y peñas</li>
					</ul>
					<div class='celebra__ctas'>
						<a class='sp-btn sp-btn--oro' href='#reservas' data-book-type='Celebración'>Pedir presupuesto</a>
						<a class='sp-btn sp-btn--claro' href='mailto:centro@salapremier.com?subject=Celebraci%C3%B3n%20en%20Sala%20Premier'><Icon name='mail' size={18} />Escríbenos</a>
					</div>
				</div>
				<figure class='celebra__media frame-gold'>
					<Image src={imgAmb3} alt='Pareja abrazada celebrando en la barra de Sala Premier' widths={[420, 720]} sizes='(max-width: 960px) 80vw, 420px' />
				</figure>
			</div>
		</section>

		<!-- ================= RESERVAS ================= -->
		<section class='section reservas' id='reservas'>
			<div class='wrap reservas__grid'>
				<div class='reservas__panel'>
					<header class='sec-head'>
						<p class='sp-eyebrow'>Reservas</p>
						<h2 class='display-l'>Te guardamos la mejor mesa</h2>
						<p class='entradilla'>Dinos sala, día y cuántos venís. Te confirmamos por WhatsApp.</p>
					</header>
					<form class='form' data-form novalidate>
						<div class='form__row'>
							<label class='field'>
								<span>Sala</span>
								<select name='sala' required data-field-venue>
									{venues.map((v) => <option value={v.id}>{v.name}</option>)}
								</select>
							</label>
							<label class='field'>
								<span>Plan</span>
								<select name='plan' data-field-plan>
									<option>Mesa para tomar algo</option>
									{week.map((s) => <option value={s.dayName}>{s.dayName}: {s.title}</option>)}
									<option value='Celebración'>Celebración / grupo</option>
								</select>
							</label>
						</div>
						<div class='form__row form__row--3'>
							<label class='field'>
								<span>Día</span>
								<input type='date' name='fecha' required data-field-date />
							</label>
							<label class='field'>
								<span>Hora</span>
								<input type='time' name='hora' value='21:00' required />
							</label>
							<label class='field'>
								<span>Personas</span>
								<input type='number' name='personas' min='1' max='60' value='4' required />
							</label>
						</div>
						<div class='form__row'>
							<label class='field'>
								<span>Nombre</span>
								<input type='text' name='nombre' autocomplete='name' required placeholder='¿A nombre de quién?' />
							</label>
							<label class='field'>
								<span>Teléfono</span>
								<input type='tel' name='tel' autocomplete='tel' required placeholder='600 000 000' />
							</label>
						</div>
						<button class='sp-btn sp-btn--telon form__submit' type='submit'><Icon name='ticket' size={18} />Reservar mesa</button>
						<p class='form__msg' role='status' aria-live='polite' data-form-msg></p>
						<p class='form__demo'>Demo: el formulario no envía ninguna reserva real.</p>
					</form>
				</div>

				<aside class='reservas__side'>
					<div class='call'>
						<h3 class='titulo'>¿Prefieres llamar?</h3>
						<ul class='call__list'>
							{venues.map((v) => (
								<li>
									<span>{v.name}</span>
									<a href={`tel:+34${v.phone.replace(/\s/g, '')}`}><Icon name='phone' size={16} />{v.phone}</a>
								</li>
							))}
						</ul>
					</div>
					<div class='ig'>
						<div class='ig__head'>
							<h3 class='titulo'>{info.instagramHandle}</h3>
							<a class='sp-venue__link' href={info.instagram} target='_blank' rel='noopener'>Seguir</a>
						</div>
						<ul class='ig__grid'>
							{igGrid.map((g) => (
								<li>
									<a href={info.instagram} target='_blank' rel='noopener' aria-label={`Ver en Instagram: ${g.alt}`}>
										<Image src={g.img} alt={g.alt} width={260} height={260} densities={[1, 2]} />
									</a>
								</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</section>
	</main>

	<!-- ================= PIE ================= -->
	<footer class='foot'>
		<div class='wrap'>
			<div class='foot__top'>
				<Image src={imgEmblema} alt='Sala Premier' width={200} densities={[1, 2]} class='foot__emblema' />
				<p class='foot__tag'>Noche de estreno, cada noche.</p>
			</div>
			<div class='foot__venues'>
				{venues.map((v) => (
					<div class='foot__venue'>
						<h3>{v.name}</h3>
						<p>{v.address}<br />{v.city}</p>
						<p><a href={`tel:+34${v.phone.replace(/\s/g, '')}`}>{v.phone}</a><br /><a href={`mailto:${v.email}`}>{v.email}</a></p>
					</div>
				))}
			</div>
			<div class='foot__bottom'>
				<div class='foot__social'>
					<a href={info.instagram} target='_blank' rel='noopener' aria-label='Instagram'><Icon name='instagram' size={20} /></a>
					<a href={info.facebook} target='_blank' rel='noopener' aria-label='Facebook'><Icon name='facebook' size={20} /></a>
				</div>
				<p>© {new Date().getFullYear()} Sala Premier · Aviso legal · Cookies · Franquicias</p>
			</div>
		</div>
	</footer>
</DemoLayout>

<script>
	import Lenis from 'lenis';
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { week } from './data/info';
	import { createCurtain } from './scripts/curtain';

	gsap.registerPlugin(ScrollTrigger);
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// ---------- Smooth scroll ----------
	let lenis: Lenis | null = null;
	if (!reduce) {
		lenis = new Lenis({ duration: 1.1, smoothWheel: true });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((t) => lenis?.raf(t * 1000));
		gsap.ticker.lagSmoothing(0);
		document.documentElement.classList.add('lenis');
	}
	const scrollToEl = (el: HTMLElement) => {
		if (lenis) lenis.scrollTo(el, { offset: -70, duration: 1.4 });
		else el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
	};

	// ---------- Nav ----------
	const nav = document.querySelector<HTMLElement>('[data-nav]')!;
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
	const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]')!;
	const setDrawer = (open: boolean) => {
		toggle.setAttribute('aria-expanded', String(open));
		drawer.hidden = !open;
		nav.classList.toggle('is-open', open);
	};
	toggle.addEventListener('click', () => setDrawer(drawer.hidden));
	const stageEl = document.querySelector<HTMLElement>('.stage')!;
	const onScroll = () => {
		const past = window.scrollY > stageEl.offsetHeight - 120;
		nav.classList.toggle('is-solid', past);
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
		a.addEventListener('click', (e) => {
			const id = a.getAttribute('href');
			if (!id || id === '#') return;
			const target = document.querySelector<HTMLElement>(id);
			if (!target) return;
			e.preventDefault();
			setDrawer(false);
			scrollToEl(target);
		});
	});

	// ---------- Telón ----------
	const bulbs = gsap.utils.toArray<HTMLElement>('.bulb');
	const lightBulbs = () => bulbs.forEach((b, i) => setTimeout(() => b.classList.add('is-on'), i * 60));

	const curtainCanvas = document.querySelector<HTMLCanvasElement>('[data-curtain]');
	const curtain = curtainCanvas ? createCurtain(curtainCanvas, { animate: !reduce }) : null;
	if (curtain) stageEl.classList.add('has-curtain');
	// Apertura = parte "al cargar" (entreabre) + parte "scroll" (se recoge)
	const curtainState = { peek: 0, scroll: 0 };
	const syncCurtain = () => curtain?.setOpen(curtainState.peek + curtainState.scroll * (1 - curtainState.peek));

	if (reduce || !curtain) {
		bulbs.forEach((b) => b.classList.add('is-on'));
		curtain?.setOpen(1);
	} else {
		// Al cargar: el telón "respira" y se entreabre un poco
		gsap.timeline({ delay: 0.3 })
			.from('.curtain-badge', { opacity: 0, y: 20, duration: 1, ease: 'power3.out' })
			.to(curtainState, { peek: 0.05, duration: 1.4, ease: 'power2.inOut', onUpdate: syncCurtain }, 0.4);

		// Al hacer scroll: el telón se recoge hacia los lados y aparece el rótulo
		let lit = false;
		const open = gsap.timeline({
			defaults: { ease: 'none' },
			scrollTrigger: {
				trigger: '.stage',
				start: 'top top',
				end: '+=110%',
				pin: '.stage__pin',
				scrub: 0.6,
				anticipatePin: 1,
				invalidateOnRefresh: true,
				onUpdate: (s) => {
					if (!lit && s.progress > 0.35) {
						lit = true;
						lightBulbs();
					}
				},
			},
		});
		open
			.to('.curtain-badge', { opacity: 0, y: -30, duration: 0.15 }, 0)
			.to(curtainState, { scroll: 1, duration: 1, ease: 'power1.inOut', onUpdate: syncCurtain }, 0)
			.fromTo('.stage__bg img', { scale: 1.18 }, { scale: 1, duration: 1 }, 0)
			.from('.stage__content > *', { y: 50, opacity: 0, stagger: 0.07, duration: 0.45 }, 0.35);
	}
	stageEl.classList.add('is-live');

	// ---------- Cartelera: lo de hoy ----------
	{
		const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Madrid' }));
		// Antes de las 6:00 seguimos en "la noche de ayer"
		const ref = new Date(now);
		if (now.getHours() < 6) ref.setDate(ref.getDate() - 1);
		const dow = ref.getDay();
		const show = week.find((s) => s.day === dow)!;
		const set = (sel: string, txt: string) => {
			const el = document.querySelector(sel);
			if (el) el.textContent = txt;
		};
		set('[data-today-when]', `Hoy, ${show.dayName.toLowerCase()}`);
		set('[data-today-what]', show.title);
		set('[data-today-detail]', show.detail);
		set('[data-today-venue]', show.venue);

		const list = document.querySelector<HTMLElement>('[data-tickets]');
		const mon = new Intl.DateTimeFormat('es-ES', { month: 'short' });
		if (list) {
			const items = [...list.querySelectorAll<HTMLElement>('.sp-ticket')];
			items
				.map((li) => {
					const d = Number(li.dataset.day);
					const offset = (d - dow + 7) % 7;
					const date = new Date(ref);
					date.setDate(ref.getDate() + offset);
					li.querySelector('[data-num]')!.textContent = String(date.getDate());
					li.querySelector('[data-mon]')!.textContent = mon.format(date).replace('.', '');
					const isToday = offset === 0;
					li.classList.toggle('is-today', isToday);
					(li.querySelector('[data-hoy]') as HTMLElement).hidden = !isToday;
					return { li, offset };
				})
				.sort((a, b) => a.offset - b.offset)
				.forEach(({ li }) => list.appendChild(li));
		}
	}

	// ---------- Formulario (demo) ----------
	{
		const form = document.querySelector<HTMLFormElement>('[data-form]')!;
		const msg = document.querySelector<HTMLElement>('[data-form-msg]')!;
		const date = form.querySelector<HTMLInputElement>('[data-field-date]')!;
		const venue = form.querySelector<HTMLSelectElement>('[data-field-venue]')!;
		const plan = form.querySelector<HTMLSelectElement>('[data-field-plan]')!;
		const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
		const t = new Date();
		date.min = iso(t);
		date.value = iso(t);

		const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
		document.querySelectorAll<HTMLElement>('[data-book]').forEach((b) =>
			b.addEventListener('click', () => {
				const name = b.dataset.book!;
				plan.value = name;
				const d = new Date();
				d.setDate(d.getDate() + ((days.indexOf(name) - d.getDay() + 7) % 7));
				date.value = iso(d);
			}),
		);
		document.querySelectorAll<HTMLElement>('[data-book-venue]').forEach((b) => b.addEventListener('click', () => (venue.value = b.dataset.bookVenue!)));
		document.querySelectorAll<HTMLElement>('[data-book-type]').forEach((b) => b.addEventListener('click', () => (plan.value = b.dataset.bookType!)));

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!form.checkValidity()) {
				form.classList.add('was-validated');
				msg.dataset.state = 'error';
				msg.textContent = 'Revisa los campos marcados: nos falta algún dato.';
				form.querySelector<HTMLElement>(':invalid')?.focus();
				return;
			}
			const data = new FormData(form);
			const v = venue.options[venue.selectedIndex].text;
			const d = new Date(`${data.get('fecha')}T12:00`).toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
			msg.dataset.state = 'ok';
			msg.textContent = `¡Hecho, ${data.get('nombre')}! Mesa para ${data.get('personas')} en ${v}, ${d} a las ${data.get('hora')}h. Te escribimos por WhatsApp para confirmar.`;
			form.classList.remove('was-validated');
		});
	}

	// ---------- Temporada: carrusel ----------
	{
		const track = document.querySelector<HTMLElement>('[data-posters]')!;
		const step = () => (track.querySelector<HTMLElement>('.poster')?.offsetWidth ?? 300) + 24;
		document.querySelector('[data-season-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
		document.querySelector('[data-season-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));
	}

	// ---------- Revelados y parallax ----------
	if (!reduce) {
		gsap.utils.toArray<HTMLElement>('.sec-head, .experiencia__copy > *, .barra__copy .programa__item, .reservas__side > *').forEach((el) => {
			gsap.from(el, { y: 36, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%' } });
		});
		gsap.from('.sp-ticket', { x: 40, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.07, scrollTrigger: { trigger: '.tickets', start: 'top 82%' } });
		gsap.from('.sp-cartel', { rotate: -4, y: 60, opacity: 0, duration: 1.2, ease: 'back.out(1.4)', scrollTrigger: { trigger: '.cartelera__grid', start: 'top 80%' } });
		gsap.from('.sp-venue', { y: 80, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: 0.12, scrollTrigger: { trigger: '.salas__grid', start: 'top 85%' } });
		gsap.from('.vale', { y: 40, opacity: 0, rotate: -2, duration: 0.9, ease: 'back.out(1.6)', stagger: 0.1, scrollTrigger: { trigger: '.vales', start: 'top 90%' } });
		gsap.from('.cuadro__frame', { y: 120, rotate: 0, opacity: 0, duration: 1.3, ease: 'expo.out', stagger: 0.15, scrollTrigger: { trigger: '.cuadro__frames', start: 'top 85%' } });
		gsap.from('.poster', { y: 60, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.08, scrollTrigger: { trigger: '.posters', start: 'top 88%' } });

		gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach((el) => {
			const amt = Number(el.dataset.parallax || 0);
			gsap.fromTo(el, { yPercent: amt }, { yPercent: -amt, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
		});
		gsap.to('.seal__ring', { rotate: 360, ease: 'none', scrollTrigger: { trigger: '.experiencia', start: 'top bottom', end: 'bottom top', scrub: true } });
	}

	// ---------- Contadores ----------
	document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
		const end = Number(el.dataset.count || 0);
		const fmt = (v: number) => Math.round(v).toLocaleString('es-ES');
		if (reduce) return;
		const obj = { v: 0 };
		el.textContent = fmt(0);
		ScrollTrigger.create({
			trigger: el,
			start: 'top 92%',
			once: true,
			onEnter: () => gsap.to(obj, { v: end, duration: 1.8, ease: 'power2.out', onUpdate: () => (el.textContent = fmt(obj.v)) }),
		});
	});
</script>
